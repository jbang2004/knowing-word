<view class="tab-shell theme-{{theme}}">
  <view wx:for="{{list}}" wx:key="pagePath" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab" hover-class="is-pressed">
    <view class="tab-icon icon-{{item.icon}}"><view></view></view>
    <text>{{item.text}}</text>
  </view>
</view>
