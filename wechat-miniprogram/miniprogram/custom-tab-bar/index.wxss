.tab-shell { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: repeat(4,1fr); height: calc(72px + env(safe-area-inset-bottom)); padding: 0 0 env(safe-area-inset-bottom); border-top: 2px solid #e5dfd2; background: #fff; }
.tab-shell.theme-night { border-top-color:#34443e; background:#192521; }
.tab-item { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: #5e6e68; font-size: 13px; font-weight: 800; transition:color 140ms ease,background-color 140ms ease; }
.tab-item.is-pressed { opacity:1; transform:none; }
.theme-night .tab-item { color:#a6b3ad; }
.tab-item.active { color: #0b7654; font-weight:900; }
.theme-night .tab-item.active { color:#70d9b6; }

@media (min-width:900px) {
  .tab-shell {
    top:0;
    right:auto;
    bottom:0;
    width:236px;
    height:auto;
    grid-template-columns:1fr;
    grid-template-rows:repeat(4,52px);
    align-content:start;
    gap:5px;
    padding:92px 18px 26px;
    border-top:0;
    border-right:2px solid #e5dfd2;
  }
  .tab-shell.theme-night { border-right-color:#34443e; }
  .tab-item {
    min-height:52px;
    flex-direction:row;
    justify-content:flex-start;
    gap:13px;
    padding:0 15px;
    border-radius:16px;
    font-size:17px;
  }
  .tab-item.active {
    color:#0f1614;
    background:#17b686;
    box-shadow:0 4px 0 #0f8c64;
  }
  .tab-item.active.is-pressed { transform:translateY(4px); box-shadow:none; }
  .theme-night .tab-item.active {
    color:#0f1614;
    background:#35c295;
    box-shadow:0 4px 0 #1d8f6b;
  }
}
@media (prefers-reduced-motion:reduce) { .tab-item { transition:none; }.tab-item.is-pressed,.tab-item.active.is-pressed { transform:none; } }
