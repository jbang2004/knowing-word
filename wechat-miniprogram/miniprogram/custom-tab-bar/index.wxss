.tab-shell { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: repeat(4,1fr); height: calc(72px + env(safe-area-inset-bottom)); padding: 0 0 env(safe-area-inset-bottom); border-top: 2px solid #e5dfd2; background: #fff; }
.tab-shell.theme-night { border-top-color:#34443e; background:#192521; }
.tab-item { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: #70695d; font-size: 13px; font-weight: 800; transition:color 140ms ease,opacity 90ms ease,transform 90ms ease; }
.tab-item.is-pressed { opacity:.72; transform:scale(.96); }
.theme-night .tab-item { color:#a6b3ad; }
.tab-item.active { color: #0b7654; font-weight:900; }
.theme-night .tab-item.active { color:#70d9b6; }
.tab-icon { position: relative; width: 26px; height: 26px; color: currentColor; }
.icon-home::before { position: absolute; left: 5px; top: 3px; width: 15px; height: 15px; border-top: 2.2px solid currentColor; border-left: 2.2px solid currentColor; transform: rotate(45deg); content: ""; }
.icon-home::after { position: absolute; left: 6px; bottom: 2px; width: 14px; height: 14px; border: 2.2px solid currentColor; border-top: 0; border-radius: 1px; content: ""; }
.icon-book::before,.icon-book::after { position: absolute; top: 4px; width: 10px; height: 18px; border: 2.2px solid currentColor; content: ""; }
.icon-book::before { left: 2px; border-radius: 4px 1px 1px 4px; }
.icon-book::after { right: 2px; border-radius: 1px 4px 4px 1px; }
.icon-grid::before { position: absolute; left: 3px; top: 3px; width: 7px; height: 7px; border: 2.2px solid currentColor; border-radius: 2.5px; box-shadow: 13px 0 0 -2.2px #fff,13px 0 0 0 currentColor,0 13px 0 -2.2px #fff,0 13px 0 0 currentColor,13px 13px 0 -2.2px #fff,13px 13px 0 0 currentColor; content: ""; }
.theme-night .icon-grid::before { box-shadow:13px 0 0 -2.2px #192521,13px 0 0 0 currentColor,0 13px 0 -2.2px #192521,0 13px 0 0 currentColor,13px 13px 0 -2.2px #192521,13px 13px 0 0 currentColor; }
.icon-person::before { position: absolute; left: 8px; top: 2px; width: 9px; height: 9px; border: 2.2px solid currentColor; border-radius: 50%; content: ""; }
.icon-person::after { position: absolute; left: 4px; bottom: 1px; width: 17px; height: 12px; border: 2.2px solid currentColor; border-bottom: 0; border-radius: 12px 12px 0 0; content: ""; }

@media (min-width:900px) {
  .tab-shell {
    top:0;
    right:auto;
    bottom:0;
    width:236px;
    height:auto;
    grid-template-columns:1fr;
    grid-template-rows:repeat(4,52px);
    align-content:start;
    gap:5px;
    padding:92px 18px 26px;
    border-top:0;
    border-right:2px solid #e5dfd2;
  }
  .tab-shell.theme-night { border-right-color:#34443e; }
  .tab-item {
    min-height:52px;
    flex-direction:row;
    justify-content:flex-start;
    gap:13px;
    padding:0 15px;
    border-radius:16px;
    font-size:17px;
  }
  .tab-item.active {
    color:#0f1614;
    background:#17b686;
    box-shadow:0 4px 0 #0f8c64;
  }
  .theme-night .tab-item.active {
    color:#0f1614;
    background:#35c295;
    box-shadow:0 4px 0 #1d8f6b;
  }
}
@media (prefers-reduced-motion:reduce) { .tab-item { transition:none; }.tab-item.is-pressed { transform:none; } }
