/*
 * A local, production-subset build of Tencent TDesign Icons 0.4.3.
 * The project keeps only the glyphs it uses, so every icon shares one vector
 * grammar without loading the full component library or a remote font.
 */
@font-face {
  font-family: "Knowing Icons";
  src: url("data:font/woff2;base64,") format("woff2");
  font-weight: 400;
  font-style: normal;
  font-display: block;
}

:host {
  display: inline-flex;
  flex: none;
  color: inherit;
  line-height: 1;
  vertical-align: middle;
}

.knowing-icon-host,
.knowing-icon-glyph,
.knowing-icon-image {
  display: block;
  width: 100%;
  height: 100%;
}

.knowing-icon-host { color: inherit; }
.knowing-icon-image { vertical-align: top; }
.knowing-icon-glyph {
  color: inherit;
  font-family: "Knowing Icons" !important;
  font-style: normal;
  font-weight: 400;
  font-variant: normal;
  text-align: center;
  text-transform: none;
  -webkit-font-smoothing: antialiased;
}

