.bottom-navigation { position:fixed; z-index:40; right:0; bottom:0; left:0; display:grid; height:calc(72px + env(safe-area-inset-bottom)); grid-template-columns:repeat(4,1fr); padding-bottom:env(safe-area-inset-bottom); border-top:2px solid #e5dfd2; background:#fff; }
.bottom-navigation.theme-night { border-top-color:#34443e; background:#192521; }
.nav-item { display:flex; min-width:0; flex-direction:column; align-items:center; justify-content:center; gap:4px; color:#5e6e68; font-size:13px; font-weight:800; transition:color 140ms ease,background-color 140ms ease; }
.nav-item.is-pressed { opacity:1; transform:none; }
.theme-night .nav-item { color:#a6b3ad; }
.nav-item.active { color:#0b7654; font-weight:900; }
.theme-night .nav-item.active { color:#70d9b6; }

@media (min-width:900px) {
  .bottom-navigation {
    top:0;
    right:auto;
    bottom:0;
    width:236px;
    height:auto;
    grid-template-columns:1fr;
    grid-template-rows:repeat(4,52px);
    align-content:start;
    gap:5px;
    padding:92px 18px 26px;
    border-top:0;
    border-right:2px solid #e5dfd2;
  }
  .bottom-navigation.theme-night { border-right-color:#34443e; }
  .nav-item {
    min-height:52px;
    flex-direction:row;
    justify-content:flex-start;
    gap:13px;
    padding:0 15px;
    border-radius:16px;
    font-size:17px;
  }
  .nav-item.active {
    color:#0f1614;
    background:#17b686;
    box-shadow:0 4px 0 #0f8c64;
  }
  .nav-item.active.is-pressed { transform:translateY(4px); box-shadow:none; }
  .theme-night .nav-item.active {
    color:#0f1614;
    background:#35c295;
    box-shadow:0 4px 0 #1d8f6b;
  }
}
@media (prefers-reduced-motion:reduce) { .nav-item { transition:none; }.nav-item.is-pressed,.nav-item.active.is-pressed { transform:none; } }
