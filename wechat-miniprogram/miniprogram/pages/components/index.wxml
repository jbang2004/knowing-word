<view class="components-page theme-{{theme}}" style="padding-top: {{navHeight + 18}}px;">
  <view class="utility-heading"><button class="nav-back" bindtap="goBack" aria-label="返回"><ki-icon name="arrow-left" size="22" /></button><view class="utility-heading-content"><strong>从常见部件入手，识字更轻松</strong><text>先按课内出现次数排序，再把一个部件放回真实的词语中理解。</text></view></view>

  <view wx:if="{{recent}}" class="component-resume"><text>上次学到</text><strong class="kai">{{recent.glyph}}</strong><view>{{recent.title}}</view><button class="press-card" data-id="{{recent.id}}" bindtap="selectComponent" hover-class="is-pressed"><text>继续</text><ki-icon name="arrow-right" size="16" /></button></view>

  <view class="component-layout">
  <view class="component-browser">
    <view class="component-browser-toolbar">
      <view class="component-sort-tabs"><button class="press-card {{sortMode === 'frequency' ? 'active' : ''}}" data-mode="frequency" bindtap="chooseSortMode" hover-class="is-pressed">常用部件</button><button class="press-card {{sortMode === 'recent' ? 'active' : ''}}" data-mode="recent" bindtap="chooseSortMode" hover-class="is-pressed">最近学习</button></view>
      <view class="component-search"><ki-icon name="search" size="18" /><input value="{{query}}" bindinput="onSearch" placeholder="搜部件或例字" /></view>
    </view>
    <view class="component-browser-summary"><strong>{{summaryTitle}}</strong><text>{{summaryCount}}</text></view>

    <view wx:if="{{visiblePage.length}}" class="component-card-grid">
      <view wx:for="{{visiblePage}}" wx:key="id" class="component-card press-card {{item.selected ? 'selected' : ''}} {{item.learned ? 'learned' : ''}}" data-id="{{item.id}}" bindtap="selectComponent" role="button" hover-class="is-pressed">
        <strong class="kai">{{item.glyph}}</strong>
        <text wx:if="{{item.title !== item.glyph}}">{{item.title}}</text>
        <small>课内 {{item.count}} 次</small>
        <view wx:if="{{item.learned}}" class="component-learned-icon"><ki-icon name="check" size="13" /></view>
      </view>
    </view>
    <view wx:else class="component-empty"><strong>{{sortMode === 'recent' ? '还没有最近学习的部件' : '没有找到匹配的部件'}}</strong><text>{{sortMode === 'recent' ? '打开一个常用部件后，它会出现在这里。' : '可以换一个部件名称或例字再试。'}}</text><button wx:if="{{sortMode === 'recent'}}" class="press-card" data-mode="frequency" bindtap="chooseSortMode" hover-class="is-pressed">查看常用部件</button></view>
    <view wx:if="{{hasMore}}" class="component-load-more press-card" bindtap="loadMore" role="button" hover-class="is-pressed">再显示 {{nextCount}} 个</view>
  </view>

  <view wx:if="{{detailsOpen}}" class="sheet-backdrop" bindtap="closeDetails" catchtouchmove></view>
  <view class="component-sheet {{detailsOpen ? 'open' : ''}}">
    <view class="sheet-close press-card" bindtap="closeDetails" role="button" hover-class="is-pressed">关闭</view>
    <view class="story-glyph"><text>{{selected.glyph}}</text></view>
    <text class="story-kicker">部件精讲</text>
    <strong class="story-title">{{selected.title}}</strong>
    <view class="story-copy">{{selected.description}}</view>
    <view class="story-section"><text>常见例字</text><view class="example-list"><view wx:for="{{selected.examples}}" wx:key="*this" data-glyph="{{item}}" bindtap="openExample">{{item}}</view></view></view>
    <view class="story-section"><text>本册里遇见它</text><view class="linked-list"><button wx:for="{{connected}}" wx:key="id" data-glyph="{{item.hanzi}}" bindtap="openExample"><strong class="kai">{{item.hanzi}}</strong><text>第 {{item.lessonPosition}} 课</text></button><view wx:if="{{!connected.length}}">这个部件会在后续词语里出现。</view></view></view>
  </view>
  </view>
  <bottom-navigation active="practice" theme="{{theme}}" />
</view>
