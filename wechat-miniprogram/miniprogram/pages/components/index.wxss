.search { display: flex; align-items: center; gap: 14rpx; margin-top: 28rpx; padding: 0 24rpx; }.search text { color: #a6472b; font-size: 38rpx; }.search input { flex: 1; height: 86rpx; }
.component-strip { width: 100%; margin-top: 20rpx; white-space: nowrap; }.strip-inner { display: flex; gap: 12rpx; padding: 4rpx 4rpx 14rpx; }.component-chip { flex: none; min-width: 118rpx; margin: 0; padding: 16rpx; border: 1rpx solid rgba(77,67,47,.14); border-radius: 20rpx; color: #27251f; background: #fffdf7; }.component-chip.active { border-color: #a6472b; color: #8a3825; background: #f6e7da; }.component-chip text { display: block; font-family: "KaiTi SC",serif; font-size: 46rpx; }.component-chip view { margin-top: 4rpx; font-size: 20rpx; }
.component-detail { margin-top: 14rpx; padding: 30rpx; }.detail-head { display: flex; align-items: center; gap: 24rpx; }.big-glyph { display: flex; align-items: center; justify-content: center; width: 150rpx; height: 150rpx; border-radius: 28rpx; color: #a6472b; background: #f4e2d5; font-family: "KaiTi SC",serif; font-size: 96rpx; }.detail-title { margin-top: 12rpx; font-family: "Songti SC",serif; font-size: 38rpx; font-weight: 700; }.example-title { margin-top: 28rpx; font-weight: 700; }.examples { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }.examples button { width: 72rpx; height: 72rpx; margin: 0; padding: 0; border-radius: 16rpx; color: #27251f; background: #f3ecdc; font-family: "KaiTi SC",serif; font-size: 38rpx; }.learned-button { margin-top: 28rpx; }
