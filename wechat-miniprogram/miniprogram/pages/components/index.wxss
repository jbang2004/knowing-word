.components-page { width:calc(100% - 32px); min-height:100vh; margin:0 16px; padding-bottom:calc(96px + env(safe-area-inset-bottom)); }
.utility-heading { display:flex; height:61px; align-items:flex-start; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--line); }.utility-heading button { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -10px; padding:0 12px; color:var(--ink-soft); background:transparent; font-size:34px; line-height:1; }.utility-heading strong { min-width:0; padding-top:7px; color:var(--navy); font-size:24px; line-height:30px; white-space:nowrap; }
.component-resume { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:13px; margin-bottom:15px; padding:13px 16px; border:2px solid var(--line); border-radius:18px; background:var(--part-soft); box-shadow:0 4px 0 var(--line); }.component-resume>text { grid-column:1/-1; color:var(--ink-soft); font-size:13px; }.component-resume>strong { font-size:32px; }.component-resume>view { color:var(--ink-soft); font-size:13px; }.component-resume button { min-height:44px; margin:0; padding:8px 14px; border:2px solid var(--line); border-radius:16px; color:var(--navy); background:var(--paper); box-shadow:0 4px 0 var(--line); font-size:12px; font-weight:800; }
.component-browser { padding:15px; border:2px solid var(--line); border-radius:23px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.component-browser-toolbar { display:grid; grid-template-columns:auto minmax(0,1fr); justify-content:space-between; gap:10px; margin-bottom:17px; }.component-sort-tabs { display:grid; width:auto; height:44px; grid-template-columns:repeat(2,minmax(0,1fr)); gap:5px; }.component-sort-tabs button { min-height:44px; margin:0; padding:9px 14px; border:2px solid var(--line); border-radius:999px; color:var(--ink-soft); background:var(--paper); box-shadow:var(--shadow); font-size:13px; font-weight:800; white-space:nowrap; }.component-sort-tabs button.active { border-color:var(--action-deep); color:var(--action-ink); background:var(--action); box-shadow:0 3px 0 var(--action-deep); }
.component-search { display:flex; width:auto; min-height:48px; align-items:center; gap:6px; padding:0 10px; border:2px solid var(--line); border-radius:999px; color:var(--ink-soft); background:var(--paper); }.component-search input { width:100%; min-width:0; height:44px; font-size:13px; }
.search-icon { position:relative; width:18px; height:18px; flex:none; color:var(--ink-faint); }.search-icon::before { position:absolute; top:1px; left:1px; width:10px; height:10px; border:2px solid currentColor; border-radius:50%; content:""; }.search-icon::after { position:absolute; right:0; bottom:1px; width:7px; border-top:2px solid currentColor; content:""; transform:rotate(45deg); transform-origin:right center; }
.component-browser-summary { display:flex; align-items:flex-start; flex-direction:column; gap:3px; margin:-2px 0 14px; }.component-browser-summary strong { color:var(--navy); font-size:12px; }.component-browser-summary text { color:var(--ink-soft); font-size:11px; }
.component-card-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); column-gap:10px; row-gap:var(--card-stack-gap); }.component-card { position:relative; display:grid; width:100%; min-width:0; min-height:100px; padding:9px; border:2px solid var(--line); border-radius:18px; color:var(--ink); text-align:left; background:var(--paper); box-shadow:0 4px 0 var(--line); }.component-card.selected { border-color:var(--part); background:var(--part-soft); box-shadow:0 4px 0 var(--part-edge); }.component-card.learned { border-color:var(--action-edge); background:var(--action-soft); box-shadow:0 4px 0 var(--action-edge); }.component-card.learned::after { position:absolute; top:7px; right:8px; color:var(--action-text); font-weight:900; content:"✓"; }.component-card-grid strong { color:var(--navy); font-size:29px; font-weight:500; line-height:1; }.component-card-grid text { overflow:hidden; color:var(--ink); font-size:12px; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }.component-card-grid small { color:var(--ink-faint); font-size:11px; }
.component-load-more,.component-empty button { display:flex; width:max-content; min-height:46px; align-items:center; justify-content:center; margin:18px auto 0; padding:10px 22px; border:2px solid var(--line); border-radius:18px; color:var(--part-text); background:var(--part-soft); box-shadow:0 4px 0 var(--line); font-size:12px; font-weight:800; }.component-empty { display:flex; min-height:220px; flex-direction:column; align-items:center; justify-content:center; padding:30px; text-align:center; }.component-empty strong { color:var(--navy); font-size:18px; }.component-empty>text { margin-top:8px; color:var(--ink-soft); font-size:12px; }
.sheet-backdrop { position:fixed; z-index:70; inset:0; background:rgba(10,21,18,.48); animation:sheet-fade 220ms ease both; }.component-sheet { position:fixed; z-index:71; right:8px; bottom:8px; left:8px; display:block; max-height:88vh; padding:18px 18px calc(20px + env(safe-area-inset-bottom)); overflow-y:auto; border:2px solid var(--line); border-radius:25px; background:white; box-shadow:0 28px 80px rgba(8,20,16,.32); transform:translateY(110%); transition:transform 260ms var(--ease-out); }.component-sheet.open { transform:translateY(0); }.sheet-close { position:sticky; z-index:1; top:0; display:flex; width:max-content; min-height:44px; align-items:center; margin:-8px -4px 8px auto; padding:8px 14px; border:2px solid var(--line); border-radius:999px; color:var(--ink-soft); background:white; box-shadow:0 4px 0 var(--line); font-size:12px; font-weight:800; }.story-glyph { display:flex; width:68px; height:68px; align-items:center; justify-content:center; margin-bottom:14px; border-radius:22px 22px 22px 7px; color:#30150e; background:var(--radical); box-shadow:0 4px 0 var(--radical-deep); }.story-glyph text { font-family:"Knowing Kai","Kaiti SC",STKaiti,serif; font-size:48px; line-height:1; }.story-kicker { display:block; color:var(--radical-text); font-size:10px; font-weight:900; letter-spacing:2px; }.story-title { display:block; margin-top:3px; color:var(--navy); font-family:"Songti SC",STSong,serif; font-size:26px; }.story-copy { margin:9px 0 19px; color:var(--ink-soft); font-size:13px; line-height:1.7; }.story-section { margin-top:15px; padding-top:14px; border-top:1px dashed var(--line); }.story-section>text { display:block; margin-bottom:8px; color:var(--ink-soft); font-size:13px; font-weight:790; }.example-list { display:flex; flex-wrap:wrap; gap:7px; }.example-list>view { display:flex; min-width:30px; height:30px; align-items:center; justify-content:center; padding:0 5px; border-radius:8px; color:var(--part-text); background:var(--part-soft); font-family:"Knowing Kai","Kaiti SC",STKaiti,serif; font-size:18px; }.linked-list { display:flex; flex-direction:column; gap:6px; }.linked-list button { display:flex; width:100%; min-height:44px; align-items:center; gap:8px; margin:0; padding:7px 9px; border-radius:10px; text-align:left; background:var(--paper-soft); }.linked-list strong { font-size:20px; }.linked-list button text,.linked-list>view { color:var(--ink-soft); font-size:12px; }
@keyframes sheet-fade { from { opacity:0; } to { opacity:1; } }
.sheet-backdrop { animation:none; }
.component-sheet { visibility:hidden; background:var(--paper); pointer-events:none; transition:none; }
.component-sheet.open { visibility:visible; pointer-events:auto; transform:none; }
.sheet-close { background:var(--paper); }
@media (max-width:430px) {
  .component-browser-toolbar { grid-template-columns:minmax(0,1fr); justify-content:stretch; }
  .component-sort-tabs { width:max-content; max-width:100%; }
  .component-search { width:100%; max-width:none; }
}
@media (min-width:761px) and (max-width:980px) { .component-card-grid { grid-template-columns:repeat(5,minmax(0,1fr)); } }
@media (min-width:981px) { .component-card-grid { grid-template-columns:repeat(6,minmax(0,1fr)); } }

/* Match the quieter Web surface hierarchy without changing card geometry. */
.component-browser { border-width:1px; box-shadow:var(--shadow-xs); }
.component-load-more,.component-empty button { background:var(--paper); }
.story-glyph { color:var(--radical-ink); }
