.search { display: flex; align-items: center; gap: 14rpx; margin-top: 28rpx; padding: 0 24rpx; }.search text { color: var(--part-text); font-size: 38rpx; }.search input { flex: 1; height: 86rpx; }
.component-strip { width: 100%; margin-top: 20rpx; white-space: nowrap; }.strip-inner { display: flex; gap: 12rpx; padding: 4rpx 4rpx 14rpx; }.component-chip { flex: none; min-width: 118rpx; margin: 0; padding: 16rpx; border: 2rpx solid var(--line); border-radius: 24rpx; color: var(--ink); background: var(--paper); box-shadow: 0 5rpx 0 var(--line-deep); }.component-chip.active { border-color: var(--part); color: var(--part-text); background: var(--part-soft); box-shadow: 0 5rpx 0 var(--part-edge); }.component-chip text { display: block; font-family: "Kaiti SC",serif; font-size: 46rpx; }.component-chip view { margin-top: 4rpx; font-size: 20rpx; }
.component-detail { margin-top: 18rpx; padding: 30rpx; }.detail-head { display: flex; align-items: center; gap: 24rpx; }.big-glyph { display: flex; align-items: center; justify-content: center; width: 150rpx; height: 150rpx; border-radius: 42rpx 42rpx 42rpx 14rpx; color: #0f1614; background: var(--part); box-shadow: 0 8rpx 0 var(--part-deep); font-family: "Kaiti SC",serif; font-size: 96rpx; }.detail-title { margin-top: 12rpx; color: var(--navy); font-size: 38rpx; font-weight: 900; }.example-title { margin-top: 28rpx; color: var(--navy); font-weight: 900; }.examples { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }.examples button { width: 72rpx; height: 72rpx; margin: 0; padding: 0; border: 2rpx solid var(--line); border-radius: 20rpx; color: var(--navy); background: var(--paper-soft); box-shadow: 0 4rpx 0 var(--line-deep); font-family: "Kaiti SC",serif; font-size: 38rpx; }.learned-button { margin-top: 28rpx; }
