.home-page { min-height: 100vh; padding: 0 16px calc(104px + env(safe-area-inset-bottom)); background: var(--sky); }
.status-row { display: flex; align-items: center; gap: 9px; width: 100%; min-height: 52px; }
.status-spacer { flex: 1; }
.avatar { display: flex; width: 40px; height: 40px; flex: none; align-items: center; justify-content: center; border-radius: 14px 14px 14px 4px; color: #30150e; background: var(--radical); box-shadow: 0 3px 0 var(--radical-deep); font-family: "Kaiti SC",STKaiti,serif; font-size: 18px; }
.metric { display: flex; min-height: 36px; flex: none; align-items: center; gap: 6px; padding: 6px 13px; border-radius: 999px; font-size: 15px; }
.metric strong { font-weight: 900; }
.metric-icon { font-size: 13px; }
.metric.streak { color: var(--wrong-text); background: var(--wrong-soft); box-shadow: 0 3px 0 var(--wrong-edge); }
.metric.today { color: var(--action-text); background: var(--action-soft); box-shadow: 0 3px 0 var(--action-edge); }
.lesson-banner { display: flex; align-items: center; gap: 14px; margin-top: 14px; padding: 16px; border-radius: 24px; color: #0f1614; background: var(--action); box-shadow: 0 5px 0 var(--action-deep); }
.lesson-main { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8px; }
.lesson-main>text { font-size: 14px; font-weight: 700; opacity: .76; }
.lesson-main>strong { font-size: 24px; font-weight: 900; line-height: 1.1; }
.lesson-progress { display: flex; align-items: center; gap: 10px; }
.lesson-progress .progress-track { width: min(112px,52%); height: 14px; }
.lesson-progress>text { font-size: 14px; font-weight: 900; }
.lesson-button { display: flex; width: 56px; height: 56px; flex: none; flex-direction: column; align-items: center; justify-content: center; gap: 3px; border-radius: 18px; color: var(--action-text); background: white; box-shadow: 0 4px 0 rgba(0,0,0,.16); font-weight: 900; }
.lesson-button text { font-size: 13px; }
.book-mark { font-size: 17px; }
.focus-card { display: grid; grid-template-columns: auto minmax(0,1fr); align-items: center; gap: 14px; margin-top: 18px; margin-bottom: 22px; padding: 16px; border: 2px solid var(--wrong-edge); border-radius: 22px; background: #fffaf0; box-shadow: 0 3px 0 var(--line); }
.focus-glyph { display: flex; width: 58px; height: 58px; align-items: center; justify-content: center; border-radius: 19px 19px 19px 7px; color: var(--wrong-text); background: white; font-family: "Kaiti SC",STKaiti,serif; font-size: 32px; }
.focus-copy { display: flex; min-width: 0; flex-direction: column; gap: 2px; }
.focus-copy text { color: var(--wrong-text); font-size: 13px; font-weight: 900; }
.focus-copy strong { color: var(--navy); font-size: 16px; font-weight: 900; }
.focus-copy view { color: var(--ink-soft); font-size: 13px; line-height: 1.55; }
.focus-card button { grid-column: 1/-1; width: 100%; min-height: 44px; margin: 0; padding: 11px 14px; border-radius: 14px; color: white; background: var(--wrong-text); font-size: 16px; font-weight: 900; line-height: normal; }
.path-map { display: flex; flex-direction: column; gap: 20px; margin-top: 18px; }
.focus-card+.path-map { margin-top: 0; }
.chapter-rule { display: flex; height: 20px; align-items: center; gap: 12px; color: var(--ink-faint); font-size: 14px; font-weight: 900; }
.chapter-rule view { height: 2px; flex: 1; border-radius: 2px; background: var(--line); }
.path-steps { display: flex; flex-direction: column; gap: 20px; }
.path-node { position: relative; display: flex; min-height: 74px; align-items: flex-end; justify-content: center; }
.path-line { position: absolute; z-index: 0; bottom: 50%; left: calc(50% + var(--node-offset)); width: 7px; height: var(--link-length); border-radius: 999px; background: var(--line); transform: translateX(-50%) rotate(var(--link-tilt)); transform-origin: bottom center; }
.path-node.done .path-line,.path-node.current .path-line { background: var(--action-edge); }
.path-node.offset-0 { --node-offset:0px; --link-length:0px; --link-tilt:0deg; }
.path-node.offset-1 { --node-offset:52px; --link-length:107px; --link-tilt:-28.95deg; }
.path-node.offset-2 { --node-offset:72px; --link-length:96px; --link-tilt:-12.01deg; }
.path-node.offset-3 { --node-offset:52px; --link-length:96px; --link-tilt:12.01deg; }
.path-seal { position: relative; z-index: 1; display: flex; width: 74px; height: 74px; min-height: 0; margin: 0; padding: 0; align-items: center; justify-content: center; border: 0; border-radius: 24px 24px 24px 8px; font-family: "Kaiti SC",STKaiti,serif; font-size: 36px; font-weight: 500; line-height: normal; transform: translateX(var(--node-offset)); }
.path-node.done .path-seal { color: #0f1614; background: var(--action); box-shadow: 0 5px 0 var(--action-deep); }
.path-node.current .path-seal { border: 3px solid var(--action); color: var(--action-text); background: white; box-shadow: 0 5px 0 var(--action-edge); }
.path-node.locked .path-seal { color: var(--ink-faint); background: var(--sky-deep); box-shadow: 0 5px 0 var(--line-deep); }
.node-badge { position: absolute; top: -7px; right: -6px; display: flex; width: 24px; height: 24px; align-items: center; justify-content: center; border-radius: 50%; font-family: sans-serif; font-size: 11px; font-weight: 900; }
.node-badge.done { color: #0f1614; background: var(--action-deep); }
.node-badge.lock { color: var(--ink-faint); background: var(--sky-deep); box-shadow: 0 0 0 2px var(--sky); }
.chapter-fold { display: flex; align-items: center; gap: 11px; padding: 11px 14px; border: 2px solid var(--line); border-radius: 20px; background: var(--sky-deep); box-shadow: 0 4px 0 var(--line-deep); }
.mini-seals { display: flex; gap: 4px; flex: none; }
.mini-seals text { display: flex; width: 25px; height: 25px; align-items: center; justify-content: center; border-radius: 8px 8px 8px 3px; color: var(--ink-faint); background: var(--line); font-family: "Kaiti SC",serif; font-size: 13px; }
.chapter-fold.done .mini-seals text { color: #0f1614; background: var(--action); }
.chapter-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 1px; }
.chapter-copy strong { color: var(--ink-soft); font-size: 14px; }
.chapter-copy text { color: var(--ink-faint); font-size: 14px; font-weight: 600; line-height: 1.4; }
.fold-state { color: var(--ink-faint); }
.practice-plan { display: grid; gap: 16px; margin-top: 12px; padding: 20px; border: 2px solid var(--line); border-radius: 24px; background: white; box-shadow: 0 4px 0 var(--line); }
.practice-head { display: flex; flex-direction: column; gap: 4px; text-align: center; }
.practice-head text { color: var(--action-text); font-size: 13px; font-weight: 900; }
.practice-head strong { color: var(--navy); font-size: 22px; }
.practice-head view { margin-top: 2px; color: var(--ink-soft); font-size: 13px; line-height: 1.6; }
.practice-list { display: flex; flex-direction: column; gap: 11px; }
.practice-row { display: flex; width: min(292px,100%); min-height: 72px; align-items: center; justify-self: center; gap: 12px; margin: 0 auto; padding: 12px 15px; border: 2px solid var(--line); border-radius: 22px 22px 22px 7px; background: white; }
.practice-row.disabled { opacity:.64; }
.practice-icon { display: flex; width: 44px; height: 44px; flex: none; align-items: center; justify-content: center; border-radius: 14px 14px 14px 5px; color: var(--part-text); background: var(--part); box-shadow: 0 3px 0 var(--part-deep); font-family: "Kaiti SC",serif; font-size: 22px; }
.track-honglan { color:#30150e; background:var(--radical); box-shadow:0 3px 0 var(--radical-deep); font-size:13px; }
.track-structure { color:#301f00; background:var(--wrong); box-shadow:0 3px 0 var(--wrong-deep); }
.track-read { color:#301f00; background:var(--wrong); box-shadow:0 3px 0 var(--wrong-deep); }
.practice-row>view:nth-child(2) { display:flex; min-width:0; flex:1; flex-direction:column; gap:2px; }
.practice-row strong { color:var(--navy); font-size:15px; font-weight:900; }
.practice-row text { color:var(--ink-soft); font-size:14px; font-weight:700; }
.practice-arrow { color:var(--ink-faint); font-size:19px; }
.read-row { border-color:var(--wrong-edge); background:var(--wrong-soft); }
