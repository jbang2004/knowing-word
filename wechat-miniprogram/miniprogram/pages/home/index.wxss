.home-page { width:min(560px,100%); min-height:100vh; margin:0 auto; padding:0 16px calc(96px + env(safe-area-inset-bottom)); background:var(--sky); }
.path-workspace { display:grid; grid-template-columns:minmax(0,1fr); gap:18px; }
.path-main,.path-rail { min-width:0; }
.path-rail { display:flex; flex-direction:column; gap:14px; }
.path-rail .lesson-banner,.path-rail .focus-card,.path-main .path-map { margin-top:0; }
.path-rail .focus-card { margin-bottom:0; }
.status-row { display: flex; align-items: center; gap: 9px; width: 100%; min-height: 52px; }
.status-spacer { flex: 1; }
.avatar { display: flex; width: 40px; height: 40px; flex: none; align-items: center; justify-content: center; border-radius: 14px 14px 14px 4px; color: var(--radical-ink); background: var(--radical); box-shadow: 0 3px 0 var(--radical-deep); font-family: var(--font-kai); font-size: 18px; }
.metric { display: flex; min-height: 36px; flex: none; align-items: center; gap: 6px; padding: 6px 13px; border-radius: 999px; font-size: 15px; }
.metric strong { font-family: var(--font-round); font-weight: 900; font-variant-numeric: tabular-nums; }
.metric-icon { position:relative; display:block; width:17px; height:17px; flex:none; }
.home-flame::before { position:absolute; top:1px; left:3px; width:9px; height:12px; border:2px solid currentColor; border-radius:8px 8px 8px 2px; content:""; transform:rotate(39deg); }.home-flame i { position:absolute; top:8px; left:7px; width:4px; height:6px; border:1.7px solid currentColor; border-radius:5px 5px 4px 1px; transform:rotate(35deg); }
.home-check-circle { position:relative; width:17px; height:17px; border:2px solid currentColor; border-radius:50%; }.home-check-circle::after,.home-check::after { position:absolute; top:4px; left:3px; width:7px; height:4px; border-bottom:1.8px solid currentColor; border-left:1.8px solid currentColor; content:""; transform:rotate(-45deg); }.home-check { position:relative; width:14px; height:14px; }.home-check::after { top:3px; left:2px; }
.home-lock { position:relative; width:14px; height:13px; border:2px solid currentColor; border-radius:3px; }.home-lock::before { position:absolute; top:-8px; left:2px; width:6px; height:7px; border:2px solid currentColor; border-bottom:0; border-radius:7px 7px 0 0; content:""; }
.metric.streak { color: var(--wrong-text); background: var(--wrong-soft); box-shadow: 0 3px 0 var(--wrong-edge); }
.metric.today { color: var(--action-text); background: var(--action-soft); box-shadow: 0 3px 0 var(--action-edge); }
.lesson-banner { display: flex; align-items: center; gap: 14px; margin-top: 14px; padding: 16px; border-radius: 24px; color: var(--action-ink); background: var(--action); box-shadow: 0 5px 0 var(--action-deep); }
.lesson-banner.lesson-pressed { transform: translateY(var(--press)); box-shadow: none; }
.lesson-main { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 8px; }
.lesson-main>text { font-size: 14px; font-weight: 700; opacity: .76; }
.lesson-main>strong { font-size: 24px; font-weight: 900; line-height: 1.1; }
.lesson-progress { display: flex; align-items: center; gap: 10px; }
.lesson-progress .progress-track { width: min(112px,52%); height: 14px; }
.lesson-progress>text { font-size: 14px; font-weight: 900; }
.lesson-button { display: flex; width: 56px; height: 56px; flex: none; flex-direction: column; align-items: center; justify-content: center; gap: 3px; border-radius: 18px; color: var(--action-text); background: var(--paper); box-shadow: 0 4px 0 rgba(0,0,0,.16); font-weight: 900; }
.lesson-button text { font-size: 13px; }
.book-mark { position:relative; width:21px; height:19px; }.book-mark::before,.book-mark::after { position:absolute; top:1px; width:9px; height:15px; border:1.8px solid currentColor; content:""; }.book-mark::before { left:1px; border-radius:3px 0 0 3px; }.book-mark::after { right:1px; border-radius:0 3px 3px 0; }
.focus-card { display: grid; grid-template-columns: auto minmax(0,1fr); align-items: center; gap: 14px; margin-top: 18px; margin-bottom: 22px; padding: 16px; border: 2px solid var(--wrong-edge); border-radius: 22px; background: var(--wrong-soft); box-shadow: 0 3px 0 var(--line); }
.focus-glyph { display: flex; width: 58px; height: 58px; align-items: center; justify-content: center; border-radius: 19px 19px 19px 7px; color: var(--wrong-text); background: var(--paper); font-family: var(--font-kai); font-size: 32px; }
.focus-copy { display: flex; min-width: 0; flex-direction: column; gap: 2px; }
.focus-copy text { color: var(--wrong-text); font-size: 13px; font-weight: 900; }
.focus-copy strong { color: var(--navy); font-size: 16px; font-weight: 900; }
.focus-copy view { color: var(--ink-soft); font-size: 13px; line-height: 1.55; }
.focus-card button { grid-column: 1/-1; display:flex; width: 100%; min-height: 44px; align-items:center; justify-content:center; gap:8px; margin: 0; padding: 11px 14px; border-radius: 14px; color: white; background: var(--wrong-text); font-size: 16px; font-weight: 900; line-height: normal; }.review-icon { position:relative; width:18px; height:18px; border:2px solid currentColor; border-left-color:transparent; border-radius:50%; }.review-icon::after { position:absolute; top:-3px; left:-3px; width:0; height:0; border-top:4px solid transparent; border-right:6px solid currentColor; border-bottom:4px solid transparent; content:""; transform:rotate(20deg); }
.path-map { display: flex; flex-direction: column; gap: 20px; margin-top: 18px; }
.focus-card+.path-map { margin-top: 0; }
.chapter-rule { display: flex; height: 20px; align-items: center; gap: 12px; color: var(--ink-faint); font-size: 14px; font-weight: 900; }
.chapter-rule view { height: 2px; flex: 1; border-radius: 2px; background: var(--line); }
.path-steps { display: flex; flex-direction: column; gap: 20px; }
.path-node { position: relative; display: flex; min-height: 74px; align-items: flex-end; justify-content: center; }
.path-line { position: absolute; z-index: 0; bottom: 50%; left: calc(50% + var(--node-offset)); width: 7px; height: var(--link-length); border-radius: 999px; background: var(--line); transform: translateX(-50%) rotate(var(--link-tilt)); transform-origin: bottom center; }
.path-node.done .path-line,.path-node.current .path-line { background: var(--action-edge); }
.path-node.offset-0 { --node-offset:0px; --link-length:0px; --link-tilt:0deg; }
.path-node.offset-1 { --node-offset:52px; --link-length:107px; --link-tilt:-28.95deg; }
.path-node.offset-2 { --node-offset:72px; --link-length:96px; --link-tilt:-12.01deg; }
.path-node.offset-3 { --node-offset:52px; --link-length:96px; --link-tilt:12.01deg; }
.path-seal { position: relative; z-index: 1; display: flex; width: 74px; height: 74px; min-height: 0; margin: 0; padding: 0; align-items: center; justify-content: center; border: 0; border-radius: 24px 24px 24px 8px; font-family: var(--font-kai); font-size: 36px; font-weight: 500; line-height: normal; transform: translateX(var(--node-offset)); }
.path-seal.path-pressed { opacity:.82; transform:translateX(var(--node-offset)) translateY(var(--press)); box-shadow:none; }
.path-node.done .path-seal { color: var(--action-ink); background: var(--action); box-shadow: 0 5px 0 var(--action-deep); }
.path-node.current .path-seal { border: 3px solid var(--action); color: var(--action-text); background: var(--paper); box-shadow: 0 5px 0 var(--action-edge); }
.path-node.locked .path-seal { color: var(--disabled-ink); background: var(--sky-deep); box-shadow: 0 5px 0 var(--line-deep); }
.node-badge { position: absolute; top: -7px; right: -6px; display: flex; width: 24px; height: 24px; align-items: center; justify-content: center; border-radius: 50%; font-family: sans-serif; font-size: 11px; font-weight: 900; }
.node-badge.done { color: var(--action-ink); background: var(--action-deep); }
.node-badge.lock { color: var(--ink-faint); background: var(--sky-deep); box-shadow: 0 0 0 2px var(--sky); }
.chapter-fold { display: flex; align-items: center; gap: 11px; padding: 11px 14px; border: 2px solid var(--line); border-radius: 20px; background: var(--sky-deep); box-shadow: 0 4px 0 var(--line-deep); }
.mini-seals { display: flex; gap: 4px; flex: none; }
.mini-seals text { display: flex; width: 25px; height: 25px; align-items: center; justify-content: center; border-radius: 8px 8px 8px 3px; color: var(--ink-faint); background: var(--line); font-family: var(--font-kai); font-size: 13px; }
.chapter-fold.done { background: var(--paper); box-shadow: var(--shadow); }
.chapter-fold.done .mini-seals text { color: var(--action-ink); background: var(--action); }
.chapter-fold.done .chapter-copy strong { color: var(--navy); }
.chapter-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 1px; }
.chapter-copy strong { color: var(--ink-soft); font-size: 14px; }
.chapter-copy text { color: var(--ink-faint); font-size: 14px; font-weight: 600; line-height: 1.4; }
.fold-state { display:flex; width:22px; height:22px; align-items:center; justify-content:center; color: var(--ink-faint); }
.practice-plan { display: grid; gap: 16px; margin-top: 12px; padding: 20px; border: 2px solid var(--line); border-radius: 24px; background: var(--paper); box-shadow: 0 4px 0 var(--line); }
.practice-head { display: flex; flex-direction: column; gap: 4px; text-align: center; }
.practice-head text { color: var(--action-text); font-size: 13px; font-weight: 900; }
.practice-head strong { color: var(--navy); font-family:var(--font-serif); font-size: 22px; }
.practice-head view { margin-top: 2px; color: var(--ink-soft); font-size: 13px; line-height: 1.6; }
.practice-list { display: flex; flex-direction: column; gap: 11px; }
.practice-row { display: flex; width: min(292px,100%); min-height: 72px; align-items: center; justify-self: center; gap: 12px; margin: 0 auto; padding: 12px 15px; border: 2px solid var(--line); border-radius: 22px 22px 22px 7px; background: var(--paper); box-shadow:0 4px 0 var(--line); }
.practice-row.disabled,.practice-row.locked { opacity:.64; box-shadow:none; }
.practice-row.complete { border-color:var(--action); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }
.practice-icon { display: flex; width: 44px; height: 44px; flex: none; align-items: center; justify-content: center; border-radius: 14px 14px 14px 5px; color: var(--part-ink); background: var(--part); box-shadow: 0 3px 0 var(--part-deep); font-family: var(--font-kai); font-size: 22px; }
.track-honglan { color:var(--radical-ink); background:var(--radical); box-shadow:0 3px 0 var(--radical-deep); font-size:13px; }
.track-structure { color:var(--wrong-ink); background:var(--wrong); box-shadow:0 3px 0 var(--wrong-deep); }
.track-read { color:var(--wrong-ink); background:var(--wrong); box-shadow:0 3px 0 var(--wrong-deep); }
.practice-row.complete .practice-icon { color:var(--action-ink); background:var(--action); box-shadow:0 3px 0 var(--action-deep); }
.practice-row>view:nth-child(2) { display:flex; min-width:0; flex:1; flex-direction:column; gap:2px; }
.practice-row strong { color:var(--navy); font-size:15px; font-weight:900; }
.practice-row>view:nth-child(2)>text { color:var(--ink-soft); font-family:var(--font-round); font-size:14px; font-weight:900; font-variant-numeric:tabular-nums; }
.practice-arrow { display:flex; width:28px; height:28px; flex:none; align-items:center; justify-content:center; color:var(--ink-faint); }.home-chevron { width:9px; height:9px; border-top:2px solid currentColor; border-right:2px solid currentColor; transform:rotate(45deg); }
.practice-check { display:flex; width:28px; height:28px; align-items:center; justify-content:center; border-radius:50%; color:var(--action-ink); background:var(--action); font-size:17px; font-weight:900; }
.read-row { border-color:var(--wrong-edge); background:var(--wrong-soft); }
.read-row.disabled { box-shadow:none; }
.practice-complete { color:var(--action-text); text-align:center; font-size:13px; font-weight:900; }
@media (min-width:900px) {
  .path-workspace { grid-template-columns:minmax(0,1fr) 328px; align-items:start; gap:40px; padding-top:26px; padding-bottom:64px; }
  .path-main { grid-column:1; grid-row:1; }
  .path-rail { position:sticky; top:26px; grid-column:2; grid-row:1; }
  .status-row { height:auto !important; min-height:0; justify-content:flex-end; padding-top:0 !important; padding-right:0 !important; }
  .avatar { display:none; }
  .path-map,.path-steps { gap:24px; }
  .path-node { min-height:84px; }
  .path-seal { width:84px; height:84px; border-radius:27px 27px 27px 9px; font-size:42px; }
}
