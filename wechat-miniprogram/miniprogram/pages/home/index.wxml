<view class="page home-page theme-{{theme}} {{pageMotion}}">
  <view class="path-workspace">
  <view class="path-rail">
  <view class="status-row" style="height: {{navHeight}}px; padding-top: {{navTop}}px; padding-right: {{capsuleInset}}px;">
    <view class="avatar press-card" bindtap="openAccount" role="button" hover-class="is-pressed">{{initial}}</view>
    <view class="status-spacer"></view>
    <view class="metric streak"><ki-icon name="flame" size="17" tone="{{theme}}" /><strong>{{streak}}</strong></view>
    <view class="metric today"><ki-icon name="check-circle" size="17" /><strong>{{today.attempts}}</strong></view>
  </view>

  <view class="lesson-banner" bindtap="openLesson" role="button" hover-class="lesson-pressed">
    <view class="lesson-main">
      <text>第 {{nextLesson.position}} 课</text>
      <strong>{{nextLesson.title}}</strong>
      <view class="lesson-progress">
        <view class="progress-track"><view class="progress-value" style="width: {{lessonProgress}}%"></view></view>
        <text>{{lessonCompleted}} / {{lessonTotal}} 字</text>
      </view>
    </view>
    <view class="lesson-button"><ki-icon name="book-open" size="21" /><text>课文</text></view>
  </view>

  <view class="focus-card" wx:if="{{dueReview}}">
    <view class="focus-glyph">{{dueReview.hanzi}}</view>
    <view class="focus-copy">
      <text>今天先复习 · {{dueReviewCount}} 个字已到期</text>
      <strong>先从“{{dueReview.hanzi}}”独立回想</strong>
      <view>旧字优先，完成到期提取后再学习今天的新字。</view>
    </view>
    <button bindtap="reviewDue"><ki-icon name="refresh" size="18" /><text>开始复习</text></button>
  </view>
  </view>

  <view class="path-main">
  <view wx:if="{{pendingReadingLesson}}" class="reading-recommendation">
    <view class="reading-recommendation-glyph">读</view>
    <view class="reading-recommendation-copy"><text>语境朗读 · 推荐练习</text><strong>第 {{pendingReadingLesson.position}} 课生字已过关，读一遍《{{pendingReadingLesson.title}}》</strong><view>听范读后大声读一遍，记下感受即可；不会阻塞新课进度。</view></view>
    <button bindtap="openPendingReader"><ki-icon name="microphone" size="18" /><text>去朗读</text></button>
  </view>
  <view class="path-map">
    <block wx:for="{{pathSegments}}" wx:key="numeral" wx:for-item="segment">
      <block wx:if="{{segment.state === 'current'}}">
        <view class="chapter-rule"><view></view><text>章{{segment.numeral}} · {{segment.title}}</text><view></view></view>
        <view class="path-steps">
          <view wx:for="{{segment.characters}}" wx:key="id" wx:for-item="node" class="path-node {{node.state}} {{node.offsetClass}}">
            <view class="path-line"></view>
            <view class="path-seal-wrap">
              <view
                class="path-seal"
                data-id="{{node.id}}"
                data-state="{{node.state}}"
                bindtap="openPathCharacter"
                hover-class="path-pressed"
                role="button"
                aria-disabled="{{node.state === 'locked'}}"
                aria-label="{{node.hanzi}}{{node.state === 'done' ? '，首次学习已完成' : node.state === 'current' ? '，从这里继续' : '，完成前一步后解锁'}}"
              ><text>{{node.hanzi}}</text></view>
              <view wx:if="{{node.state === 'done'}}" class="node-badge done"><ki-icon name="check" size="13" /></view>
              <view wx:elif="{{node.state === 'locked'}}" class="node-badge lock"><ki-icon name="lock" size="13" /></view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="chapter-fold {{segment.state}}">
        <view class="mini-seals"><text wx:for="{{segment.preview}}" wx:key="*this" wx:for-item="glyph">{{glyph}}</text></view>
        <view class="chapter-copy"><strong>章{{segment.numeral}} · {{segment.title}}</strong><text>{{segment.characters.length}} 个字 · {{segment.copy}}</text></view>
        <view class="fold-state"><ki-icon wx:if="{{segment.state === 'done'}}" name="check-circle" size="17" /><ki-icon wx:else name="lock" size="17" /></view>
      </view>
    </block>
  </view>

  <view class="practice-plan card {{allWordsComplete ? 'is-ready' : 'is-locked'}}">
    <view class="practice-head"><text>{{practiceStatus}}</text><strong>整课巩固 · 选做</strong><view>哪里还不牢，就选择结构、拆字或红蓝再练一次；不影响本课完成。</view></view>
    <view class="practice-list">
      <view wx:for="{{reviewTracks}}" wx:key="id" class="practice-row press-card {{item.state}}" data-track="{{item.id}}" data-state="{{item.state}}" bindtap="openTrack" role="button" hover-class="{{item.state === 'locked' ? 'none' : 'is-pressed'}}">
        <view class="practice-icon track-{{item.id}}">{{item.glyph}}</view>
        <view><strong>{{item.title}}</strong><text>{{item.progressLabel}}</text></view>
        <view class="practice-arrow {{item.state === 'complete' ? 'practice-check' : ''}}"><ki-icon wx:if="{{item.state === 'complete'}}" name="check" size="14" /><ki-icon wx:else name="arrow-right" size="18" /></view>
      </view>
    </view>
    <view class="read-row press-card {{allWordsComplete ? '' : 'disabled'}}" bindtap="openReader" role="button" hover-class="{{allWordsComplete ? 'is-pressed' : 'none'}}">
      <ki-icon class="read-mic" name="microphone" size="18" />
      <view class="read-copy"><strong>语境朗读 · 推荐</strong><text>{{readCompleted ? '本课已经练习过，也可以再读一次' : allWordsComplete ? '大声读一遍，不影响新课进度' : '学完本课生字后开放'}}</text></view>
      <view class="practice-arrow"><ki-icon name="arrow-right" size="18" /></view>
    </view>
    <view wx:if="{{allReviewsComplete}}" class="practice-complete">三项选做复习均已完成</view>
  </view>
  </view>
  </view>
</view>
