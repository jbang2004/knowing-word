<view class="challenge-page track-{{track}}">
  <view class="challenge-bar" style="padding-top: {{navHeight + 16}}px;">
    <button class="challenge-close" bindtap="goBack" aria-label="退出练习">‹</button>
    <view class="challenge-progress"><i style="width: {{progress}}%"></i></view>
    <text class="challenge-count">{{questionIndex + 1}}/{{questions.length}}</text>
  </view>

  <view wx:if="{{loading}}" class="challenge-loading"><view class="skeleton"></view></view>
  <view wx:elif="{{error}}" class="challenge-empty"><view>{{error}}</view><button bindtap="retry">重新加载</button></view>

  <view wx:elif="{{finished}}" class="finish-card">
    <view class="finish-seal kai">{{character.hanzi}}</view>
    <strong>这一轮完成了</strong>
    <text>你已经完成“{{character.hanzi}}”的这一组练习。间隔一段时间再回来，记忆会更牢。</text>
    <button class="game-button primary" bindtap="nextCharacter">学习下一个字</button>
    <button class="game-button ghost" bindtap="viewCard">回看识字卡</button>
  </view>

  <block wx:elif="{{character}}">
    <view class="challenge-board">
      <view class="challenge-question">
        <text class="question-tag">{{questionLabel}}</text>
        <view class="question-prompt">{{question.prompt}}</view>
        <view wx:if="{{isWriting}}" class="multi-hint">读音：{{character.pinyin}}　·　词语：{{character.word}}</view>
        <view wx:if="{{multiChoice}}" class="multi-hint">需要选择多个部件 · 已选 {{selectedIds.length}} 个</view>
      </view>

      <view wx:if="{{showWritingBoard}}" class="writing-board">
        <view class="writing-glyph kai">{{character.hanzi}}</view>
        <text>先在纸上或心里写一遍，再对照范字判断。</text>
        <view class="writing-actions"><view class="writing-choice press-card" data-correct="{{false}}" bindtap="selfAssess" role="button" hover-class="is-pressed">还需要练</view><view class="writing-choice primary press-card" data-correct="{{true}}" bindtap="selfAssess" role="button" hover-class="is-pressed">我写对了</view></view>
      </view>

      <view wx:else class="choice-grid">
        <view wx:for="{{viewOptions}}" wx:key="id" class="choice-card press-card {{item.state}}" data-id="{{item.id}}" bindtap="chooseOption" role="button" hover-class="is-pressed">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="choice-image" />
          <text class="choice-key">{{item.label}}</text>
          <strong>{{item.text}}</strong>
        </view>
      </view>
    </view>

    <view wx:if="{{showPendingActions}}" class="challenge-actions">
      <view class="game-button primary {{ready ? '' : 'disabled'}}" bindtap="checkAnswer" role="button">核对答案</view>
      <view class="challenge-actions-row"><button class="text-button {{questionIndex === 0 ? 'disabled' : ''}}" bindtap="previousQuestion">← 上一题</button><button class="text-button" bindtap="skipQuestion">跳过这一题 →</button></view>
    </view>

    <view wx:if="{{answered}}" class="answer-sheet {{correct ? 'is-correct' : 'is-wrong'}}">
      <view class="answer-sheet-head"><text>{{correct ? '✓' : '↻'}}</text><strong>{{correct ? '答对了' : '再看一眼'}}</strong></view>
      <view class="answer-copy">{{resultCopy}}</view>
      <view class="game-button primary" bindtap="nextQuestion" role="button">{{questionIndex === questions.length - 1 ? '查看成绩' : '继续'}}</view>
    </view>
  </block>
</view>
