.challenge-page { display:flex; width:calc(100% - 28px); min-height:100vh; margin:0 14px; flex-direction:column; color:var(--ink); background:var(--sky); }
.challenge-bar { display:flex; align-items:center; gap:12px; }
.challenge-close { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -8px; padding:0; border-radius:50%; color:var(--ink-faint); background:transparent; font-size:34px; line-height:1; }
.challenge-progress { height:16px; flex:1; overflow:hidden; border-radius:999px; background:var(--sky-deep); }
.challenge-progress i { position:relative; display:block; height:100%; border-radius:inherit; background:var(--action); }
.challenge-progress i::after { position:absolute; top:3px; right:6px; left:6px; height:4px; border-radius:999px; background:rgba(255,255,255,.45); content:""; }
.challenge-count { flex:none; color:var(--ink-soft); font-size:15px; font-weight:900; }
.challenge-loading,.challenge-empty { padding:24px 0; }.challenge-empty { color:var(--ink-soft); text-align:center; }.challenge-empty button { min-height:46px; margin-top:18px; color:var(--action-text); }
.challenge-board { min-height:0; flex:1; padding-bottom:150px; }
.challenge-question { margin-bottom:24px; padding-top:24px; }
.question-tag { display:inline-flex; min-height:32px; align-items:center; padding:6px 13px; border-radius:999px; color:var(--action-text); background:var(--action-soft); font-size:14px; font-weight:850; }
.question-prompt { margin-top:11px; color:var(--navy); font-size:24px; font-weight:900; line-height:1.45; }
.multi-hint { display:inline-flex; margin-top:12px; padding:5px 12px; border-radius:999px; color:var(--ink-soft); background:var(--sky-deep); font-size:13px; font-weight:800; }
.choice-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:var(--card-inline-gap); row-gap:var(--card-stack-gap); }
.choice-card { position:relative; display:flex; min-width:0; min-height:104px; align-items:center; gap:12px; margin:0; padding:10px; border:2px solid var(--line); border-radius:18px; color:var(--ink); text-align:left; background:white; box-shadow:0 4px 0 var(--line); }
.choice-card.selected { border-color:var(--part); color:var(--part-text); background:var(--part-soft); box-shadow:0 4px 0 var(--part-edge); }
.choice-card.correct { border-color:var(--action); color:var(--action-text); background:var(--action-soft); box-shadow:0 4px 0 var(--action-edge); }
.choice-card.wrong { border-color:var(--wrong); color:var(--wrong-text); background:var(--wrong-soft); box-shadow:0 4px 0 var(--wrong-edge); }
.choice-key { display:flex; width:24px; height:24px; flex:none; align-items:center; justify-content:center; border:1px solid var(--part-edge); border-radius:8px; color:var(--part-text); background:white; font-size:13px; font-weight:900; }
.choice-card strong { min-width:0; font-size:19px; font-weight:800; }.choice-image { position:absolute; right:8px; bottom:8px; width:64px; height:48px; border-radius:10px; opacity:.82; }
.writing-board { padding:20px; border:2px solid var(--line); border-radius:22px; text-align:center; background:white; box-shadow:0 4px 0 var(--line); }
.writing-glyph { display:flex; width:220px; height:220px; align-items:center; justify-content:center; margin:0 auto; border:2px dashed var(--action-edge); border-radius:28px; color:rgba(11,118,84,.18); background:var(--action-soft); font-size:150px; }
.writing-board>text { display:block; margin-top:16px; color:var(--ink-soft); }.writing-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--card-inline-gap); margin-top:16px; }.writing-choice { display:flex; width:100%; min-width:0; min-height:48px; align-items:center; justify-content:center; border:2px solid var(--line); border-radius:16px; color:var(--wrong-text); background:var(--wrong-soft); box-shadow:0 4px 0 var(--wrong-edge); font-weight:900; }.writing-choice.primary { color:#0f1614; background:var(--action); box-shadow:0 4px 0 var(--action-deep); }
.challenge-actions,.answer-sheet { position:fixed; z-index:10; right:14px; bottom:0; left:14px; padding:16px 0 calc(18px + env(safe-area-inset-bottom)); }
.challenge-actions { display:flex; flex-direction:column; gap:8px; border-top:1px solid var(--line); background:var(--sky); }
.game-button { display:flex; width:100% !important; min-height:48px; align-items:center; justify-content:center; margin:0 !important; padding:11px 18px; border:2px solid var(--line); border-radius:16px; color:var(--navy); background:white; box-shadow:0 4px 0 var(--line); font-weight:900; }
.game-button.primary { min-height:58px; border:0; border-radius:20px; color:#0f1614; background:var(--action); box-shadow:0 4px 0 var(--action-deep); font-size:17px; }.game-button.disabled { color:var(--disabled-ink); background:var(--sky-deep); box-shadow:0 4px 0 var(--line-deep); }
.challenge-actions-row { display:flex; min-height:44px; align-items:center; justify-content:space-between; }.text-button { min-height:44px; margin:0; padding:0; color:var(--action-text); background:transparent; font-size:14px; font-weight:800; }.text-button.disabled { opacity:.35; }
.answer-sheet { right:0; left:0; display:flex; flex-direction:column; gap:12px; padding-right:20px; padding-left:20px; border-radius:28px 28px 0 0; }.answer-sheet.is-correct { color:#0f1614; background:var(--action); }.answer-sheet.is-wrong { color:var(--wrong-text); background:var(--wrong); }
.answer-sheet-head { display:flex; align-items:center; gap:12px; }.answer-sheet-head>text { display:flex; width:34px; height:34px; align-items:center; justify-content:center; border-radius:50%; background:rgba(255,255,255,.45); font-size:20px; font-weight:900; }.answer-sheet-head strong { font-size:21px; }.answer-copy { line-height:1.6; }.answer-sheet .game-button { align-self:stretch; border-color:rgba(15,22,20,.12); background:white; box-shadow:0 4px 0 rgba(15,22,20,.18); }
.finish-card { display:flex; min-height:calc(100vh - 120px); flex-direction:column; align-items:center; justify-content:center; text-align:center; }.finish-seal { display:flex; width:110px; height:110px; align-items:center; justify-content:center; border-radius:34px 34px 34px 11px; color:#0f1614; background:var(--action); box-shadow:0 6px 0 var(--action-deep); font-size:70px; }.finish-card>strong { margin-top:24px; color:var(--navy); font-size:24px; }.finish-card>text { max-width:320px; margin:10px 0 20px; color:var(--ink-soft); line-height:1.7; }.finish-card .game-button { width:100%; margin-top:10px; }
