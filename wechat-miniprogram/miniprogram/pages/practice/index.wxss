.retry { margin-top: 22rpx; }.practice-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 18rpx; }.counter { color: var(--ink-soft); font-weight: 900; }.question-card { position: relative; margin-top: 28rpx; padding: 34rpx; overflow: hidden; }.question-glyph { position: absolute; right: -10rpx; top: -40rpx; color: rgba(23,182,134,.08); font-family: "Kaiti SC",serif; font-size: 240rpx; }.prompt { position: relative; margin-top: 30rpx; color: var(--navy); font-size: 39rpx; font-weight: 900; line-height: 1.5; }.word-hint { position: relative; margin-top: 18rpx; color: var(--ink-soft); }
.option-list { display: flex; flex-direction: column; gap: 18rpx; margin-top: 24rpx; }.option { display: flex; align-items: center; width: 100%; min-height: 102rpx; margin: 0; padding: 14rpx 20rpx; text-align: left; color: var(--ink); }.option:active { transform: translateY(7rpx); box-shadow: none; }.option.selected { border-color: var(--part); background: var(--part-soft); box-shadow: 0 7rpx 0 var(--part-edge); }.option.correct { border-color: var(--action); background: var(--action-soft); box-shadow: 0 7rpx 0 var(--action-edge); }.option.wrong { border-color: var(--radical); background: var(--radical-soft); box-shadow: 0 7rpx 0 var(--radical-edge); }.option-mark { flex: none; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 17rpx; color: var(--part-text); background: var(--part-soft); font-weight: 900; }.option-text { flex: 1; padding: 0 18rpx; line-height: 1.5; }.option-image { flex: none; order: 3; width: 112rpx; height: 80rpx; border-radius: 14rpx; }.submit { margin-top: 8rpx; }
.write-assess { margin-top: 22rpx; padding: 30rpx; text-align: center; }.write-glyph { display: flex; align-items: center; justify-content: center; width: 300rpx; height: 300rpx; margin: 0 auto; border: 4rpx dashed var(--action-edge); border-radius: 44rpx; color: rgba(34,48,44,.20); background: var(--action-soft); font-family: "Kaiti SC",serif; font-size: 210rpx; }
.feedback { margin-top: 22rpx; padding: 28rpx; line-height: 1.65; }.feedback.right { border-color: var(--action); background: var(--action-soft); box-shadow: 0 7rpx 0 var(--action-edge); }.feedback.needs-work { border-color: var(--radical); background: var(--radical-soft); box-shadow: 0 7rpx 0 var(--radical-edge); }.feedback-title { margin-bottom: 10rpx; color: var(--navy); font-size: 31rpx; font-weight: 900; }.feedback button { margin-top: 22rpx; }.finish-card { margin-top: 30rpx; padding: 42rpx 30rpx; text-align: center; }.finish-seal { display: flex; align-items: center; justify-content: center; width: 220rpx; height: 220rpx; margin: 0 auto; border-radius: 68rpx 68rpx 68rpx 22rpx; color: #0f1614; background: var(--action); box-shadow: 0 12rpx 0 var(--action-deep); font-family: "Kaiti SC",serif; font-size: 140rpx; }.finish-title { margin-top: 28rpx; color: var(--navy); font-size: 42rpx; font-weight: 900; }.finish-card button { margin-top: 18rpx; }
