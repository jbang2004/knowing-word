.retry { margin-top: 22rpx; }.practice-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 18rpx; }.counter { color: #706b5f; font-family: Georgia,serif; }.question-card { position: relative; margin-top: 28rpx; padding: 34rpx; overflow: hidden; }.question-glyph { position: absolute; right: -10rpx; top: -40rpx; color: rgba(166,71,43,.07); font-family: "KaiTi SC",serif; font-size: 240rpx; }.prompt { position: relative; margin-top: 30rpx; font-family: "Songti SC",serif; font-size: 40rpx; font-weight: 700; line-height: 1.55; }.word-hint { position: relative; margin-top: 18rpx; color: #706b5f; }
.option-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 22rpx; }.option { display: flex; align-items: center; width: 100%; min-height: 102rpx; margin: 0; padding: 14rpx 20rpx; text-align: left; color: #27251f; }.option.selected { border-color: #466779; background: #eef4f5; }.option.correct { border-color: #55735c; background: #eaf3e9; }.option.wrong { border-color: #a6472b; background: #f8e6df; }.option-mark { flex: none; display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; color: #a6472b; background: #f2e3d3; font-family: Georgia,serif; }.option-text { flex: 1; padding: 0 18rpx; line-height: 1.5; }.option-image { flex: none; order: 3; width: 112rpx; height: 80rpx; border-radius: 14rpx; }.submit { margin-top: 8rpx; }
.write-assess { margin-top: 22rpx; padding: 30rpx; text-align: center; }.write-glyph { display: flex; align-items: center; justify-content: center; width: 300rpx; height: 300rpx; margin: 0 auto; border: 2rpx dashed rgba(166,71,43,.28); color: rgba(39,37,31,.22); background: #fffaf2; font-family: "KaiTi SC",serif; font-size: 210rpx; }
.feedback { margin-top: 22rpx; padding: 28rpx; line-height: 1.65; }.feedback.right { border-color: rgba(85,115,92,.36); }.feedback.needs-work { border-color: rgba(166,71,43,.34); }.feedback-title { margin-bottom: 10rpx; font-size: 31rpx; font-weight: 700; }.feedback button { margin-top: 22rpx; }.finish-card { margin-top: 30rpx; padding: 42rpx 30rpx; text-align: center; }.finish-seal { display: flex; align-items: center; justify-content: center; width: 220rpx; height: 220rpx; margin: 0 auto; border: 5rpx double #a6472b; border-radius: 32rpx; color: #a6472b; font-family: "KaiTi SC",serif; font-size: 140rpx; }.finish-title { margin-top: 28rpx; font-family: "Songti SC",serif; font-size: 42rpx; font-weight: 700; }.finish-card button { margin-top: 18rpx; }
