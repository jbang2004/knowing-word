.celebration-actions .game-button.primary.celebration-primary { width:100%; min-height:48px; border-radius:14px; color:var(--track-on-white); background:white; box-shadow:0 var(--press) 0 rgba(0,0,0,.18); font-size:14px; }
.celebration-actions .game-button.celebration-ghost { width:100%; min-height:48px; gap:8px; border-radius:14px; border-color:rgba(255,255,255,.42); color:inherit; background:transparent; box-shadow:none; }
.celebration-return { align-self:center; color:inherit; opacity:.78; }.replay-icon { position:relative; width:19px; height:19px; flex:none; }.replay-icon::before { position:absolute; inset:2px; border:2px solid currentColor; border-left-color:transparent; border-radius:50%; content:""; }.replay-icon::after { position:absolute; top:0; left:0; width:0; height:0; border-top:4px solid transparent; border-right:7px solid currentColor; border-bottom:4px solid transparent; content:""; transform:rotate(20deg); }
.theme-night .celebration-overlay { background:rgba(18,30,27,.78); }

@media (max-width:760px) {
  .choice-grid.is-visual { grid-template-columns:1fr; }
  .choice-grid.is-visual .choice-card { display:grid; grid-template-columns:116px minmax(0,1fr); align-items:center; min-height:136px; padding:9px; }
  .choice-grid.is-visual.no-visual-captions { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .choice-grid.is-visual.no-visual-captions .choice-card { display:flex; min-height:0; }
}
@media (max-width:420px) {
  .choice-grid.is-visual.no-visual-captions { grid-template-columns:1fr; }
  .choice-grid.is-visual.no-visual-captions .choice-card { display:block; }
}
@media (prefers-reduced-motion:reduce) {
  .answer-sheet,.answer-sheet-mark,.challenge-streak,.choice-parts,.choice-card.correct,.choice-card.wrong,.celebration-card,.celebration-glyph { animation:none; }
  .challenge-progress-value { transition:none; }
  .celebration-fly,.celebration-ring { animation:none; opacity:0; }
}

@keyframes streak-pop-a { 0% { opacity:0; transform:translateY(-7px) scale(.68); } 58% { transform:translateY(0) scale(1.14); } 100% { opacity:1; transform:none; } }
@keyframes streak-pop-b { 0% { opacity:0; transform:translateY(-7px) scale(.68); } 58% { transform:translateY(0) scale(1.14); } 100% { opacity:1; transform:none; } }
@keyframes choice-land { 0% { transform:scale(1); } 36% { transform:scale(1.05); } 100% { transform:scale(1); } }
@keyframes choice-nudge { 0%,100% { transform:translateX(0); } 16% { transform:translateX(-7px); } 40% { transform:translateX(6px); } 66% { transform:translateX(-3px); } }
@keyframes choice-parts-in { from { opacity:0; transform:translateY(5px); } to { opacity:1; transform:none; } }
@keyframes answer-sheet-rise { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:none; } }
@keyframes answer-mark-stamp { 0% { opacity:0; transform:scale(.5) rotate(-14deg); } 52% { transform:scale(1.12) rotate(3deg); } 100% { opacity:1; transform:none; } }
@keyframes mnemonic-badge-in { from { opacity:0; transform:translateY(-10px) rotate(-5deg) scale(.78); } }
@keyframes celebration-fade { from { opacity:0; } to { opacity:1; } }
@keyframes celebration-pop { from { opacity:0; transform:translateY(18px) scale(.94); } to { opacity:1; transform:none; } }
@keyframes celebration-fly-left { 0% { opacity:0; transform:translateX(-118px) scale(.8); } 18%,44% { opacity:1; transform:translateX(-74px) scale(1); } 64%,100% { opacity:0; transform:translateX(0) scale(.42); } }
@keyframes celebration-fly-right { 0% { opacity:0; transform:translateX(118px) scale(.8); } 18%,44% { opacity:1; transform:translateX(74px) scale(1); } 64%,100% { opacity:0; transform:translateX(0) scale(.42); } }
@keyframes celebration-seal { 0%,52% { opacity:0; transform:scale(.4) rotate(-13deg); } 74% { opacity:1; transform:scale(1.09) rotate(3deg); } 100% { opacity:1; transform:none; } }
@keyframes celebration-ring { 0%,58% { opacity:0; transform:scale(.62); } 70% { opacity:.55; } 92%,100% { opacity:0; transform:scale(1.55); } }
