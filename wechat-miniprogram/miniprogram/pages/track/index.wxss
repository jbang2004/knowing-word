.track-page { --track:var(--wrong); --track-deep:var(--wrong-deep); --track-soft:var(--wrong-soft); --track-edge:var(--wrong-edge); --track-ink:var(--wrong-ink); --track-text:var(--wrong-text); min-height:100vh; padding-right:16px; padding-bottom:calc(96px + env(safe-area-inset-bottom)); padding-left:16px; color:var(--ink); background:var(--sky); animation:page-arrive 620ms var(--ease-out) both; }
.track-page.tone-part { --track:var(--part); --track-deep:var(--part-deep); --track-soft:var(--part-soft); --track-edge:var(--part-edge); --track-ink:var(--part-ink); --track-text:var(--part-text); }.track-page.tone-radical { --track:var(--radical); --track-deep:var(--radical-deep); --track-soft:var(--radical-soft); --track-edge:var(--radical-edge); --track-ink:var(--radical-ink); --track-text:var(--radical-text); }
.track-heading { display:grid; grid-template-columns:44px minmax(0,1fr); gap:8px; margin-bottom:24px; }.track-heading>view { display:flex; min-width:0; flex-direction:column; gap:4px; }.track-heading text { color:var(--track-text); font-size:12px; font-weight:850; letter-spacing:.12em; }.track-heading strong { color:var(--navy); font-family:var(--font-serif); font-size:30px; line-height:1.2; }.track-heading small { color:var(--ink-soft); font-size:13px; line-height:1.65; }
.track-hero { display:grid; grid-template-columns:62px minmax(0,1fr); align-items:center; gap:14px; padding:18px 20px; overflow:hidden; border-radius:25px; color:var(--track-ink); background:var(--track); box-shadow:0 5px 0 var(--track-deep); }.track-symbol { display:flex; width:62px; height:62px; align-items:center; justify-content:center; border:1px solid rgba(255,255,255,.38); border-radius:20px; background:rgba(255,255,255,.15); font-size:32px; font-weight:900; }.hero-copy { display:flex; min-width:0; flex-direction:column; }.hero-copy text { color:rgba(255,255,255,.72); font-size:13px; font-weight:750; }.hero-copy strong { font-family:var(--font-serif); font-size:26px; }.hero-copy small { margin-top:4px; color:rgba(255,255,255,.78); font-size:13px; line-height:1.45; }.track-hero button { grid-column:1/-1; width:100%; min-height:48px; margin:2px 0 0; border-radius:16px; color:var(--track-text); background:white; box-shadow:0 var(--press) 0 rgba(0,0,0,.18); font-size:14px; font-weight:900; }
.track-method-card { display:flex; flex-direction:column; margin-top:16px; padding:20px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.track-method-card>text { color:var(--track-text); font-size:11px; font-weight:900; letter-spacing:.15em; }.track-method-card strong { margin-top:6px; color:var(--navy); font-family:var(--font-serif); font-size:21px; }.track-method-card view { margin-top:8px; color:var(--ink-soft); font-size:13px; line-height:1.65; }
.level-map { margin-top:30px; }.level-map-title { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-bottom:13px; }.level-map-title strong { color:var(--navy); font-family:var(--font-serif); font-size:25px; }.level-map-title text { color:var(--ink-soft); font-size:12px; }.level-list { display:flex; flex-direction:column; gap:10px; }.level-row { display:grid; min-height:72px; grid-template-columns:72px minmax(0,1fr) 48px 22px; align-items:center; gap:9px; padding:12px 14px; border:2px solid var(--line); border-radius:18px; background:var(--paper); box-shadow:0 2px 0 var(--line); }.level-row>text { color:var(--track-text); font-size:12px; font-weight:820; }.level-row strong { min-width:0; overflow:hidden; color:var(--navy); font-family:var(--font-kai); font-size:17px; white-space:nowrap; text-overflow:ellipsis; }.level-row i { color:var(--ink-soft); font-size:12px; font-style:normal; text-align:right; }.level-row b { color:var(--track-text); font-size:18px; }
.track-lesson-board { padding:20px; border:2px solid var(--line); border-radius:25px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.track-lesson-note { margin-bottom:20px; color:var(--ink-soft); font-size:13px; line-height:1.65; }.track-character-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); column-gap:var(--card-inline-gap); row-gap:var(--card-stack-gap); }.track-character { position:relative; display:grid; min-height:104px; padding:10px; border:2px solid var(--line); border-radius:15px; text-align:left; background:var(--paper-soft); box-shadow:0 var(--press) 0 var(--line); }.track-character.is-complete { border-color:var(--action-edge); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }.track-character small { color:var(--ink-faint); font-size:12px; font-weight:700; }.track-character strong { align-self:center; color:var(--track-text); font-size:33px; text-align:center; }.track-character i { color:var(--ink-soft); font-size:12px; font-style:normal; font-weight:740; text-align:center; }
.track-lesson-empty { display:flex; min-height:260px; flex-direction:column; align-items:center; justify-content:center; gap:12px; text-align:center; }.track-lesson-empty strong { color:var(--navy); font-family:var(--font-serif); font-size:24px; }.track-lesson-empty text { max-width:320px; color:var(--ink-soft); font-size:13px; line-height:1.7; }.track-lesson-empty button { min-height:48px; margin:4px 0 0; padding:11px 18px; border-radius:16px; color:#0f1614; background:var(--action); box-shadow:0 var(--press) 0 var(--action-deep); font-weight:900; }
@media (min-width:421px) { .track-character-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } }
