.track-page { --track:var(--wrong); --track-deep:var(--wrong-deep); --track-soft:var(--wrong-soft); --track-edge:var(--wrong-edge); --track-ink:var(--wrong-ink); --track-text:var(--wrong-text); min-height:100vh; padding-right:16px; padding-bottom:calc(96px + env(safe-area-inset-bottom)); padding-left:16px; color:var(--ink); background:var(--sky); animation:page-arrive 620ms var(--ease-out) both; }
.track-page.tone-part { --track:var(--part); --track-deep:var(--part-deep); --track-soft:var(--part-soft); --track-edge:var(--part-edge); --track-ink:var(--part-ink); --track-text:var(--part-text); }.track-page.tone-radical { --track:var(--radical); --track-deep:var(--radical-deep); --track-soft:var(--radical-soft); --track-edge:var(--radical-edge); --track-ink:var(--radical-ink); --track-text:var(--radical-text); }
.track-heading { display:grid; grid-template-columns:44px minmax(0,1fr); gap:8px; margin-bottom:24px; }.track-heading>view { display:flex; min-width:0; flex-direction:column; gap:4px; }.track-heading text { color:var(--track-text); font-size:12px; font-weight:850; letter-spacing:.12em; }.track-heading strong { color:var(--navy); font-family:var(--font-serif); font-size:30px; line-height:1.2; }.track-heading small { color:var(--ink-soft); font-size:13px; line-height:1.65; }
.track-map-layout { display:grid; grid-template-columns:minmax(0,1fr); gap:24px; }
.track-map-aside { display:grid; grid-row:1; gap:14px; }
.track-hero { display:grid; grid-template-columns:minmax(0,1fr); align-items:start; gap:17px; padding:25px; overflow:hidden; border-radius:25px; color:var(--track-ink); background:var(--track); box-shadow:0 5px 0 var(--track-deep); }.track-symbol { display:flex; width:72px; height:72px; align-items:center; justify-content:center; border:1px solid rgba(255,255,255,.38); border-radius:22px; background:rgba(255,255,255,.15); font-size:39px; font-weight:900; }.hero-copy { display:flex; min-width:0; flex-direction:column; }.hero-copy text { color:rgba(255,255,255,.72); font-size:13px; font-weight:750; }.hero-copy strong { font-family:var(--font-serif); font-size:26px; }.hero-copy small { margin-top:4px; color:rgba(255,255,255,.78); font-size:13px; line-height:1.45; }.track-hero button { width:100%; min-height:48px; margin:2px 0 0; border-radius:16px; color:var(--track-text); background:white; box-shadow:0 var(--press) 0 rgba(0,0,0,.18); font-size:14px; font-weight:900; }
.track-method-card { display:flex; flex-direction:column; padding:23px; border:1px solid var(--line); border-radius:23px; background:var(--paper); box-shadow:var(--shadow-xs); }.track-method-card>text { color:var(--track-text); font-size:11px; font-weight:900; letter-spacing:.15em; }.track-method-card strong { margin-top:6px; color:var(--navy); font-family:var(--font-serif); font-size:18px; line-height:1.45; }.track-method-card view { margin-top:12px; color:var(--ink-soft); font-size:13px; line-height:1.7; }
.level-map { min-width:0; margin:0; }.level-map-title { display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-bottom:13px; }.level-map-title strong { color:var(--navy); font-family:var(--font-serif); font-size:25px; }.level-map-title text { color:var(--ink-soft); font-size:12px; }.level-list { display:flex; flex-direction:column; gap:10px; }.level-row { display:grid; min-height:72px; grid-template-columns:88px minmax(0,1fr) 76px 25px; align-items:center; gap:14px; padding:12px 18px; border:1px solid var(--line); border-radius:18px; background:var(--paper); box-shadow:var(--shadow-xs); }.level-row>text { color:var(--track-text); font-size:12px; font-weight:820; }.level-row strong { min-width:0; overflow:hidden; color:var(--navy); font-family:var(--font-kai); font-size:17px; white-space:nowrap; text-overflow:ellipsis; }.level-row i { color:var(--ink-soft); font-size:12px; font-style:normal; text-align:right; }.level-row>ki-icon { color:var(--track-text); }
.track-lesson-board { padding:24px; border:2px solid var(--line); border-radius:25px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.track-lesson-note { margin-bottom:20px; color:var(--ink-soft); font-size:13px; line-height:1.65; }.track-character-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); column-gap:var(--card-inline-gap); row-gap:var(--card-stack-gap); }.track-character { position:relative; display:grid; min-height:104px; padding:10px; border:2px solid var(--line); border-radius:15px; text-align:left; background:var(--paper-soft); box-shadow:0 var(--press) 0 var(--line); }.track-character.is-complete { border-color:var(--action-edge); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }.track-character small { color:var(--ink-faint); font-size:12px; font-weight:700; }.track-character strong { align-self:center; color:var(--track-text); font-size:33px; text-align:center; }.track-character i { color:var(--ink-soft); font-size:12px; font-style:normal; font-weight:740; text-align:center; }
.track-lesson-empty { display:flex; min-height:260px; flex-direction:column; align-items:center; justify-content:center; gap:12px; text-align:center; }.track-lesson-empty strong { color:var(--navy); font-family:var(--font-serif); font-size:24px; }.track-lesson-empty text { max-width:320px; color:var(--ink-soft); font-size:13px; line-height:1.7; }.track-lesson-empty button { min-height:48px; margin:4px 0 0; padding:11px 18px; border-radius:16px; color:#0f1614; background:var(--action); box-shadow:0 var(--press) 0 var(--action-deep); font-weight:900; }
@media (min-width:421px) { .track-character-grid { grid-template-columns:repeat(4,minmax(0,1fr)); } }
@media (max-width:420px) {
  .level-row { grid-template-columns:64px minmax(0,1fr) auto 20px; gap:8px; padding:11px 12px; }
}
@media (min-width:761px) and (max-width:980px) {
  .track-map-aside { grid-template-columns:minmax(0,1fr) minmax(260px,.72fr); }
  .track-character-grid { grid-template-columns:repeat(6,minmax(0,1fr)); }
}
@media (min-width:981px) {
  .track-map-layout { grid-template-columns:minmax(0,1fr) 306px; align-items:start; }
  .track-map-aside { position:sticky; top:8px; grid-column:2; grid-row:1; }
  .level-map { grid-column:1; grid-row:1; }
  .track-character-grid { grid-template-columns:repeat(8,minmax(0,1fr)); }
}

/* Role surfaces resolve through the same semantic tokens as the Web map. */
.track-hero { border-radius:24px; }
.track-hero .hero-copy text,.track-hero .hero-copy strong,.track-hero .hero-copy small { color:inherit; }
.track-symbol { border-radius:22px 22px 22px 7px; font-family:var(--font-kai); font-weight:500; }
.track-hero button { color:var(--navy-on-white); background:#fff; box-shadow:0 var(--press) 0 var(--line); }
.level-row { border:2px solid var(--line); box-shadow:0 var(--press) 0 var(--line); }
.track-lesson-board { border-radius:22px; }
.track-lesson-note { padding:14px 16px; border:2px solid var(--wrong-edge); border-radius:20px; background:var(--wrong-soft); box-shadow:0 var(--press) 0 var(--wrong-edge); font-size:15px; font-weight:700; line-height:1.7; }
.track-character { border-radius:18px; background:var(--paper); }
.track-lesson-empty button { color:var(--action-ink); }
.track-hero button { display:flex; align-items:center; justify-content:center; gap:5px; }
.track-character .track-done-icon { justify-self:center; color:var(--action-text); }
@media (prefers-reduced-motion:reduce) { .track-page { animation:none; } }

/* Match the final Web app-shell and solid-block cascade. */
.track-heading { display:flex; min-height:54px; align-items:center; gap:8px; margin-bottom:14px; }
.track-heading>view { flex:1; gap:2px; }
.track-heading text { display:none; }
.track-heading strong { font-family:var(--font-sans); font-size:24px; font-weight:900; letter-spacing:0; line-height:1.25; }
.track-heading small { display:none; max-width:720px; font-size:15px; font-weight:500; line-height:1.75; }
.track-symbol { color:var(--track-ink); background:var(--track); box-shadow:0 var(--press) 0 var(--track-deep); }
.track-method-card { border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }
.track-character { min-height:86px; }
.track-lesson-empty { display:grid; min-height:0; justify-items:start; align-content:start; gap:10px; padding:28px; border:2px dashed var(--line-deep); border-radius:20px; text-align:left; background:var(--sky-deep); }
.track-lesson-empty text { max-width:560px; }

@media (min-width:761px) {
  .track-character { min-height:104px; }
}

@media (min-width:900px) {
  .track-heading { min-height:0; align-items:flex-start; margin-bottom:22px; padding-top:6px; }
  .track-heading strong { font-size:32px; }
  .track-heading small { display:block; margin-top:6px; }
}
