.page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.lesson-list { display: flex; flex-direction: column; gap: 22rpx; margin-top: 34rpx; }
.lesson-row { display: flex; min-height: 220rpx; overflow: hidden; }
.lesson-row:active { transform: translateY(7rpx); box-shadow: none; }
.cover { flex: none; width: 196rpx; height: 220rpx; background: var(--sky-deep); }
.lesson-info { flex: 1; min-width: 0; padding: 24rpx; }
.meta { display: flex; align-items: center; justify-content: space-between; color: var(--radical-text); font-size: 21rpx; font-weight: 850; }
.status { color: var(--ink-soft); }.status-100 { color: var(--action-text); }
.name { margin-top: 10rpx; color: var(--navy); font-size: 37rpx; font-weight: 900; }
.context { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: var(--ink-soft); font-size: 22rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.progress-row { display: flex; align-items: center; gap: 12rpx; margin-top: 17rpx; color: var(--ink-soft); font-size: 20rpx; font-weight: 800; }
.progress-row .progress-track { flex: 1; background: var(--action-soft); }.progress-row .progress-value { background: var(--action); }
