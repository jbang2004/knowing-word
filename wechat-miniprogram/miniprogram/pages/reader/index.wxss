.read-page { width:calc(100% - 32px); min-height:100vh; margin:0 16px; padding-bottom:calc(96px + env(safe-area-inset-bottom)); }
.utility-heading { display:flex; min-height:54px; align-items:center; gap:10px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--line); }
.utility-heading button { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -10px; padding:0 12px; color:var(--ink-soft); background:transparent; font-size:34px; line-height:1; }
.utility-heading-content { display:flex; min-width:0; flex:1; flex-direction:column; gap:2px; }
.utility-heading strong { min-width:0; color:var(--navy); font-family:var(--font-sans); font-size:clamp(24px,6vw,30.4px); font-weight:900; line-height:1.25; white-space:normal; }
.utility-heading-content>text { display:none; max-width:720px; margin:0; color:var(--ink-soft); font-size:15px; font-weight:500; line-height:1.75; }
.read-loading,.read-empty { padding:24px 0; color:var(--ink-soft); text-align:center; }
.read-lesson-picker { display:grid; min-height:0; grid-template-columns:44px minmax(0,1fr) 44px; align-items:center; gap:8px; margin-bottom:16px; padding:10px; border:1px solid var(--line); border-radius:999px; background:var(--paper); box-shadow:var(--shadow-xs); }
.read-lesson-picker>button { display:flex; width:44px; height:44px; min-height:0; align-items:center; justify-content:center; margin:0; padding:0; border:2px solid var(--line); border-radius:13px; color:var(--navy); background:var(--paper); box-shadow:0 3px 0 var(--line); }.read-lesson-picker>button:active { transform:translateY(3px); box-shadow:none; }.read-lesson-picker>button.disabled { color:var(--disabled-ink); background:var(--sky-deep); box-shadow:0 3px 0 var(--line-deep); opacity:1; }.reader-icon-left { transform:rotate(180deg); }
.lesson-select { display:flex; min-width:0; flex-direction:column; gap:3px; }.lesson-select text { color:var(--ink-soft); font-size:11px; font-weight:750; }.lesson-select strong { overflow:hidden; color:var(--navy); font-family:"Songti SC",STSong,serif; font-size:16px; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.read-studio { display:grid; min-height:0; grid-template-columns:67px minmax(0,1fr); align-items:center; gap:13px; padding:19px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }
.read-mascot { display:flex; width:62px; height:62px; align-items:center; justify-content:center; border-radius:18px; color:var(--action-text); background:var(--action-soft); }.read-mascot text { font-family:"Knowing Kai","Kaiti SC",STKaiti,serif; font-size:36px; line-height:1; }
.studio-copy { display:flex; min-width:0; flex-direction:column; }.studio-copy>text { color:var(--radical-text); font-size:10px; font-weight:900; letter-spacing:2px; }.studio-copy>strong { margin-top:3px; color:var(--navy); font-family:"Songti SC",STSong,serif; font-size:22px; }.studio-copy>view { margin-top:4px; color:var(--ink-soft); font-size:13px; }
.record-launch { grid-column:1/-1; display:flex; min-height:48px; align-items:center; justify-content:center; gap:8px; margin:0; padding:11px 18px; border-radius:16px; color:var(--action-ink); background:var(--action); box-shadow:0 var(--press) 0 var(--action-deep); font-size:14px; font-weight:900; }
.sentence-list { margin-top:15px; }.sentence-card { display:flex; min-height:0; flex-direction:row; align-items:center; justify-content:space-between; gap:15px; padding:15px 17px; border:2px solid var(--line); border-radius:18px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); transition:transform 220ms var(--ease-out),border-color 220ms ease,box-shadow 220ms ease,background-color 220ms ease; }.sentence-card.speaking { border-color:var(--action-edge); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }.sentence-card.is-pressed { transform:translateY(var(--press)); box-shadow:none; }.sentence-card>text { color:var(--ink); font-family:var(--font-serif); font-size:16px; line-height:1.65; }.sentence-action { display:flex; min-height:44px; align-items:center; gap:6px; padding:9px 13px; border:2px solid var(--line); border-radius:14px; color:var(--navy); background:var(--paper); box-shadow:0 3px 0 var(--line); font-size:13px; font-weight:820; }
.reading-reflection { display:grid; grid-template-columns:33px minmax(0,1fr); align-items:center; gap:11px; margin-top:14px; padding:13px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }.reading-reflection.is-recorded { border-color:var(--action-edge); background:var(--action-soft); }.reflection-copy { display:flex; min-width:0; flex-direction:column; }.reflection-copy strong { color:var(--navy); font-size:13px; }.reflection-copy text { margin-top:3px; color:var(--ink-soft); font-size:13px; line-height:1.45; }.reflection-actions { grid-column:1/-1; display:flex; flex-direction:column; gap:8px; }.reflection-actions button,.reflection-again { min-height:48px; margin:0; padding:10px 14px; border-radius:16px; color:var(--action-ink); background:var(--action); box-shadow:0 4px 0 var(--action-deep); font-size:13px; font-weight:900; }.reflection-actions button.ghost,.reflection-again { border:2px solid var(--line); color:var(--navy); background:var(--paper); box-shadow:0 4px 0 var(--line); }.reflection-again { grid-column:1/-1; }
.optional-recording { display:grid; gap:13px; margin-top:14px; padding:16px; border:2px dashed var(--line); border-radius:20px; background:var(--paper-soft); }.optional-recording>view:first-child { display:flex; min-width:0; flex-direction:column; }.optional-recording>view:first-child>text { color:var(--radical-text); font-size:10px; font-weight:900; letter-spacing:1px; }.optional-recording>view:first-child>strong { margin-top:4px; color:var(--navy); font-size:16px; }.optional-recording>view:first-child>view { margin-top:4px; color:var(--ink-soft); font-size:12px; line-height:1.55; }.record-toggle { display:flex; min-height:46px; align-items:center; justify-content:center; gap:7px; padding:10px 14px; border:2px solid var(--line); border-radius:15px; color:var(--navy); background:var(--paper); box-shadow:0 3px 0 var(--line); font-size:13px; font-weight:850; }.record-toggle.recording { border-color:#c8204e; color:white; background:linear-gradient(135deg,#e74862,#c8204e); box-shadow:0 var(--press) 0 #9e193d; animation:recording-heartbeat 1150ms ease-in-out infinite; }
.recording-result { display:grid; grid-template-columns:33px minmax(0,1fr); align-items:center; gap:11px; margin-top:14px; padding:13px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }.result-mark { display:flex; width:29px; height:29px; align-items:center; justify-content:center; border-radius:50%; color:#0f1614; background:var(--action); }.recording-result>view:nth-child(2) { display:flex; flex-direction:column; }.recording-result strong { color:var(--navy); font-size:13px; }.recording-result view text { margin-top:3px; color:var(--ink-soft); font-size:13px; line-height:1.45; }.play-recording { grid-column:1/-1; min-height:44px; margin:0; border:2px solid var(--line); border-radius:14px; color:var(--navy); background:var(--paper); box-shadow:0 3px 0 var(--line); font-weight:800; }
.play-recording:active,.reflection-actions button:active,.reflection-again:active { transform:translateY(3px); box-shadow:none; }
@keyframes recording-heartbeat { 50% { box-shadow:0 0 0 8px rgba(231,72,98,.16); } }
@media (prefers-reduced-motion:reduce) { .record-toggle.recording { animation:none; }.sentence-card,.sentence-action,.play-recording,.reflection-actions button,.reflection-again { transition:none; } }

/* Final pill and feedback states from the Web reader cascade. */
.read-lesson-picker { border:2px solid var(--line); border-radius:999px; box-shadow:0 3px 0 var(--line); }
.lesson-select strong,.studio-copy>strong { font-family:var(--font-serif); }
.read-mascot text { font-family:var(--font-kai); }
.sentence-card.speaking .sentence-action { border-color:var(--action-edge); color:var(--action-text); background:var(--action-soft); box-shadow:0 3px 0 var(--action-edge); }
.result-mark,.reflection-actions button { color:var(--action-ink); }
.read-lesson-position { display:none; }
.record-launch { transition:transform 220ms var(--ease-out),box-shadow 220ms ease,background-color 220ms ease,border-color 220ms ease; }
.sentence-card { transition:transform 90ms ease,box-shadow 90ms ease,border-color 140ms ease,background-color 140ms ease; }
@media (prefers-reduced-motion:reduce) { .record-launch,.sentence-card { transition:none; } }
@media (max-width:420px) { .sentence-card { align-items:flex-start; flex-direction:column; } }
@media (min-width:761px) {
  .read-lesson-picker { min-height:0; grid-template-columns:44px minmax(0,1fr) auto 44px; gap:10px; border-radius:999px; }
  .read-lesson-position { display:block; padding:7px 10px; border-radius:999px; color:var(--ink-soft); background:var(--paper-soft); font-size:11px; font-weight:750; white-space:nowrap; }
  .read-studio { min-height:0; grid-template-columns:88px minmax(0,1fr) auto; gap:21px; padding:20px; }
  .read-mascot { width:80px; height:80px; }
  .record-launch { grid-column:auto; }
  .sentence-card { min-height:0; flex-direction:row; align-items:center; }
  .reading-reflection { grid-template-columns:33px minmax(0,1fr) minmax(180px,.7fr); }
  .reflection-actions { grid-column:auto; flex-direction:row; flex-wrap:wrap; }
  .reflection-again { grid-column:auto; }
  .optional-recording { grid-template-columns:minmax(0,1fr) auto; align-items:center; }
  .recording-result { grid-template-columns:33px minmax(0,1fr) minmax(170px,.7fr); }
  .play-recording { grid-column:auto; }
}
@media (min-width:900px) {
  .utility-heading { min-height:0; align-items:flex-start; gap:8px; margin-bottom:22px; padding-top:6px; padding-bottom:0; }
  .utility-heading strong { font-size:32px; }
  .utility-heading-content>text { display:block; margin-top:6px; }
}
