.read-page { width:calc(100% - 32px); min-height:100vh; margin:0 16px; padding-bottom:calc(96px + env(safe-area-inset-bottom)); }
.utility-heading { display:flex; height:61px; align-items:flex-start; gap:0; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--line); }
.utility-heading button { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -10px; padding:0 12px; color:var(--ink-soft); background:transparent; font-size:34px; line-height:1; }
.utility-heading strong { min-width:0; padding-top:7px; color:var(--navy); font-size:24px; font-weight:900; line-height:30px; white-space:nowrap; }
.read-loading,.read-empty { padding:24px 0; color:var(--ink-soft); text-align:center; }
.read-lesson-picker { display:grid; min-height:87px; grid-template-columns:44px minmax(0,1fr) 44px; align-items:center; gap:8px; margin-bottom:16px; padding:10px; border:1px solid var(--line); border-radius:999px; background:var(--paper); box-shadow:var(--shadow-xs); }
.read-lesson-picker>button { display:flex; width:44px; height:44px; min-height:0; align-items:center; justify-content:center; margin:0; padding:0; border:2px solid var(--line); border-radius:13px; color:var(--navy); background:var(--paper); box-shadow:0 3px 0 var(--line); }.read-lesson-picker>button:active { transform:translateY(3px); box-shadow:none; }.read-lesson-picker>button.disabled { color:var(--disabled-ink); background:var(--sky-deep); box-shadow:0 3px 0 var(--line-deep); opacity:1; }.reader-chevron { width:10px; height:10px; border-top:2px solid currentColor; border-right:2px solid currentColor; }.reader-chevron.is-left { transform:rotate(-135deg); }.reader-chevron.is-right { transform:rotate(45deg); }
.lesson-select { display:flex; min-width:0; flex-direction:column; gap:3px; }.lesson-select text { color:var(--ink-soft); font-size:11px; font-weight:750; }.lesson-select strong { overflow:hidden; color:var(--navy); font-family:"Songti SC",STSong,serif; font-size:16px; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.read-studio { display:grid; min-height:177px; grid-template-columns:67px minmax(0,1fr); align-items:center; gap:13px; padding:19px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }
.read-mascot { display:flex; width:62px; height:62px; align-items:center; justify-content:center; border-radius:18px; color:var(--action-text); background:var(--action-soft); }.read-mascot text { font-family:"Knowing Kai","Kaiti SC",STKaiti,serif; font-size:36px; line-height:1; }
.studio-copy { display:flex; min-width:0; flex-direction:column; }.studio-copy>text { color:var(--radical-text); font-size:10px; font-weight:900; letter-spacing:2px; }.studio-copy>strong { margin-top:3px; color:var(--navy); font-family:"Songti SC",STSong,serif; font-size:22px; }.studio-copy>view { margin-top:4px; color:var(--ink-soft); font-size:13px; }
.record-launch { grid-column:1/-1; display:flex; min-height:48px; align-items:center; justify-content:center; gap:8px; margin:0; padding:11px 18px; border-radius:16px; color:var(--action-ink); background:var(--action); box-shadow:0 var(--press) 0 var(--action-deep); font-size:14px; font-weight:900; }.record-launch.recording { color:white; background:linear-gradient(135deg,#e74862,#c8204e); box-shadow:0 var(--press) 0 #9e193d; animation:recording-heartbeat 1150ms ease-in-out infinite; }
.record-mark { position:relative; width:18px; height:18px; flex:none; }.record-mark.microphone::before { position:absolute; top:0; left:5px; width:7px; height:11px; border:1.8px solid currentColor; border-radius:6px; content:""; }.record-mark.microphone::after { position:absolute; top:7px; left:3px; width:11px; height:8px; border-right:1.8px solid currentColor; border-bottom:1.8px solid currentColor; border-left:1.8px solid currentColor; border-radius:0 0 8px 8px; box-shadow:0 3px 0 -1px currentColor; content:""; }.record-mark.stop::before { position:absolute; inset:3px; border-radius:2px; background:currentColor; content:""; }
.sentence-list { margin-top:15px; }.sentence-card { display:flex; min-height:146px; flex-direction:column; align-items:flex-start; justify-content:space-between; gap:15px; padding:15px 17px; border:2px solid var(--line); border-radius:18px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); transition:transform 220ms var(--ease-out),border-color 220ms ease,box-shadow 220ms ease,background-color 220ms ease; }.sentence-card.speaking { border-color:var(--action-edge); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }.sentence-card>text { color:var(--ink); font-family:var(--font-serif); font-size:16px; line-height:1.65; }.sentence-action { display:flex; min-height:44px; align-items:center; gap:6px; padding:9px 13px; border:2px solid var(--line); border-radius:14px; color:var(--navy); background:var(--paper); box-shadow:0 3px 0 var(--line); font-size:13px; font-weight:820; }
.audio-icon { position:relative; width:18px; height:18px; flex:none; }.audio-icon::before { position:absolute; top:6px; left:1px; width:5px; height:6px; border-radius:1px; background:currentColor; content:""; }.audio-icon::after { position:absolute; top:3px; left:4px; width:0; height:0; border-top:6px solid transparent; border-right:8px solid currentColor; border-bottom:6px solid transparent; content:""; }
.recording-result { display:grid; grid-template-columns:33px minmax(0,1fr); align-items:center; gap:11px; margin-top:14px; padding:13px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }.result-mark { display:flex; width:29px; height:29px; align-items:center; justify-content:center; border-radius:50%; color:#0f1614; background:var(--action); }.result-check { width:12px; height:7px; border-bottom:2px solid currentColor; border-left:2px solid currentColor; transform:translateY(-1px) rotate(-45deg); }.recording-result>view:nth-child(2) { display:flex; flex-direction:column; }.recording-result strong { color:var(--navy); font-size:13px; }.recording-result view text { margin-top:3px; color:var(--ink-soft); font-size:13px; line-height:1.45; }.play-recording { grid-column:1/-1; min-height:44px; margin:0; border:2px solid var(--line); border-radius:14px; color:var(--navy); background:var(--paper); box-shadow:0 3px 0 var(--line); font-weight:800; }.play-recording:active,.recording-assessment button:active { transform:translateY(3px); box-shadow:none; }
.recording-assessment { grid-column:1/-1; display:flex; flex-direction:column; gap:8px; }.recording-assessment button { min-height:48px; margin:0; padding:10px 14px; border-radius:16px; color:#0f1614; background:var(--action); box-shadow:0 4px 0 var(--action-deep); font-size:13px; font-weight:900; }.recording-assessment button.ghost { border:2px solid var(--line); color:var(--navy); background:var(--paper); box-shadow:0 4px 0 var(--line); }
.recording-check-gate { grid-column:1/-1; margin:0; padding:11px 13px; border:1px solid var(--line); border-radius:13px; color:var(--ink-soft); background:var(--paper-soft); font-size:12px; font-weight:700; line-height:1.5; }
@keyframes recording-heartbeat { 0%,100% { box-shadow:0 var(--press) 0 #9e193d,0 0 0 0 rgba(231,72,98,0); } 50% { box-shadow:0 var(--press) 0 #9e193d,0 0 0 8px rgba(231,72,98,.16); } }
@media (prefers-reduced-motion:reduce) { .record-launch.recording { animation:none; }.sentence-card,.sentence-action,.play-recording,.recording-assessment button { transition:none; } }

/* Final pill and feedback states from the Web reader cascade. */
.read-lesson-picker { border:2px solid var(--line); border-radius:999px; box-shadow:0 3px 0 var(--line); }
.lesson-select strong,.studio-copy>strong { font-family:var(--font-serif); }
.read-mascot text { font-family:var(--font-kai); }
.sentence-card.speaking .sentence-action { border-color:var(--action-edge); color:var(--action-text); background:var(--action-soft); box-shadow:0 3px 0 var(--action-edge); }
.result-mark,.recording-assessment button { color:var(--action-ink); }
.recording-check-gate { padding:0; border:0; border-radius:0; color:var(--wrong-text); background:none; font-weight:750; line-height:1.6; }
.read-lesson-position { display:none; }
@media (min-width:761px) {
  .read-lesson-picker { min-height:0; grid-template-columns:44px minmax(0,1fr) auto 44px; gap:10px; border-radius:18px; }
  .read-lesson-position { display:block; padding:7px 10px; border-radius:999px; color:var(--ink-soft); background:var(--paper-soft); font-size:11px; font-weight:750; white-space:nowrap; }
  .read-studio { min-height:0; grid-template-columns:88px minmax(0,1fr) auto; gap:21px; padding:20px; }
  .read-mascot { width:80px; height:80px; }
  .record-launch { grid-column:auto; }
  .sentence-card { min-height:0; flex-direction:row; align-items:center; }
  .recording-result { grid-template-columns:33px minmax(0,1fr) minmax(170px,.7fr); }
  .play-recording { grid-column:auto; }
  .recording-assessment { grid-column:2/-1; flex-direction:row; flex-wrap:wrap; }
}
