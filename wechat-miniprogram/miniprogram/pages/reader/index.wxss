.reading { margin-top: 28rpx; padding: 30rpx; }.reading-section + .reading-section { margin-top: 34rpx; padding-top: 30rpx; border-top: 2rpx solid var(--line); }.reading-title { color: var(--navy); font-size: 34rpx; font-weight: 900; }.paragraph { margin-top: 18rpx; color: var(--ink); font-size: 30rpx; line-height: 2; text-align: justify; }
.recorder { margin-top: 24rpx; padding: 38rpx 28rpx; text-align: center; }.record-orbit { display: flex; align-items: center; justify-content: center; width: 190rpx; height: 190rpx; margin: 0 auto; border: 3rpx solid var(--radical-edge); border-radius: 50%; background: var(--radical-soft); }.record-orbit.active { animation: pulse 1.4s infinite; }.record-button { display: flex; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; padding: 0; border-radius: 50%; color: #30150e; background: var(--radical); box-shadow: 0 8rpx 0 var(--radical-deep); font-size: 42rpx; font-weight: 900; }.record-title { margin-top: 24rpx; color: var(--navy); font-size: 31rpx; font-weight: 900; }.record-copy,.cloud-status { margin-top: 8rpx; color: var(--ink-soft); font-size: 23rpx; line-height: 1.6; }.play { margin-top: 20rpx; }.assessment { margin-top: 24rpx; }@keyframes pulse { 50% { transform: scale(1.05); box-shadow: 0 0 0 24rpx var(--radical-soft); } }
