.reading { margin-top: 28rpx; padding: 30rpx; }.reading-section + .reading-section { margin-top: 34rpx; padding-top: 30rpx; border-top: 1rpx solid rgba(77,67,47,.12); }.reading-title { font-family: "Songti SC",serif; font-size: 34rpx; font-weight: 700; }.paragraph { margin-top: 18rpx; font-family: "Songti SC",serif; font-size: 31rpx; line-height: 2; text-align: justify; }
.recorder { margin-top: 24rpx; padding: 38rpx 28rpx; text-align: center; }.record-orbit { display: flex; align-items: center; justify-content: center; width: 190rpx; height: 190rpx; margin: 0 auto; border: 2rpx solid rgba(166,71,43,.18); border-radius: 50%; }.record-orbit.active { animation: pulse 1.4s infinite; }.record-button { display: flex; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; padding: 0; border-radius: 50%; color: white; background: #a6472b; font-family: "Songti SC",serif; font-size: 44rpx; }.record-title { margin-top: 24rpx; font-size: 31rpx; font-weight: 700; }.record-copy,.cloud-status { margin-top: 8rpx; color: #706b5f; font-size: 23rpx; line-height: 1.6; }.play { margin-top: 20rpx; }.assessment { margin-top: 24rpx; }@keyframes pulse { 50% { transform: scale(1.05); box-shadow: 0 0 0 24rpx rgba(166,71,43,.08); } }
