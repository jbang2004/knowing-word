.read-page { width:calc(100% - 32px); min-height:100vh; margin:0 16px; padding-bottom:calc(56px + env(safe-area-inset-bottom)); }
.utility-heading { display:flex; height:61px; align-items:flex-start; gap:0; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--line); }
.utility-heading button { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -10px; padding:0 12px; color:var(--ink-soft); background:transparent; font-size:34px; line-height:1; }
.utility-heading strong { min-width:0; padding-top:7px; color:var(--navy); font-size:24px; font-weight:900; line-height:30px; white-space:nowrap; }
.read-loading,.read-empty { padding:24px 0; color:var(--ink-soft); text-align:center; }
.read-lesson-picker { display:grid; min-height:64px; grid-template-columns:44px minmax(0,1fr) 44px; align-items:center; gap:8px; margin-bottom:16px; padding:10px; border:1px solid var(--line); border-radius:18px; background:white; box-shadow:var(--shadow-xs); }
.read-lesson-picker>button { display:flex; width:44px; height:44px; min-height:0; align-items:center; justify-content:center; margin:0; padding:0; border:2px solid var(--line); border-radius:13px; color:var(--navy); background:white; box-shadow:0 3px 0 var(--line); font-size:27px; }.read-lesson-picker>button.disabled { color:var(--disabled-ink); background:var(--sky-deep); box-shadow:0 3px 0 var(--line-deep); }
.lesson-select { display:flex; min-width:0; flex-direction:column; gap:3px; }.lesson-select text { color:var(--ink-soft); font-size:11px; font-weight:750; }.lesson-select strong { overflow:hidden; color:var(--navy); font-family:"Songti SC",STSong,serif; font-size:16px; font-weight:800; text-overflow:ellipsis; white-space:nowrap; }
.read-studio { display:grid; min-height:177px; grid-template-columns:67px minmax(0,1fr); align-items:center; gap:13px; padding:19px; border:2px solid var(--line); border-radius:22px; background:white; box-shadow:0 4px 0 var(--line); }
.read-mascot { display:flex; width:62px; height:62px; align-items:center; justify-content:center; border-radius:18px; color:var(--action-text); background:var(--action-soft); }.read-mascot text { font-family:"Knowing Kai","Kaiti SC",STKaiti,serif; font-size:36px; line-height:1; }
.studio-copy { display:flex; min-width:0; flex-direction:column; }.studio-copy>text { color:var(--radical-text); font-size:10px; font-weight:900; letter-spacing:2px; }.studio-copy>strong { margin-top:3px; color:var(--navy); font-family:"Songti SC",STSong,serif; font-size:22px; }.studio-copy>view { margin-top:4px; color:var(--ink-soft); font-size:13px; }
.record-launch { grid-column:1/-1; display:flex; min-height:48px; align-items:center; justify-content:center; gap:8px; margin:0; padding:11px 18px; border-radius:16px; color:var(--action-ink); background:var(--action); box-shadow:0 var(--press) 0 var(--action-deep); font-size:14px; font-weight:900; }.record-launch.recording { color:white; background:var(--radical); box-shadow:0 var(--press) 0 var(--radical-deep); animation:recording-heartbeat 1150ms ease-in-out infinite; }
.record-mark { width:12px; height:12px; border-radius:50%; background:currentColor; }.record-mark.stop { border-radius:2px; }
.sentence-list { margin-top:15px; }.sentence-card { display:flex; min-height:146px; flex-direction:column; align-items:flex-start; justify-content:space-between; gap:15px; padding:15px 17px; border:2px solid var(--line); border-radius:18px; background:white; box-shadow:0 var(--press) 0 var(--line); }.sentence-card.speaking { border-color:var(--action-edge); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }.sentence-card>text { color:var(--ink); font-family:var(--font-serif); font-size:16px; line-height:1.65; }.sentence-action { display:flex; min-height:44px; align-items:center; gap:6px; padding:9px 13px; border:2px solid var(--line); border-radius:14px; color:var(--navy); background:white; box-shadow:var(--shadow); font-size:13px; font-weight:820; }
.audio-icon { position:relative; width:18px; height:18px; flex:none; }.audio-icon::before { position:absolute; top:6px; left:1px; width:5px; height:6px; border-radius:1px; background:currentColor; content:""; }.audio-icon::after { position:absolute; top:3px; left:4px; width:0; height:0; border-top:6px solid transparent; border-right:8px solid currentColor; border-bottom:6px solid transparent; content:""; }
.recording-result { display:grid; grid-template-columns:33px minmax(0,1fr); align-items:center; gap:11px; margin-top:14px; padding:13px; border:2px solid var(--line); border-radius:22px; background:white; box-shadow:0 4px 0 var(--line); animation:recording-result-in 320ms var(--ease-out) both; }.result-mark { display:flex; width:29px; height:29px; align-items:center; justify-content:center; border-radius:50%; color:#0f1614; background:var(--action); font-weight:900; }.recording-result>view:nth-child(2) { display:flex; flex-direction:column; }.recording-result strong { color:var(--navy); font-size:13px; }.recording-result view text { margin-top:3px; color:var(--ink-soft); font-size:13px; line-height:1.45; }.play-recording { grid-column:1/-1; min-height:44px; margin:0; border:2px solid var(--line); border-radius:14px; color:var(--navy); background:white; box-shadow:0 3px 0 var(--line); font-weight:800; }
.recording-assessment { grid-column:1/-1; display:flex; flex-direction:column; gap:8px; }.recording-assessment button { min-height:48px; margin:0; padding:10px 14px; border-radius:16px; color:#0f1614; background:var(--action); box-shadow:0 4px 0 var(--action-deep); font-size:13px; font-weight:900; }.recording-assessment button.ghost { border:2px solid var(--line); color:var(--navy); background:white; box-shadow:0 4px 0 var(--line); }
@keyframes recording-heartbeat { 0%,100% { transform:scale(1); } 46% { transform:scale(.975); } 62% { transform:scale(1.018); } }
@keyframes recording-result-in { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
