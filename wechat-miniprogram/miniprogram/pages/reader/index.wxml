<view class="read-page" style="padding-top: {{navHeight + 18}}px;">
  <view class="utility-heading"><button bindtap="goBack">‹</button><strong>先听一遍，再把句子读出来</strong></view>

  <view wx:if="{{loading}}" class="read-loading"><view class="skeleton"></view></view>
  <view wx:elif="{{error}}" class="read-empty">{{error}}</view>
  <block wx:else>
    <view class="read-lesson-picker">
      <button class="{{lessonIndexValue === 0 ? 'disabled' : ''}}" data-offset="-1" bindtap="stepLesson">‹</button>
      <picker mode="selector" range="{{lessonOptions}}" range-key="label" value="{{lessonIndexValue}}" bindchange="chooseLesson">
        <view class="lesson-select"><text>选择朗读课次</text><strong>第 {{lesson.position}} 课 · {{lesson.title}}</strong></view>
      </picker>
      <button class="{{lessonIndexValue === lessonOptions.length - 1 ? 'disabled' : ''}}" data-offset="1" bindtap="stepLesson">›</button>
    </view>

    <view class="read-studio">
      <view class="read-mascot"><text>读</text></view>
      <view class="studio-copy"><text>跟读小任务</text><strong>{{lesson.title}}</strong><view>先听范读，再按下录音键读一遍。</view></view>
      <view class="record-launch {{recording ? 'recording' : ''}}" bindtap="toggleRecording" role="button"><text>{{recording ? '■' : '●'}}</text>{{recording ? '结束录音' : '开始录音'}}</view>
    </view>

    <view class="sentence-list">
      <view class="sentence-card {{speaking ? 'speaking' : ''}}">
        <text>“{{lesson.context}}”</text>
        <view class="sentence-action" bindtap="previewSentence" role="button"><text>♪</text>{{speaking ? '正在范读…' : '范读'}}</view>
      </view>
    </view>

    <view wx:if="{{tempFilePath}}" class="recording-result">
      <text class="result-mark">✓</text>
      <view><strong>{{cloudStatus || '先回听，再判断是否读准'}}</strong><text>完整听一遍自己的录音，再如实做自我评估。</text></view>
      <button class="play-recording" bindtap="playRecording">{{playing ? '停止回听' : '回听录音'}} · {{durationText}}</button>
      <view class="recording-assessment"><button data-accurate="{{true}}" bindtap="assess">我回听后自评：每个字都读准了</button><button class="ghost" data-accurate="{{false}}" bindtap="assess">有字读错，再练一次</button></view>
    </view>
  </block>
</view>
