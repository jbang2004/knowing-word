.account-page { min-height:100vh; padding-right:16px; padding-bottom:calc(104px + env(safe-area-inset-bottom)); padding-left:16px; color:var(--ink); background:var(--sky); }
.account-heading { padding-bottom:17px; border-bottom:1px solid var(--line); color:var(--navy); font-size:27px; font-weight:900; line-height:1.25; }
.account-card { margin-top:22px; padding:21px 22px 24px; border:2px solid var(--line); border-radius:22px; background:white; box-shadow:0 4px 0 var(--line); }
.avatar { display:flex; width:72px; height:72px; align-items:center; justify-content:center; border-radius:22px 22px 22px 7px; color:#30150e; background:var(--radical); box-shadow:0 4px 0 var(--radical-deep); font-family:"Knowing Kai","Kaiti SC",serif; font-size:42px; }
.sync-status { display:flex; height:25px; align-items:center; gap:8px; margin-top:14px; padding:0 13px; border-radius:999px; color:var(--wrong-text); background:var(--wrong-soft); font-size:12px; }.sync-status i { width:9px; height:9px; border:1px solid var(--wrong-text); border-radius:50%; }.sync-status.online { color:var(--action-text); background:var(--action-soft); }.sync-status.online i { border-color:var(--action); background:var(--action); }
.field-label { display:block; margin-top:15px; color:var(--ink); font-size:14px; }.profile-input,.grade-field { width:100%; height:45px; margin-top:7px; padding:0 16px; border:1px solid var(--line); border-radius:13px; color:var(--ink); background:var(--paper-soft); font-size:15px; }.profile-input { box-sizing:border-box; }.grade-label { margin-top:13px; }.grade-field { display:flex; align-items:center; justify-content:space-between; font-weight:700; }.account-summary { margin-top:24px; color:var(--ink-soft); font-size:13px; }
.setting-row { display:flex; min-height:54px; align-items:center; gap:13px; margin-top:14px; padding:0 19px; border:2px solid var(--line); border-radius:18px; color:var(--ink); background:white; box-shadow:0 4px 0 var(--line); }.setting-row+.setting-row { margin-top:10px; }.setting-row i { width:18px; color:var(--part-text); font-size:20px; font-style:normal; text-align:center; }.setting-row strong { font-size:15px; }.setting-row .theme-icon { color:var(--part-text); }.danger-row i,.danger-row strong { color:var(--radical-text); }
