.profile-card { display: flex; align-items: center; gap: 24rpx; padding: 30rpx; }.avatar { display: flex; align-items: center; justify-content: center; width: 110rpx; height: 110rpx; border-radius: 50%; color: white; background: #a6472b; font-family: "Songti SC",serif; font-size: 48rpx; }.profile-name { font-family: "Songti SC",serif; font-size: 38rpx; font-weight: 700; }.sync { display: flex; align-items: center; gap: 9rpx; margin-top: 8rpx; color: #706b5f; font-size: 22rpx; }.sync text { width: 14rpx; height: 14rpx; border-radius: 50%; background: #b4aa98; }.sync.online text { background: #55735c; }
.summary-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; margin-top: 20rpx; }.stat { padding: 24rpx 8rpx; text-align: center; }.stat strong,.stat text { display: block; }.stat strong { font-family: Georgia,serif; font-size: 38rpx; }.stat text { margin-top: 6rpx; color: #706b5f; font-size: 19rpx; }.name-row { display: flex; gap: 12rpx; margin-top: 20rpx; }.name-row input { flex: 1; min-width: 0; height: 82rpx; padding: 0 22rpx; border: 1rpx solid rgba(77,67,47,.14); border-radius: 18rpx; background: #fffdf7; }.name-row button { flex: none; margin: 0; padding: 0 28rpx; border-radius: 18rpx; color: white; background: #55735c; }.reconnect { margin-top: 22rpx; }
.menu { margin-top: 24rpx; padding: 0 28rpx; }.menu>view,.menu navigator { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; border-bottom: 1rpx solid rgba(77,67,47,.1); }.menu navigator:last-child { border: 0; }.menu view view,.menu navigator view { color: #706b5f; font-size: 23rpx; }.menu b { margin-left: 10rpx; color: #a6472b; font-size: 32rpx; }.danger { margin-top: 28rpx; color: #a6472b; background: transparent; font-size: 24rpx; }
