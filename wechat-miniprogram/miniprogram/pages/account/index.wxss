.page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.profile-card { display: flex; align-items: center; gap: 24rpx; padding: 30rpx; }.avatar { display: flex; align-items: center; justify-content: center; width: 110rpx; height: 110rpx; border-radius: 35rpx 35rpx 35rpx 11rpx; color: #30150e; background: var(--radical); box-shadow: 0 7rpx 0 var(--radical-deep); font-size: 48rpx; }.profile-name { color: var(--navy); font-size: 38rpx; font-weight: 900; }.sync { display: flex; align-items: center; gap: 9rpx; margin-top: 8rpx; color: var(--ink-soft); font-size: 22rpx; }.sync text { width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--line-deep); }.sync.online text { background: var(--action); }
.summary-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; margin-top: 22rpx; }.stat { padding: 24rpx 8rpx; text-align: center; }.stat strong,.stat text { display: block; }.stat strong { color: var(--navy); font-size: 38rpx; font-weight: 900; }.stat text { margin-top: 6rpx; color: var(--ink-soft); font-size: 19rpx; }
.name-row { display: flex; gap: 12rpx; margin-top: 20rpx; }.name-row input { flex: 1; min-width: 0; height: 82rpx; padding: 0 22rpx; border: 2rpx solid var(--line); border-radius: 22rpx; background: var(--paper); }.name-row button { flex: none; margin: 0; padding: 0 28rpx; border-radius: 22rpx; color: #0f1614; background: var(--action); box-shadow: 0 6rpx 0 var(--action-deep); font-weight: 900; }.reconnect { margin-top: 22rpx; }
.menu { margin-top: 24rpx; padding: 0 28rpx; }.menu>view,.menu navigator { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; border-bottom: 2rpx solid var(--line); }.menu navigator:last-child { border: 0; }.menu view view,.menu navigator view { color: var(--ink-soft); font-size: 23rpx; }.menu b { margin-left: 10rpx; color: var(--action-text); font-size: 32rpx; }.danger { margin-top: 28rpx; color: var(--radical-text); background: transparent; font-size: 24rpx; }
