<view class="account-page theme-{{theme}} {{pageMotion}}" style="padding-top: {{contentTop}}px;">
  <view class="account-heading">
    <text class="account-kicker">我的账户</text>
    <text class="account-title">这是属于你的学习空间</text>
    <text class="account-copy">{{headingCopy}}</text>
  </view>

  <view class="account-card">
    <view class="avatar">{{initial}}</view>
    <view class="sync-status {{connected ? 'online' : ''}}" bindtap="reconnect"><i></i><text>{{connected ? '微信同步已连接' : '离线，联网后自动同步'}}</text></view>
    <label class="field-label">学习小名</label>
    <input class="profile-input" value="{{name}}" maxlength="18" bindinput="onNameInput" bindblur="saveName" placeholder="给自己取一个名字" />
    <label class="field-label grade-label">孩子年级</label>
    <picker mode="selector" range="{{gradeOptions}}" range-key="label" value="{{gradeIndex}}" bindchange="changeGrade">
      <view class="grade-field press-card" role="button" hover-class="is-pressed"><text>{{grade}} 年级</text><ki-icon name="chevron-down" size="16" /></view>
    </picker>
    <view class="account-summary">已完成 {{completed}} 个学习关卡 · 认识 {{components}} 个部件</view>
  </view>

  <navigator class="setting-row press-card" url="/pages/records/index" hover-class="is-pressed"><ki-icon name="chart" size="20" /><strong>学习记录与错题重练</strong></navigator>
  <view class="setting-row press-card" bindtap="toggleTheme" role="button" hover-class="is-pressed"><ki-icon name="moon" size="20" /><strong>{{theme === 'night' ? '切换日间模式' : '切换夜读模式'}}</strong></view>
  <view class="setting-row danger-row press-card" bindtap="resetProgress" role="button" hover-class="is-pressed"><ki-icon name="delete" size="20" /><strong>清除学习记录</strong></view>
</view>
