.summary-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; margin-top: 28rpx; }.stat { padding: 24rpx 10rpx; text-align: center; }.stat strong,.stat text { display: block; }.stat strong { font-family: Georgia,serif; font-size: 42rpx; }.stat text { margin-top: 5rpx; color: #706b5f; font-size: 20rpx; }
.track-record { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid rgba(77,67,47,.1); }.track-record:last-child { border: 0; }.track-record strong { color: #a6472b; }.lesson-record { padding: 20rpx 0; border-bottom: 1rpx solid rgba(77,67,47,.1); }.lesson-record>view:first-child { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 12rpx; }.lesson-record strong { color: #706b5f; }.recording-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid rgba(77,67,47,.1); }.recording-row strong,.recording-row text { display: block; }.recording-row text { margin-top: 6rpx; color: #706b5f; font-size: 21rpx; }.recording-row button { flex: none; margin: 0; padding: 0 26rpx; min-height: 62rpx; border-radius: 99rpx; color: white; background: #55735c; font-size: 23rpx; }.mini { min-height: 100rpx; margin-top: 18rpx; }
