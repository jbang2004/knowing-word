.page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.summary-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; margin-top: 28rpx; }
.stat { padding: 24rpx 10rpx; text-align: center; }.stat strong,.stat text { display: block; }.stat strong { color: var(--navy); font-size: 42rpx; font-weight: 900; }.stat text { margin-top: 5rpx; color: var(--ink-soft); font-size: 20rpx; }
.track-record { display: flex; justify-content: space-between; padding: 21rpx 0; border-bottom: 2rpx solid var(--line); }.track-record:last-child { border: 0; }.track-record strong { color: var(--action-text); }
.lesson-record { padding: 21rpx 0; border-bottom: 2rpx solid var(--line); }.lesson-record>view:first-child { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 13rpx; }.lesson-record strong { color: var(--action-text); }.lesson-record .progress-track { background: var(--action-soft); }.lesson-record .progress-value { background: var(--action); }
.recording-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }.recording-row strong,.recording-row text { display: block; }.recording-row strong { color: var(--navy); }.recording-row text { margin-top: 6rpx; color: var(--ink-soft); font-size: 21rpx; }.recording-row button { flex: none; margin: 0; padding: 0 26rpx; min-height: 62rpx; border-radius: 22rpx; color: #0f1614; background: var(--action); box-shadow: 0 5rpx 0 var(--action-deep); font-size: 23rpx; font-weight: 900; }.mini { min-height: 100rpx; margin-top: 18rpx; }
