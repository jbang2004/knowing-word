.records-page { min-height:100vh; padding-right:16px; padding-bottom:calc(96px + env(safe-area-inset-bottom)); padding-left:16px; background:var(--sky); }
.records-heading { display:flex; min-height:54px; align-items:center; gap:10px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid var(--line); color:var(--navy); }
.records-heading button { width:44px; height:44px; min-height:0; margin:0 0 0 -10px; padding:0; color:var(--ink-soft); background:transparent; }
.records-heading-content { display:flex; min-width:0; flex:1; flex-direction:column; gap:2px; }
.records-heading-content>strong { min-width:0; color:var(--navy); font-family:var(--font-sans); font-size:clamp(24px,6vw,30.4px); font-weight:900; line-height:1.25; }
.records-heading-content>text { display:none; max-width:720px; margin:0; color:var(--ink-soft); font-size:15px; font-weight:500; line-height:1.75; }
.record-stat-row { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
.record-stat-row>view { display:flex; min-height:0; flex-direction:column; align-items:center; justify-content:center; gap:4px; padding:13px 8px; border:2px solid var(--line); border-radius:20px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }
.record-stat-row>view.achievement { border-color:var(--action-edge); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }
.record-stat-row text,.record-stat-row small { display:block; color:var(--ink-soft); font-size:13px; font-weight:700; }
.record-stat-row strong { display:block; margin:7px 0 2px; color:var(--ink-soft); font-family:var(--font-round); font-size:28px; font-weight:900; font-variant-numeric:tabular-nums; line-height:1; }
.record-stat-row .achievement strong { color:var(--action-text); font-size:40px; }
.record-tabs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px; margin:27px 0 13px; }
.record-tabs button { display:flex; min-height:44px; align-items:center; justify-content:center; margin:0; padding:8px 15px; border:1px solid var(--line); border-radius:999px; color:var(--ink-soft); background:var(--paper); font-size:13px; font-weight:800; }
.record-tabs button.active { border-color:var(--action-deep); color:var(--action-ink); background:var(--action); box-shadow:0 3px 0 var(--action-deep); }
.record-recent { margin:22px 0 14px; padding:16px; border:2px solid var(--line); border-radius:21px; background:var(--paper); box-shadow:0 4px 0 var(--line); }
.recent-head { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:14px; }
.recent-head>view { display:flex; flex-direction:column; }
.recent-head>view>text { color:var(--radical-text); font-size:12px; font-weight:800; letter-spacing:1px; }
.recent-head strong { margin-top:2px; color:var(--navy); font-family:var(--font-serif); font-size:19px; }
.recent-head>text { color:var(--ink-soft); font-size:12px; }
.recent-list { display:grid; gap:8px; }
.recent-list button { display:grid; min-height:70px; grid-template-columns:42px minmax(0,1fr); align-items:center; margin:0; padding:10px; border:1px solid var(--line); border-radius:14px; color:var(--ink); text-align:left; background:var(--paper-soft); }
.recent-list button>strong { grid-row:1/3; color:var(--navy); font-family:"Knowing Kai","Kaiti SC",serif; font-size:28px; }
.recent-list button>view { display:flex; min-width:0; flex-direction:column; }
.recent-list button text { font-size:12px; font-weight:800; }
.recent-list button small { overflow:hidden; margin-top:3px; color:var(--ink-soft); font-size:11px; text-overflow:ellipsis; white-space:nowrap; }
.record-scope-bar { display:grid; gap:16px; min-height:62px; margin:14px 0 12px; padding:10px 14px 10px 18px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }
.record-scope-bar>view { display:flex; flex-direction:column; gap:2px; }
.record-scope-bar strong { color:var(--navy); font-size:13px; }
.record-scope-bar text { color:var(--ink-soft); font-size:12px; }
.record-scope-bar button { width:100%; min-height:44px; margin:0; padding:8px 15px; border:2px solid var(--line); border-radius:999px; color:var(--navy); background:var(--paper); box-shadow:0 3px 0 var(--line); font-size:12px; font-weight:800; }
.record-lessons { display:grid; gap:13px; }
.record-lesson { display:flex; flex-direction:column; gap:12px; }
.lesson-head { display:flex; align-items:center; justify-content:space-between; gap:15px; padding:17px 20px; border-bottom:1px solid var(--line); }
.lesson-head>view { display:flex; flex-direction:column; }
.lesson-head>view>text { color:var(--part-text); font-size:13px; font-weight:800; }
.lesson-head strong { margin-top:3px; color:var(--navy); font-family:"Songti SC",serif; font-size:20px; }
.lesson-head>text { color:var(--ink-soft); font-size:13px; }
.lesson-characters { display:grid; gap:0; }
.lesson-characters button { display:flex; min-height:62px; align-items:center; gap:12px; margin:0; padding:12px 14px; border:2px solid var(--line); border-radius:18px; color:var(--ink); text-align:left; background:var(--paper); box-shadow:0 4px 0 var(--line); }
.lesson-characters button>strong { width:34px; color:var(--navy); font-family:"Knowing Kai","Kaiti SC",serif; font-size:26px; }
.lesson-characters button>view { display:flex; flex:1; flex-direction:column; }
.lesson-characters button>view text { font-size:12px; font-weight:800; }
.lesson-characters small,.lesson-characters button>text { color:var(--ink-soft); font-size:11px; }
.lesson-empty { padding:8px 20px; color:var(--ink-soft); font-size:13px; }
.record-zero-state { display:flex; min-height:290px; flex-direction:column; align-items:center; justify-content:center; padding:40px 24px; border:1px dashed var(--line); border-radius:22px; text-align:center; background:var(--paper); }
.record-spark { position:relative; width:32px; height:32px; color:var(--action-text); }.record-spark::before { position:absolute; top:3px; left:8px; width:12px; height:12px; border:2.5px solid currentColor; content:""; transform:rotate(45deg); }.record-spark::after { position:absolute; right:1px; bottom:2px; width:7px; height:7px; border:2px solid currentColor; content:""; transform:rotate(45deg); }
.record-zero-state>strong { margin-top:6px; color:var(--navy); font-size:19px; }
.record-zero-state>.record-zero-copy { margin-top:8px; color:var(--ink-soft); font-size:13px; line-height:1.6; }
.record-zero-state button { min-height:46px; margin-top:18px; padding:0 24px; border-radius:999px; color:#0f1614; background:var(--action); box-shadow:0 4px 0 var(--action-deep); font-size:13px; font-weight:900; }
@media (min-width:431px) {
  .record-tabs { display:flex; }
  .recent-list { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .record-scope-bar { display:flex; align-items:flex-start; justify-content:space-between; }
  .record-scope-bar button { width:auto; flex:none; }
}
@media (min-width:761px) {
  .record-stat-row { gap:12px; }
  .record-recent { padding:20px; }
  .recent-list { grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
  .lesson-characters { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media (min-width:900px) {
  .records-heading { min-height:0; align-items:flex-start; gap:8px; margin-bottom:22px; padding-top:6px; padding-bottom:0; }
  .records-heading-content>strong { font-size:32px; }
  .records-heading-content>text { display:block; margin-top:6px; }
}

/* Solid-surface and typography parity with the Web records view. */
.record-stat-row>view { border-radius:24px; }
.record-stat-row strong { font-family:var(--font-serif); }
.record-tabs button { border:2px solid var(--line); box-shadow:0 3px 0 var(--line); }
.record-recent { border-radius:22px; }
.recent-list button>strong,.lesson-characters button>strong { font-family:var(--font-kai); }
.lesson-head strong { font-family:var(--font-serif); }
.lesson-characters button>strong { display:flex; width:34px; height:34px; align-items:center; justify-content:center; border-radius:10px; color:var(--part-text); background:var(--part-soft); font-size:22px; font-weight:500; }
.lesson-empty { padding:22px 20px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }
.record-zero-state { border:2px solid var(--line); background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }
.record-zero-state>strong { font-family:var(--font-serif); }
.record-zero-state button { color:var(--action-ink); }
.lesson-characters button>.record-view-action { flex:none; flex-direction:row; align-items:center; gap:3px; color:var(--ink-soft); font-size:11px; }
