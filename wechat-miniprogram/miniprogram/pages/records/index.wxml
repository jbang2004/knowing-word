<view class="records-page theme-{{theme}}" style="padding-top: {{contentTop}}px;">
  <view class="records-heading"><button class="nav-back" bindtap="goBack" aria-label="返回"><view class="nav-back-icon"></view></button><view>看见自己一步一步学会的过程</view></view>

  <view class="record-stat-row">
    <view class="achievement"><text>已完成</text><strong>{{completed}}</strong><small>个本关字</small></view>
    <view><text>累计作答</text><strong>{{attempts}}</strong><small>次</small></view>
    <view><text>答对次数</text><strong>{{correct}}</strong><small>次</small></view>
  </view>

  <view class="record-tabs">
    <button wx:for="{{tracks}}" wx:key="id" class="{{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="switchTrack">{{item.label}}</button>
  </view>

  <view wx:if="{{recentCount}}" class="record-recent">
    <view class="recent-head"><view><text>最近练习</text><strong>从刚才学到的地方继续</strong></view><text>最近 {{recentCount}} 个字</text></view>
    <view class="recent-list">
      <button wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" data-lesson-id="{{item.lessonId}}" bindtap="openCharacter"><strong>{{item.hanzi}}</strong><view><text>{{item.status}}</text><small>{{item.attempts}} 次作答 · {{item.dateText}}</small></view></button>
    </view>
  </view>

  <view class="record-scope-bar">
    <view><strong>{{activeLessonCount}} 课有记录</strong><text>{{showAllLessons ? ('正在显示全部 ' + allLessonCount + ' 课') : '默认隐藏尚未开始的课次'}}</text></view>
    <button bindtap="toggleAllLessons">{{showAllLessons ? '只看有记录' : ('显示全部 ' + allLessonCount + ' 课')}}</button>
  </view>

  <view class="record-lessons">
    <block wx:if="{{hasLessons}}">
      <view wx:for="{{visibleLessons}}" wx:key="id" class="record-lesson {{item.active ? '' : 'empty-lesson'}}">
        <view class="lesson-head"><view><text>第 {{item.position}} 课</text><strong>{{item.title}}</strong></view><text>{{item.completed}}/{{item.total}} 已完成</text></view>
        <view wx:if="{{item.recorded.length}}" class="lesson-characters">
          <button wx:for="{{item.recorded}}" wx:for-item="character" wx:key="id" data-id="{{character.id}}" data-lesson-id="{{character.lessonId}}" bindtap="openCharacter"><strong>{{character.hanzi}}</strong><view><text>{{character.status}}</text><small>{{character.attempts}} 次作答</small></view><text>查看 →</text></button>
        </view>
        <view wx:else class="lesson-empty">尚未开始本路线</view>
      </view>
    </block>
    <view wx:else class="record-zero-state"><text>✦</text><strong>还没有{{activeTrackLabel}}记录</strong><view>完成第一次闯关后，最近练习与课次记录会自动整理在这里。</view><button bindtap="startPractice">开始第一次练习</button></view>
  </view>

  <bottom-navigation active="profile" theme="{{theme}}" />
</view>
