<view class="lesson-page theme-{{theme}}">
  <view class="lesson-topbar" style="height: {{navHeight}}px; padding-top: {{navTop}}px; padding-right: {{capsuleInset}}px;">
    <button class="nav-back" bindtap="goBack" aria-label="返回"><ki-icon name="arrow-left" size="22" /></button><view>{{lesson.title}}</view>
  </view>

  <view class="lesson-tabs" style="top: {{navHeight}}px;">
    <button class="{{activeView === 'guide' ? 'active' : ''}}" data-view="guide" bindtap="switchView" hover-class="is-pressed"><ki-icon name="book-open" size="17" /><strong>课文导读</strong></button>
    <button class="{{activeView === 'words' ? 'active' : ''}}" data-view="words" bindtap="switchView" hover-class="is-pressed"><ki-icon name="list" size="17" /><strong>生字表</strong></button>
    <button class="{{activeView === 'practice' ? 'active' : ''}}" data-view="practice" bindtap="switchView" hover-class="is-pressed"><ki-icon name="grid" size="17" /><strong>复习巩固</strong></button>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap"><view class="skeleton"></view></view>
  <view wx:elif="{{error}}" class="error-wrap"><view>{{error}}</view><button bindtap="retry">重新加载</button></view>

  <view wx:elif="{{activeView === 'guide'}}" class="guide-layout">
    <view class="guide-paper">
      <view class="guide-masthead">
        <view class="accent"></view>
        <text>{{document.eyebrow || ('《' + lesson.title + '》课文导读')}}</text>
        <view class="guide-title">{{document.title || ('读《' + lesson.title + '》')}}</view>
        <view class="guide-dek">{{document.dek || ('带着三条线索打开课本，把本课 ' + total + ' 个重点词放回真实阅读过程。')}}</view>
        <view class="source-note"><ki-icon name="star" size="18" /><view><strong>{{document.rights.label || '原创课文导读'}}</strong><text>{{document.rights.note || '围绕阅读方法独立编写，不展示教材正文，也不提供课文替代文本。'}}</text></view></view>
      </view>

      <view class="guide-body">
        <view wx:if="{{document.intro}}" class="guide-intro"><text>先带着问题读</text><view>{{document.intro}}</view><small><ki-icon name="book-open" size="15" />请打开纸质课本第 {{lesson.position}} 课</small></view>
        <view wx:for="{{guideSections}}" wx:key="id" id="guide-section-{{item.id}}" class="guide-section {{highlightedSectionId === item.id ? 'is-highlighted' : ''}}">
          <view class="section-head"><i>{{item.number || index + 1}}</i><strong>{{item.title}}</strong></view>
          <view wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="id" id="{{paragraph.id}}" class="guide-paragraph">
            <block wx:for="{{paragraph.segments}}" wx:for-item="segment" wx:key="key">
              <text wx:if="{{segment.targetId}}" class="reader-target is-{{segment.state}} {{segment.done ? 'is-complete' : ''}}" data-id="{{segment.targetId}}" bindtap="openCharacter" role="button" aria-label="{{segment.targetWord}}里的{{segment.text}}，进入字卡" hover-class="is-pressed">{{segment.text}}<text wx:if="{{segment.done}}" class="reader-target-check">✓</text></text>
              <text wx:else>{{segment.text}}</text>
            </block>
          </view>
          <view wx:if="{{item.question}}" class="guide-question"><text>想一想</text><view>{{item.question}}</view></view>
          <view wx:if="{{item.focusWordItems.length}}" class="focus-area">
            <view class="focus-head"><strong>本段重点词</strong><text>点击彩色生字进入字卡</text></view>
            <view class="focus-grid">
              <view wx:for="{{item.focusWordItems}}" wx:for-item="focusWord" wx:key="key" class="focus-word {{focusWord.done ? 'done' : ''}} {{focusWord.wide ? 'is-wide' : ''}}">
                <view class="focus-spelling"><block wx:for="{{focusWord.glyphs}}" wx:for-item="glyph" wx:key="key">
                  <view wx:if="{{glyph.targetId}}" class="focus-cell {{glyph.done ? 'is-complete' : ''}}" data-id="{{glyph.targetId}}" bindtap="openCharacter" role="button" aria-label="{{focusWord.word}}里的{{glyph.text}}，进入字卡" hover-class="is-pressed"><text class="reader-focus-glyph">{{glyph.text}}</text><text class="focus-pinyin">{{glyph.pinyin}}</text></view>
                  <view wx:else class="focus-cell"><text class="focus-plain-glyph">{{glyph.text}}</text><text class="focus-pinyin is-empty">　</text></view>
                </block></view>
                <view wx:if="{{focusWord.done}}" class="focus-word-icon"><ki-icon name="check" size="15" /></view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="guide-finish"><view>读</view><view><text>本课识字进度</text><strong>已经认识 {{completed}} / {{total}} 个字</strong><small>完成导读后，请回到纸质课本阅读全文，再用字卡和练习巩固。</small></view><button class="press-card" data-view="words" bindtap="switchView" hover-class="is-pressed">查看生字表</button><button class="primary press-card" data-view="practice" bindtap="switchView" hover-class="is-pressed"><text>按需复习</text><ki-icon name="arrow-right" size="16" /></button></view>
    </view>
    <view class="lesson-reader-aside" aria-label="课文导读辅助">
      <view class="reader-scene-card">
        <image src="{{lessonSceneSrc}}" mode="aspectFill" />
        <view class="reader-scene-shade"></view>
        <view class="reader-scene-caption"><small>第 {{lesson.position}} 课 · 导读场景</small><strong>{{lesson.title}}</strong></view>
      </view>
      <view class="reader-progress-card">
        <view class="reader-progress-head"><view><small>本课生字</small><strong>{{completed}} / {{total}}</strong></view><i>{{percent}}%</i></view>
        <view class="reader-progress-track"><i style="width: {{percent}}%;"></i></view>
        <text>每条线索下列出本段重点词。点击彩色生字进入字卡，首次学习完成后会显示标记。</text>
      </view>
      <view class="reader-word-index">
        <view wx:for="{{characters}}" wx:key="id" class="reader-word-item press-card {{item.done ? 'is-complete' : ''}}" data-id="{{item.id}}" data-section-id="{{item.guideSectionId}}" bindtap="openIndexedCharacter" role="button" hover-class="is-pressed">
          <strong>{{item.hanzi}}</strong><view><text>{{item.pinyin}}</text><small>{{item.word}}</small></view><ki-icon name="{{item.done ? 'check' : 'arrow-right'}}" size="15" />
        </view>
      </view>
      <view class="reader-route-card"><small>学习线索</small><view><view wx:for="{{guideSections}}" wx:key="id"><i>{{index + 1}}</i><text>{{item.title}}</text></view></view></view>
    </view>
  </view>

  <view wx:elif="{{activeView === 'words'}}" class="words-panel">
    <view class="lesson-scene-banner">
      <image class="lesson-scene-image" src="{{lessonSceneSrc}}" mode="aspectFill" />
      <view class="lesson-scene-shade"></view>
      <view class="lesson-scene-copy"><text>主题场景</text><strong>{{lesson.title}}</strong><small>{{lesson.context || '先进入画面，再从词语认识汉字'}}</small></view>
    </view>
    <view class="word-map-board">
      <view class="board-title"><strong>课内识字写字表</strong><text>把官方字表放回词语，区分会认、会写与多音字</text></view>
      <view class="word-groups">
        <view wx:for="{{wordGroups}}" wx:key="key" class="word-group" wx:for-item="group">
          <text class="word-label">{{group.word}}</text>
          <view class="word-chip-row">
            <view wx:for="{{group.characters}}" wx:key="id" wx:for-item="character" class="word-chip press-card {{character.done ? 'done' : ''}}" data-id="{{character.id}}" bindtap="openCharacter" role="button" hover-class="is-pressed">
              <strong class="kai">{{character.hanzi}}</strong><text>{{character.pinyin}}</text><view wx:if="{{character.done}}" class="word-chip-status"><ki-icon name="check" size="13" /></view><i wx:else>{{character.curriculumRole === 'write' ? '写' : character.curriculumRole === 'polyphonic' ? '多' : '认'}}</i>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{extensionWordGroups.length}}" class="word-map-board extension-board">
      <view class="board-title"><strong>课文语境拓展</strong><text>保留深度字卡，不计入官方字表进度</text></view>
      <view class="word-groups">
        <view wx:for="{{extensionWordGroups}}" wx:key="key" class="word-group" wx:for-item="group">
          <text class="word-label">{{group.word}}</text>
          <view class="word-chip-row">
            <view wx:for="{{group.characters}}" wx:key="id" wx:for-item="character" class="word-chip is-extension press-card {{character.done ? 'done' : ''}}" data-id="{{character.id}}" bindtap="openCharacter" role="button" hover-class="is-pressed">
              <strong class="kai">{{character.hanzi}}</strong><text>{{character.pinyin}}</text><view wx:if="{{character.done}}" class="word-chip-status"><ki-icon name="check" size="13" /></view><i wx:else>拓</i>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="practice-panel">
    <view class="lesson-learning-path">
      <view class="learning-path-heading"><text>课文导读线索</text><view><strong>沿着三个问题，再把字放回重点词里</strong><small>回到纸质课本阅读全文，再用导读中的词语巩固本课生字</small></view></view>
      <view class="learning-step-list"><view wx:for="{{guideSections}}" wx:key="id" class="learning-step"><i>{{index + 1}}</i><text>{{item.title}}</text></view></view>
    </view>
    <view class="lesson-practice-strip">
      <view class="practice-strip-copy"><text class="practice-strip-kicker">本课复习方式</text><view class="practice-strip-title">完成单字过关后，按需要选择专项复习</view></view>
      <view class="practice-strip-items">
        <view wx:for="{{practiceItems}}" wx:key="track" class="practice-strip-item press-card" data-track="{{item.track}}" bindtap="startPractice" role="button" hover-class="is-pressed"><strong>{{item.glyph}}</strong><text>{{item.menu}}</text><small>{{item.completed}}/{{item.total}}</small></view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeView === 'guide'}}" class="reader-mobile-index {{mobileIndexOpen ? 'open' : ''}}">
    <view wx:if="{{mobileIndexOpen}}" class="reader-mobile-index-panel">
      <view class="reader-mobile-index-head"><strong>按线索认识字</strong><small>点击直接进入字卡</small></view>
      <view class="reader-word-index is-compact">
        <view wx:for="{{characters}}" wx:key="id" class="reader-word-item press-card {{item.done ? 'is-complete' : ''}}" data-id="{{item.id}}" data-section-id="{{item.guideSectionId}}" bindtap="openIndexedCharacter" role="button" hover-class="is-pressed">
          <strong>{{item.hanzi}}</strong><view><text>{{item.pinyin}}</text><small>{{item.word}}</small></view><ki-icon name="{{item.done ? 'check' : 'arrow-right'}}" size="15" />
        </view>
      </view>
    </view>
    <button class="lesson-progress-pill" bindtap="toggleMobileIndex" aria-expanded="{{mobileIndexOpen}}" hover-class="none"><view><text>本课重点字</text><strong>{{completed}}/{{total}} 已完成</strong></view><view class="lesson-chevron-down"><ki-icon name="chevron-down" size="16" /></view></button>
  </view>
  <bottom-navigation active="course" theme="{{theme}}" />
</view>
