<view class="page paper-texture">
  <view class="lesson-hero card">
    <image wx:if="{{lesson.visual.src}}" src="{{lesson.visual.src}}" mode="aspectFill" class="hero-image" />
    <view class="hero-overlay"></view>
    <view class="hero-copy">
      <text class="pill">第 {{lesson.position}} 课 · {{lesson.mode}}</text>
      <view class="hero-title">{{lesson.title}}</view>
      <view class="hero-context">{{lesson.context}}</view>
    </view>
  </view>

  <view wx:if="{{lesson.learningPath.length}}" class="section card">
    <view class="section-title">这节课怎么学</view>
    <view class="path-list"><view wx:for="{{lesson.learningPath}}" wx:key="*this" class="path-item"><text>{{index + 1}}</text><view>{{item}}</view></view></view>
  </view>

  <view class="progress-card card">
    <view><text>生字进度</text><strong>{{completed}} / {{total}}</strong></view>
    <view class="progress-track"><view class="progress-value" style="width: {{percent}}%"></view></view>
  </view>

  <view wx:if="{{loading}}" class="skeleton section"></view>
  <view wx:elif="{{error}}" class="card empty"><view>{{error}}</view><button class="secondary-button retry" bindtap="retry">重新加载</button></view>
  <view wx:else class="character-grid">
    <view wx:for="{{characters}}" wx:key="id" class="character-card card {{item.done ? 'is-done' : ''}}" data-id="{{item.id}}" bindtap="openCharacter">
      <text class="role">{{item.roleLabel}}</text>
      <view class="hanzi">{{item.hanzi}}</view>
      <view class="pinyin">{{item.pinyin}}</view>
      <view class="word">{{item.word}}</view>
      <view wx:if="{{item.done}}" class="done">✓</view>
    </view>
  </view>

  <view class="sticky-actions">
    <button class="secondary-button" bindtap="openReader">课文朗读</button>
    <button class="primary-button" bindtap="startPractice">{{completed ? '继续识字' : '开始识字'}}</button>
  </view>
</view>
