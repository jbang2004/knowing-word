.guide-question { align-items:center; padding:12px 15px; border:2px solid var(--wrong-edge); border-radius:20px; background:var(--wrong-soft); box-shadow:0 var(--press) 0 var(--wrong-edge); }
.guide-question text { color:var(--wrong-text); font-size:14px; font-weight:900; }
.guide-question view { color:var(--ink-soft); font-size:15px; font-weight:700; line-height:1.7; }
.guide-finish>view:first-child { color:var(--action-ink); font-family:var(--font-kai); }
.guide-finish button { border:2px solid var(--line); border-radius:16px; box-shadow:0 3px 0 var(--line); }
.guide-finish button.primary { border-color:var(--action-deep); color:var(--action-ink); background:var(--action); box-shadow:0 3px 0 var(--action-deep); }
