  .lesson-tabs button { min-height:58px; gap:10px; padding:8px 13px; border-radius:14px; }
  .guide-layout { display:grid; grid-template-columns:minmax(0,680px); justify-content:center; }
  .guide-paper { border-radius:30px; }
