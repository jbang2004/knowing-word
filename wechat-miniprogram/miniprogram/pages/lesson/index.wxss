/* Visual parity with the Web reader's final solid-surface cascade. */
.lesson-topbar>view { font-size:24px; }
.guide-paper { border:2px solid var(--line); background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }
.section-head i { color:var(--action-ink); font-family:var(--font-kai); }
