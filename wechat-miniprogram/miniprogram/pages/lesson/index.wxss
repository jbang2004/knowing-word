.lesson-page { min-height:100vh; padding:0 16px calc(96px + env(safe-area-inset-bottom)); color:var(--ink); background:var(--sky); }
.lesson-topbar { display:flex; align-items:center; gap:4px; box-sizing:border-box; border-bottom:1px solid var(--line); }.lesson-topbar button { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -10px; padding:0; color:var(--ink-soft); background:transparent; }.lesson-topbar>view { color:var(--navy); font-size:30px; font-weight:900; }
.lesson-tabs { position:sticky; z-index:16; top:7px; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; width:100%; margin:-4px 0 20px; padding:5px; border:2px solid var(--line); border-radius:17px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.lesson-tabs button { display:flex; min-width:0; min-height:48px; align-items:center; justify-content:center; gap:6px; margin:0; padding:6px 8px; border:2px solid var(--line); border-radius:999px; color:var(--ink-soft); background:var(--paper); box-shadow:0 3px 0 var(--line); font-size:13px; font-weight:800; transition:color 180ms ease,background-color 180ms ease,transform 90ms ease; }.lesson-tabs button.active { border-color:var(--action-deep); color:var(--action-ink); background:var(--action); box-shadow:0 3px 0 var(--action-deep); }.lesson-tabs button strong { white-space:nowrap; }
.lesson-tab-icon { position:relative; width:16px; height:16px; flex:none; color:currentColor; }
.tab-icon-guide::before { position:absolute; inset:1px 2px; border:1.8px solid currentColor; border-radius:2px; content:""; }
.tab-icon-guide::after { position:absolute; top:6px; left:6px; width:7px; border-top:1.8px solid currentColor; box-shadow:0 4px 0 currentColor; content:""; }
.tab-icon-list::before { position:absolute; top:2px; left:1px; width:3px; height:3px; border-radius:50%; background:currentColor; box-shadow:0 6px 0 currentColor,0 12px 0 currentColor; content:""; }
.tab-icon-list::after { position:absolute; top:3px; left:7px; width:10px; border-top:1.8px solid currentColor; box-shadow:0 6px 0 currentColor,0 12px 0 currentColor; content:""; }
.tab-icon-practice::before { position:absolute; top:2px; left:2px; width:5px; height:5px; border:1.7px solid currentColor; border-radius:2px; box-shadow:9px 0 0 -1.7px transparent,9px 0 0 0 currentColor,0 9px 0 -1.7px transparent,0 9px 0 0 currentColor,9px 9px 0 -1.7px transparent,9px 9px 0 0 currentColor; content:""; }
.loading-wrap,.error-wrap { padding:20px 0; }.error-wrap { color:var(--ink-soft); text-align:center; }.error-wrap button { margin-top:16px; color:var(--action-text); }
.guide-layout { margin-bottom:72px; }.guide-paper { overflow:hidden; border:1px solid var(--line); border-radius:22px; background:linear-gradient(90deg,transparent 0,transparent 24px,rgba(23,182,134,.06) 25px,transparent 26px),var(--paper); box-shadow:0 18px 52px rgba(34,47,42,.08); }
.guide-masthead { padding:37px 29px 29px; border-bottom:1px solid var(--line); text-align:center; background:linear-gradient(180deg,rgba(226,247,239,.72),transparent 82%); }.accent { width:34px; height:5px; margin:0 auto 15px; border-radius:999px; background:var(--action); }.guide-masthead>text { color:var(--action-text); font-size:11px; font-weight:900; letter-spacing:2px; }.guide-title { margin-top:13px; color:var(--navy); font-family:var(--font-serif); font-size:40px; font-weight:900; line-height:1.08; letter-spacing:2px; }.guide-dek { margin:12px auto 0; color:var(--ink-soft); font-family:var(--font-serif); font-size:13px; line-height:1.65; }.source-note { display:flex; align-items:flex-start; gap:10px; margin-top:19px; padding:9px 13px; border:1px solid var(--wrong-edge); border-radius:13px; color:var(--ink-soft); text-align:left; background:#fffaf0; }.source-note>text { color:var(--wrong-text); }.source-note>view { display:flex; flex-direction:column; gap:2px; }.source-note strong { color:var(--navy); font-size:12px; }.source-note view text { font-size:11px; line-height:1.55; }
.guide-body { padding:31px 24px calc(152px + env(safe-area-inset-bottom)); }.guide-intro { margin:1px 0 24px; padding:18px 19px 17px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }.guide-intro>text { color:var(--action-text); font-size:11px; font-weight:900; letter-spacing:2px; }.guide-intro>view { margin-top:9px; color:var(--navy); font-family:var(--font-serif); font-size:16px; font-weight:650; line-height:1.78; }.guide-intro small { display:flex; align-items:center; gap:7px; margin-top:13px; color:var(--ink-soft); font-size:11px; font-weight:700; }
.inline-book-icon { position:relative; display:block; width:15px; height:14px; flex:none; border:1.5px solid currentColor; border-radius:2px; }.inline-book-icon::after { position:absolute; top:0; bottom:0; left:6px; border-left:1px solid currentColor; content:""; }
.guide-section { padding:8px 0 28px; }.guide-section+.guide-section { padding-top:31px; border-top:1px solid var(--line); }.section-head { display:flex; align-items:center; gap:13px; margin-bottom:15px; }.section-head i { display:flex; width:35px; height:35px; flex:none; align-items:center; justify-content:center; border-radius:50% 50% 50% 8px; color:#0f1614; background:var(--action); font-family:"Knowing Kai","Kaiti SC",serif; font-style:normal; }.section-head strong { color:var(--navy); font-family:"Songti SC",serif; font-size:20px; letter-spacing:1px; }.guide-paragraph { color:var(--ink); font-family:"Songti SC",serif; font-size:16px; line-height:1.8; letter-spacing:.4px; }.guide-paragraph+.guide-paragraph { margin-top:12px; }.guide-question { display:grid; grid-template-columns:auto minmax(0,1fr); gap:11px; margin-top:17px; padding:12px 15px; border-radius:14px; background:var(--paper-soft); }.guide-question text { color:var(--wrong-text); font-size:11px; font-weight:900; }.guide-question view { color:var(--ink-soft); font-size:13px; line-height:1.6; }
.focus-area { margin-top:18px; }.focus-head { display:flex; justify-content:space-between; gap:10px; margin-bottom:12px; }.focus-head strong { color:var(--navy); font-size:12px; }.focus-head text { color:var(--ink-faint); font-size:10px; }.focus-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:var(--card-inline-gap); row-gap:var(--card-stack-gap); }.focus-word { position:relative; display:flex; width:100%; min-width:0; min-height:62px; flex-direction:column; align-items:flex-start; justify-content:center; margin:0; padding:10px 29px 10px 13px; border:1px solid var(--line); border-radius:15px; color:var(--ink); text-align:left; background:var(--paper-soft); }.focus-word.done { border-color:var(--action-edge); background:var(--action-soft); }.focus-word strong { color:var(--navy); font-size:17px; }.focus-word text { color:var(--action-text); font-size:11px; }.focus-word i { position:absolute; right:11px; top:21px; color:var(--action-text); font-style:normal; }
.guide-finish { display:grid; grid-template-columns:auto minmax(0,1fr); gap:17px; margin:10px 18px 24px; padding:18px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }.guide-finish>view:first-child { display:flex; width:44px; height:44px; align-items:center; justify-content:center; border-radius:14px 14px 14px 5px; color:#0f1614; background:var(--action); font-family:"Knowing Kai","Kaiti SC",serif; font-size:24px; }.guide-finish>view:nth-child(2) { display:flex; flex-direction:column; gap:4px; }.guide-finish view text,.guide-finish small { color:var(--ink-soft); font-size:11px; }.guide-finish view strong { color:var(--navy); }.guide-finish button { min-height:42px; margin:0; border:1px solid var(--line); border-radius:14px; color:var(--navy); background:var(--paper); font-size:13px; font-weight:900; }.guide-finish button.primary { color:#0f1614; background:var(--action); }
.words-panel,.practice-panel { padding:0; }
.lesson-scene-banner { position:relative; height:220px; margin-bottom:17px; overflow:hidden; border:1px solid var(--line); border-radius:24px; background:#112d42; box-shadow:var(--shadow-xs); }.lesson-scene-image { width:100%; height:100%; }.lesson-scene-shade { position:absolute; inset:0; background:linear-gradient(0deg,rgba(17,38,73,.86) 4%,rgba(17,38,73,.34) 42%,transparent 68%),linear-gradient(90deg,rgba(17,38,73,.5),transparent 62%); }.lesson-scene-copy { position:absolute; z-index:2; right:20px; bottom:19px; left:20px; display:flex; flex-direction:column; color:white; }.lesson-scene-copy text { color:#d7e7ff; font-size:13px; font-weight:820; letter-spacing:.12em; }.lesson-scene-copy strong { margin-top:4px; font-family:var(--font-serif); font-size:25px; }.lesson-scene-copy small { margin-top:5px; color:rgba(255,255,255,.82); font-size:13px; line-height:1.55; }
.word-map-board { padding:19px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.board-title { display:flex; flex-direction:column; gap:5px; margin-bottom:24px; }.board-title strong { color:var(--navy); font-family:var(--font-serif); font-size:25px; font-weight:850; }.board-title text { color:var(--ink-soft); font-size:13px; }.word-groups { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }.word-group { min-width:0; min-height:112px; padding:13px; }.word-label { display:block; min-height:20px; margin-bottom:12px; color:var(--ink-soft); font-size:13px; font-weight:760; }.word-chip-row { display:flex; flex-wrap:wrap; gap:8px; }.word-chip { position:relative; display:flex; width:76px; min-height:84px; flex-direction:column; align-items:center; justify-content:center; gap:5px; border:2px solid var(--line); border-radius:18px; color:var(--navy); background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.word-chip.done { border-color:var(--action-edge); color:var(--action-text); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }.word-chip strong { font-size:28px; font-weight:500; line-height:1; }.word-chip>text { color:var(--ink-faint); font-family:var(--font-round); font-size:13px; font-weight:800; }.word-chip.done>text { color:var(--action-text); }.word-chip i { position:absolute; top:-8px; right:-6px; display:flex; width:22px; height:22px; align-items:center; justify-content:center; border-radius:50%; color:var(--ink-soft); background:var(--sky-deep); font-size:12px; font-style:normal; font-weight:900; }.word-chip.done i { color:var(--action-ink); background:var(--action); box-shadow:0 2px 0 var(--action-deep); }
.word-map-board.extension-board { margin-top:17px; border-style:dashed; }.word-chip.is-extension { border-style:dashed; }
.lesson-learning-path { padding:18px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.learning-path-heading { display:flex; align-items:flex-start; gap:14px; margin-bottom:18px; }.learning-path-heading>text { flex:none; padding:7px 11px; border-radius:999px; color:var(--part-text); background:var(--part-soft); font-size:13px; font-weight:850; }.learning-path-heading>view { display:flex; min-width:0; flex-direction:column; }.learning-path-heading strong { color:var(--navy); font-family:var(--font-serif); font-size:17px; line-height:1.35; }.learning-path-heading small { margin-top:2px; color:var(--ink-soft); font-size:13px; line-height:1.55; }.learning-step-list { display:flex; flex-direction:column; gap:10px; }.learning-step { display:flex; min-height:63px; align-items:center; gap:10px; padding:11px 13px; border:1px solid var(--line); border-radius:15px; background:var(--paper-soft); }.learning-step i { display:flex; width:28px; height:28px; flex:none; align-items:center; justify-content:center; border-radius:50%; color:var(--part-ink); background:var(--part); box-shadow:0 5px 12px rgba(41,90,170,.2); font-family:var(--font-round); font-size:13px; font-style:normal; font-weight:900; }.learning-step text { color:var(--ink); font-size:13px; font-weight:720; line-height:1.5; }
.lesson-practice-strip { display:flex; flex-direction:column; align-items:stretch; gap:22px; margin-top:17px; padding:20px; border-radius:22px; color:var(--part-ink); background:var(--part); box-shadow:0 5px 0 var(--part-deep); }.practice-strip-copy { flex:1; }.practice-strip-kicker { color:inherit; font-size:12px; font-weight:900; opacity:.78; }.practice-strip-title { margin-top:5px; color:inherit; font-family:var(--font-serif); font-size:22px; font-weight:900; line-height:1.35; }.practice-strip-items { display:flex; gap:8px; width:100%; }.practice-strip-item { display:grid; min-width:0; min-height:64px; flex:1; grid-template-columns:auto auto; align-items:center; gap:0 8px; padding:8px 10px; border-radius:12px; color:white; text-align:left; background:rgba(255,255,255,.13); }.practice-strip-item strong { grid-row:span 2; font-family:var(--font-kai); font-size:22px; font-weight:500; }.practice-strip-item text { font-size:13px; font-weight:800; }.practice-strip-item small { color:rgba(255,255,255,.76); font-size:13px; }
.lesson-progress-pill { position:fixed; z-index:60; right:16px; bottom:calc(88px + env(safe-area-inset-bottom)); display:flex; width:164px; min-height:50px; align-items:center; justify-content:space-between; padding:8px 14px; border-radius:17px; color:white; background:rgba(18,60,51,.94); box-shadow:0 10px 26px rgba(18,60,51,.23); }.lesson-progress-pill>view { display:flex; flex-direction:column; }.lesson-progress-pill view text { font-size:11px; opacity:.7; }.lesson-progress-pill view strong { font-size:12px; }

/* Final solid surfaces mirror the Web reader cascade. */
.source-note { padding:13px 15px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }
.guide-intro { border-color:var(--line); background:var(--paper); }
.focus-word { min-height:62px; padding:10px 28px 10px 10px; border:2px solid var(--line); border-radius:18px; background:var(--paper); box-shadow:0 4px 0 var(--line); }
.focus-word.done { box-shadow:0 4px 0 var(--action-edge); }
@media (max-width:390px) {
  .lesson-tabs button { flex-direction:column; gap:3px; }
  .guide-masthead { padding-right:24px; padding-left:24px; }
  .guide-finish { grid-template-columns:1fr; }
}
@media (min-width:391px) {
  .guide-body { padding-right:28px; padding-left:28px; }
}
@media (min-width:421px) {
  .lesson-scene-banner { height:245px; }
  .lesson-scene-copy { right:27px; bottom:25px; left:27px; }
  .lesson-scene-copy strong { font-size:32px; }
}
@media (min-width:761px) {
  .word-map-board { padding:27px; }
  .word-groups { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .word-group { padding:17px; }
  .lesson-practice-strip { flex-direction:row; align-items:center; padding:23px 25px; }
  .practice-strip-items { width:auto; flex:none; }
  .practice-strip-item { min-width:86px; flex:none; }
}
@media (max-width:420px) {
  .word-group { min-height:0; }
  .practice-strip-items { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); }
  .practice-strip-item { grid-template-columns:1fr; place-items:center; gap:2px; padding:9px 4px; text-align:center; }
  .practice-strip-item strong { grid-row:auto; }
  .practice-strip-item small { display:none; }
}
