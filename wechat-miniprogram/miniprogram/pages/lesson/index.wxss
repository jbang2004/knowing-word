.lesson-page { min-height:100vh; padding:0 16px calc(112px + env(safe-area-inset-bottom)); color:var(--ink); background:var(--sky); }
.lesson-topbar { display:flex; align-items:center; gap:4px; box-sizing:border-box; border-bottom:1px solid var(--line); }.lesson-topbar button { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -10px; padding:0; color:var(--ink-soft); background:transparent; }.lesson-topbar>view { color:var(--navy); font-size:30px; font-weight:900; }
.lesson-tabs { position:sticky; z-index:16; top:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; width:100%; margin:20px 0; padding:5px; border:2px solid var(--line); border-radius:17px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.lesson-tabs button { display:flex; min-width:0; min-height:48px; align-items:center; justify-content:center; gap:6px; margin:0; padding:6px 8px; border-radius:12px; color:var(--ink-soft); background:transparent; font-size:13px; }.lesson-tabs button.active { color:#fffaf2; background:var(--navy); box-shadow:0 8px 18px rgba(18,60,51,.18); }.lesson-tabs button strong { white-space:nowrap; }
.lesson-tab-icon { position:relative; width:18px; height:18px; flex:none; color:currentColor; }
.tab-icon-guide::before { position:absolute; inset:1px 2px; border:1.8px solid currentColor; border-radius:2px; content:""; }
.tab-icon-guide::after { position:absolute; top:6px; left:6px; width:7px; border-top:1.8px solid currentColor; box-shadow:0 4px 0 currentColor; content:""; }
.tab-icon-list::before { position:absolute; top:2px; left:1px; width:3px; height:3px; border-radius:50%; background:currentColor; box-shadow:0 6px 0 currentColor,0 12px 0 currentColor; content:""; }
.tab-icon-list::after { position:absolute; top:3px; left:7px; width:10px; border-top:1.8px solid currentColor; box-shadow:0 6px 0 currentColor,0 12px 0 currentColor; content:""; }
.tab-icon-practice::before { position:absolute; top:2px; left:2px; width:5px; height:5px; border:1.7px solid currentColor; border-radius:2px; box-shadow:9px 0 0 -1.7px transparent,9px 0 0 0 currentColor,0 9px 0 -1.7px transparent,0 9px 0 0 currentColor,9px 9px 0 -1.7px transparent,9px 9px 0 0 currentColor; content:""; }
.loading-wrap,.error-wrap { padding:20px 0; }.error-wrap { color:var(--ink-soft); text-align:center; }.error-wrap button { margin-top:16px; color:var(--action-text); }
.guide-layout { margin-bottom:72px; }.guide-paper { overflow:hidden; border:1px solid var(--line); border-radius:24px; background:linear-gradient(90deg,transparent 0,transparent 24px,rgba(23,182,134,.06) 25px,transparent 26px),var(--paper); box-shadow:0 18px 52px rgba(34,47,42,.08); }
.guide-masthead { padding:37px 29px 29px; border-bottom:1px solid var(--line); text-align:center; background:linear-gradient(180deg,rgba(226,247,239,.72),transparent 82%); }.accent { width:34px; height:5px; margin:0 auto 15px; border-radius:999px; background:var(--action); }.guide-masthead>text { color:var(--action-text); font-size:11px; font-weight:900; letter-spacing:2px; }.guide-title { margin-top:13px; color:var(--navy); font-family:var(--font-serif); font-size:40px; font-weight:900; line-height:1.08; letter-spacing:2px; }.guide-dek { margin:12px auto 0; color:var(--ink-soft); font-family:var(--font-serif); font-size:13px; line-height:1.65; }.source-note { display:flex; align-items:flex-start; gap:10px; margin-top:19px; padding:9px 13px; border:1px solid var(--wrong-edge); border-radius:13px; color:var(--ink-soft); text-align:left; background:#fffaf0; }.source-note>text { color:var(--wrong-text); }.source-note>view { display:flex; flex-direction:column; gap:2px; }.source-note strong { color:var(--navy); font-size:12px; }.source-note view text { font-size:11px; line-height:1.55; }
.guide-body { padding:31px 28px calc(90px + env(safe-area-inset-bottom)); }.guide-intro { margin:1px 0 24px; padding:18px 19px 17px; border:1px solid var(--action-edge); border-radius:18px 18px 18px 6px; background:rgba(226,247,239,.55); }.guide-intro>text { color:var(--action-text); font-size:11px; font-weight:900; letter-spacing:2px; }.guide-intro>view { margin-top:9px; color:var(--navy); font-family:var(--font-serif); font-size:16px; font-weight:650; line-height:1.78; }.guide-intro small { display:flex; align-items:center; gap:7px; margin-top:13px; color:var(--ink-soft); font-size:11px; font-weight:700; }
.inline-book-icon { position:relative; display:block; width:15px; height:14px; flex:none; border:1.5px solid currentColor; border-radius:2px; }.inline-book-icon::after { position:absolute; top:0; bottom:0; left:6px; border-left:1px solid currentColor; content:""; }
.guide-section { padding:8px 0 28px; }.guide-section+.guide-section { padding-top:31px; border-top:1px solid var(--line); }.section-head { display:flex; align-items:center; gap:13px; margin-bottom:15px; }.section-head i { display:flex; width:35px; height:35px; flex:none; align-items:center; justify-content:center; border-radius:50% 50% 50% 8px; color:#0f1614; background:var(--action); font-family:"Knowing Kai","Kaiti SC",serif; font-style:normal; }.section-head strong { color:var(--navy); font-family:"Songti SC",serif; font-size:20px; letter-spacing:1px; }.guide-paragraph { color:var(--ink); font-family:"Songti SC",serif; font-size:16px; line-height:1.8; letter-spacing:.4px; }.guide-paragraph+.guide-paragraph { margin-top:12px; }.guide-question { display:grid; grid-template-columns:auto minmax(0,1fr); gap:11px; margin-top:17px; padding:12px 15px; border-radius:14px; background:var(--paper-soft); }.guide-question text { color:var(--wrong-text); font-size:11px; font-weight:900; }.guide-question view { color:var(--ink-soft); font-size:13px; line-height:1.6; }
.focus-area { margin-top:18px; }.focus-head { display:flex; justify-content:space-between; gap:10px; margin-bottom:12px; }.focus-head strong { color:var(--navy); font-size:12px; }.focus-head text { color:var(--ink-faint); font-size:10px; }.focus-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:var(--card-inline-gap); row-gap:var(--card-stack-gap); }.focus-word { position:relative; display:flex; width:100%; min-width:0; min-height:62px; flex-direction:column; align-items:flex-start; justify-content:center; margin:0; padding:10px 29px 10px 13px; border:1px solid var(--line); border-radius:15px; color:var(--ink); text-align:left; background:var(--paper-soft); }.focus-word.done { border-color:var(--action-edge); background:var(--action-soft); }.focus-word strong { color:var(--navy); font-size:17px; }.focus-word text { color:var(--action-text); font-size:11px; }.focus-word i { position:absolute; right:11px; top:21px; color:var(--action-text); font-style:normal; }
.guide-finish { display:grid; grid-template-columns:auto minmax(0,1fr); gap:13px; margin:10px 18px 24px; padding:18px; border:1px solid var(--line); border-radius:20px; background:var(--paper-soft); }.guide-finish>view:first-child { display:flex; width:44px; height:44px; align-items:center; justify-content:center; border-radius:14px 14px 14px 5px; color:#0f1614; background:var(--action); font-family:"Knowing Kai","Kaiti SC",serif; font-size:24px; }.guide-finish>view:nth-child(2) { display:flex; flex-direction:column; gap:4px; }.guide-finish view text,.guide-finish small { color:var(--ink-soft); font-size:11px; }.guide-finish view strong { color:var(--navy); }.guide-finish button { min-height:42px; margin:0; border:1px solid var(--line); border-radius:14px; color:var(--navy); background:white; font-size:13px; font-weight:900; }.guide-finish button.primary { color:#0f1614; background:var(--action); }
.words-panel,.practice-panel { padding:5px 0 70px; }.panel-kicker { color:var(--radical-text); font-size:11px; font-weight:900; letter-spacing:2px; }.panel-title { margin-top:6px; color:var(--navy); font-size:29px; font-weight:900; line-height:1.25; }.panel-copy { margin-top:9px; color:var(--ink-soft); font-size:13px; line-height:1.65; }.character-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:var(--card-inline-gap); row-gap:var(--card-stack-gap); margin-top:22px; }.character-card { position:relative; display:flex; width:100%; min-width:0; min-height:116px; flex-direction:column; align-items:flex-start; margin:0; padding:14px; border:2px solid var(--line); border-radius:20px; text-align:left; background:white; box-shadow:0 4px 0 var(--line); }.character-card.done { border-color:var(--action-edge); background:var(--action-soft); box-shadow:0 4px 0 var(--action-edge); }.character-card>text { color:var(--wrong-text); font-size:10px; }.character-card>strong { margin-top:4px; color:var(--navy); font-family:"Knowing Kai","Kaiti SC",serif; font-size:35px; }.character-card>small { color:var(--ink-soft); font-size:11px; }.character-card>i { position:absolute; right:13px; top:48px; color:var(--action-text); font-style:normal; }
.practice-route { display:flex; width:100%; min-height:86px; align-items:center; gap:14px; margin:14px 0 0; padding:15px; border:2px solid var(--line); border-radius:20px; color:var(--ink); text-align:left; background:white; box-shadow:0 4px 0 var(--line); }.practice-route>i { display:flex; width:48px; height:48px; flex:none; align-items:center; justify-content:center; border-radius:15px 15px 15px 5px; font-style:normal; font-weight:900; }.practice-route.action>i { color:var(--action-text); background:var(--action-soft); }.practice-route.part>i { color:var(--part-text); background:var(--part-soft); }.practice-route.radical>i { color:var(--radical-text); background:var(--radical-soft); }.practice-route.wrong>i { color:var(--wrong-text); background:var(--wrong-soft); }.practice-route>view { display:flex; min-width:0; flex:1; flex-direction:column; }.practice-route strong { color:var(--navy); }.practice-route view text { margin-top:4px; color:var(--ink-soft); font-size:12px; }
.lesson-progress-pill { position:fixed; z-index:40; right:16px; bottom:calc(84px + env(safe-area-inset-bottom)); display:flex; width:176px; min-height:54px; align-items:center; justify-content:space-between; padding:10px 15px; border-radius:17px; color:white; background:rgba(18,60,51,.94); box-shadow:0 10px 26px rgba(18,60,51,.23); }.lesson-progress-pill>view { display:flex; flex-direction:column; }.lesson-progress-pill view text { font-size:11px; opacity:.7; }.lesson-progress-pill view strong { font-size:12px; }
.lesson-bottom-nav { position:fixed; z-index:50; right:0; bottom:0; left:0; display:grid; grid-template-columns:repeat(4,1fr); height:calc(72px + env(safe-area-inset-bottom)); padding-bottom:env(safe-area-inset-bottom); border-top:2px solid var(--line); background:white; }.nav-item { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; color:var(--ink-faint); font-size:13px; font-weight:800; }.nav-item.active { color:var(--action-text); }.nav-icon { position:relative; width:26px; height:26px; }.icon-home::before { position:absolute; left:5px; top:3px; width:15px; height:15px; border-top:2px solid currentColor; border-left:2px solid currentColor; transform:rotate(45deg); content:""; }.icon-home::after { position:absolute; left:6px; bottom:2px; width:14px; height:14px; border:2px solid currentColor; border-top:0; content:""; }.icon-book::before,.icon-book::after { position:absolute; top:4px; width:10px; height:18px; border:2px solid currentColor; content:""; }.icon-book::before { left:2px; border-radius:4px 1px 1px 4px; }.icon-book::after { right:2px; border-radius:1px 4px 4px 1px; }.icon-grid::before { position:absolute; left:3px; top:3px; width:7px; height:7px; border:2px solid currentColor; border-radius:2px; box-shadow:13px 0 0 -2px white,13px 0 0 0 currentColor,0 13px 0 -2px white,0 13px 0 0 currentColor,13px 13px 0 -2px white,13px 13px 0 0 currentColor; content:""; }.icon-person::before { position:absolute; left:8px; top:2px; width:9px; height:9px; border:2px solid currentColor; border-radius:50%; content:""; }.icon-person::after { position:absolute; left:4px; bottom:1px; width:17px; height:12px; border:2px solid currentColor; border-bottom:0; border-radius:12px 12px 0 0; content:""; }

/* The Web reader uses white editorial surfaces on phone screens. */
.source-note { border-color:var(--line); background:white; }
.guide-intro { border-color:var(--line); background:white; }
.focus-word { min-height:66px; padding:10px 28px 10px 12px; border:2px solid var(--line); border-radius:18px; background:white; box-shadow:0 4px 0 var(--line); }
.focus-word.done { box-shadow:0 4px 0 var(--action-edge); }
