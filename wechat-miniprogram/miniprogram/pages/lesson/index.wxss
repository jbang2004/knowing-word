.lesson-hero { position: relative; min-height: 420rpx; overflow: hidden; background: #3f4e46; }
.hero-image,.hero-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }.hero-overlay { background: linear-gradient(0deg,rgba(28,30,26,.9),rgba(28,30,26,.08)); }
.hero-copy { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: 420rpx; padding: 34rpx; color: white; }.hero-copy .pill { align-self: flex-start; color: #4b3527; background: rgba(255,247,228,.92); }
.hero-title { margin-top: 18rpx; font-family: "Songti SC",serif; font-size: 60rpx; font-weight: 700; }.hero-context { margin-top: 10rpx; line-height: 1.65; color: rgba(255,255,255,.86); }
.path-list { display: flex; flex-direction: column; gap: 18rpx; margin-top: 22rpx; }.path-item { display: flex; align-items: flex-start; gap: 18rpx; line-height: 1.6; }.path-item text { flex: none; display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; color: white; background: #a6472b; font-size: 21rpx; }
.progress-card { margin-top: 20rpx; padding: 24rpx 28rpx; }.progress-card>view:first-child { display: flex; justify-content: space-between; margin-bottom: 16rpx; }.progress-card strong { font-family: Georgia,serif; }
.character-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; margin-top: 24rpx; padding-bottom: 124rpx; }.character-card { position: relative; min-height: 230rpx; padding: 20rpx 12rpx; text-align: center; }.character-card.is-done { border-color: rgba(85,115,92,.38); background: #f2f7ef; }
.role { display: inline-block; padding: 5rpx 12rpx; border-radius: 99rpx; color: #806a3c; background: #f2ead7; font-size: 18rpx; }.hanzi { margin-top: 10rpx; font-family: "Songti SC",serif; font-size: 62rpx; }.pinyin { color: #a6472b; font-size: 20rpx; }.word { margin-top: 7rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 22rpx; }.done { position: absolute; top: 12rpx; right: 12rpx; color: #55735c; font-weight: 700; }
.retry { margin-top: 22rpx; }.sticky-actions { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; display: flex; gap: 16rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid rgba(77,67,47,.12); background: rgba(255,253,247,.96); }.sticky-actions button { flex: 1; }
