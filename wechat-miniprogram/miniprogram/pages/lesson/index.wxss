/* Final solid surfaces mirror the Web reader cascade. */
.source-note { padding:13px 15px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }
.guide-intro { border-color:var(--line); background:var(--paper); }
