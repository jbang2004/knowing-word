.practice-hub-page { min-height:100vh; padding-right:14px; padding-bottom:calc(104px + env(safe-area-inset-bottom)); padding-left:14px; }
.page-heading { margin-bottom:14px; padding-bottom:16px; border-bottom:1px solid var(--line); }.heading-title { color:var(--navy); font-size:28px; font-weight:900; line-height:1.24; }
.context-band { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:14px; padding:22px; border:2px solid var(--line); border-radius:20px; background:white; box-shadow:0 3px 0 var(--line-deep); }.context-band>view:first-child { min-width:0; flex:1; }.context-band>view:first-child>text { color:var(--action-text); font-size:12px; font-weight:900; letter-spacing:.12em; }.context-title { margin-top:6px; color:var(--navy); font-size:24px; font-weight:900; line-height:1.35; }.context-copy { margin-top:8px; color:var(--ink-soft); font-size:13px; line-height:1.65; }.context-band button { width:fit-content; min-height:48px; margin:14px 0 0; padding:11px 18px; border-radius:14px; color:#0f1614; background:var(--action); font-size:14px; font-weight:900; }.context-glyph { display:flex; width:66px; height:66px; flex:none; align-items:center; justify-content:center; border-radius:18px; color:var(--action-text); background:var(--action-soft); font-family:"Knowing Kai","Kaiti SC",serif; font-size:36px; }
.route-grid { display:grid; gap:16px; }.route-card { --route-text:var(--part-text); --route-soft:var(--part-soft); display:flex; flex-direction:column; padding:23px; border:2px solid var(--line); border-radius:22px; background:white; box-shadow:0 4px 0 var(--line); }.route-card.action { --route-text:var(--action-text); --route-soft:var(--action-soft); }.route-card.wrong { --route-text:var(--wrong-text); --route-soft:var(--wrong-soft); }.route-card.radical { --route-text:var(--radical-text); --route-soft:var(--radical-soft); }.route-top { display:flex; align-items:center; gap:14px; }.route-top>view:nth-child(2) { display:flex; min-width:0; flex:1; flex-direction:column; }.route-top>view:nth-child(2)>text { margin-bottom:3px; color:var(--route-text); font-size:12px; font-weight:800; }.route-top strong { color:var(--navy); font-size:21px; }.route-top>text { color:var(--ink-faint); font-size:12px; font-weight:800; letter-spacing:.12em; }.route-glyph { display:flex; width:52px; height:52px; flex:none; align-items:center; justify-content:center; border-radius:16px; color:var(--route-text); background:var(--route-soft); font-family:"Knowing Kai","Kaiti SC",serif; font-size:21px; }.route-progress { display:flex; gap:15px; margin-top:12px; color:var(--ink-soft); font-size:12px; font-weight:700; }.route-actions { display:flex; align-items:center; gap:15px; margin-top:16px; }.route-actions button { min-height:48px; margin:0; padding:11px 18px; border:2px solid var(--line); border-radius:14px; color:var(--navy); background:white; box-shadow:0 4px 0 var(--line); font-size:14px; font-weight:900; }.route-card.action .route-actions button { border-color:var(--action-edge); color:var(--action-text); background:var(--action-soft); box-shadow:0 4px 0 var(--action-edge); }.route-actions text { color:var(--ink-soft); font-size:14px; font-weight:800; }
.sequence-note { display:grid; grid-template-columns:auto minmax(0,1fr); align-items:center; gap:19px; margin-top:16px; padding:23px; }.spark { display:flex; width:44px; height:44px; align-items:center; justify-content:center; border-radius:14px 14px 14px 5px; color:#301f00; background:var(--wrong); box-shadow:0 3px 0 var(--wrong-deep); }.sequence-note>view:nth-child(2) { display:flex; flex-direction:column; }.sequence-note>view:nth-child(2) text { color:var(--radical-text); font-size:11px; font-weight:900; letter-spacing:.17em; }.sequence-note strong { margin-top:4px; color:var(--navy); font-size:19px; }.sequence { grid-column:1/-1; color:var(--ink-soft); font-size:13px; line-height:1.8; }.sequence-note button { grid-column:1/-1; justify-self:start; min-height:42px; margin:0; padding:9px 13px; border:2px solid var(--line); border-radius:999px; color:var(--ink); background:white; box-shadow:0 3px 0 var(--line); font-size:13px; font-weight:900; }
