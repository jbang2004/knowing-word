.practice-hub-page { min-height:100vh; padding-right:var(--page-gutter); padding-bottom:calc(96px + env(safe-area-inset-bottom)); padding-left:var(--page-gutter); }
.page-heading { display:flex; min-height:54px; align-items:center; margin-bottom:14px; padding:0; border:0; }.heading-title { color:var(--navy); font-size:24px; font-weight:900; line-height:1.25; }
.context-band { display:flex; align-items:flex-start; justify-content:space-between; gap:32px; margin-bottom:14px; padding:22px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.context-band>view:first-child { min-width:0; flex:1; }.context-band>view:first-child>text { color:var(--action-text); font-size:12px; font-weight:900; letter-spacing:.12em; }.context-title { margin-top:6px; color:var(--navy); font-family:var(--font-serif); font-size:24px; font-weight:900; line-height:1.35; }.context-copy { margin-top:8px; color:var(--ink-soft); font-size:13px; line-height:1.65; }.context-band button { width:fit-content; min-height:48px; margin:14px 0 0; padding:11px 18px; border-radius:14px; color:var(--action-ink); background:var(--action); box-shadow:0 var(--press) 0 var(--action-deep); font-size:14px; font-weight:900; }.context-glyph { display:flex; width:66px; height:66px; flex:none; align-items:center; justify-content:center; border-radius:18px; color:var(--action-text); background:var(--action-soft); font-family:var(--font-kai); font-size:36px; }
.route-grid { display:grid; gap:16px; }.route-card { --route-text:var(--part-text); --route-soft:var(--part-soft); display:flex; flex-direction:column; padding:23px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 var(--press) 0 var(--line); }.route-card.action { --route-text:var(--action-text); --route-soft:var(--action-soft); }.route-card.wrong { --route-text:var(--wrong-text); --route-soft:var(--wrong-soft); }.route-card.radical { --route-text:var(--radical-text); --route-soft:var(--radical-soft); }.route-top { display:flex; align-items:center; gap:14px; }.route-top>view:nth-child(2) { display:flex; min-width:0; flex:1; flex-direction:column; }.route-top>view:nth-child(2)>text { margin-bottom:3px; color:var(--route-text); font-size:12px; font-weight:800; }.route-top strong { color:var(--navy); font-family:var(--font-serif); font-size:21px; }.route-top>text { color:var(--ink-faint); font-size:12px; font-weight:800; letter-spacing:.12em; }.route-glyph { display:flex; width:52px; height:52px; flex:none; align-items:center; justify-content:center; border-radius:16px; color:var(--route-text); background:var(--route-soft); font-family:var(--font-kai); font-size:21px; }.route-progress { display:flex; gap:15px; margin-top:12px; color:var(--ink-soft); font-size:12px; font-weight:700; }.route-actions { display:flex; align-items:center; gap:15px; margin-top:16px; }.route-actions button { min-height:48px; margin:0; padding:11px 18px; border:2px solid var(--line); border-radius:14px; color:var(--navy); background:var(--paper); box-shadow:0 var(--press) 0 var(--line); font-size:14px; font-weight:900; }.route-card.action .route-actions button { border-color:var(--action-edge); color:var(--action-text); background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); }.route-actions text { color:var(--ink-soft); font-size:14px; font-weight:800; }
.sequence-note { display:grid; grid-template-columns:auto minmax(0,1fr); align-items:center; gap:19px; margin-top:16px; padding:23px; border:2px solid var(--line); border-radius:22px; background:var(--paper); box-shadow:0 4px 0 var(--line); }.spark { display:flex; width:44px; height:44px; align-items:center; justify-content:center; border-radius:14px 14px 14px 5px; color:var(--wrong-ink); background:var(--wrong); box-shadow:0 3px 0 var(--wrong-deep); }.hub-spark-icon { position:relative; width:20px; height:20px; }.hub-spark-icon::before { position:absolute; top:2px; left:5px; width:8px; height:8px; border:2px solid currentColor; content:""; transform:rotate(45deg); }.hub-spark-icon::after { position:absolute; right:0; bottom:1px; width:5px; height:5px; border:1.5px solid currentColor; content:""; transform:rotate(45deg); }.sequence-note>view:nth-child(2) { display:flex; flex-direction:column; }.sequence-note>view:nth-child(2) text { color:var(--radical-text); font-size:11px; font-weight:900; letter-spacing:.17em; }.sequence-note strong { margin-top:4px; color:var(--navy); font-family:var(--font-serif); font-size:19px; }.sequence { grid-column:1/-1; color:var(--ink-soft); font-size:13px; line-height:1.8; }.sequence-note button { grid-column:1/-1; justify-self:start; min-height:42px; margin:0; padding:9px 13px; border:2px solid var(--line); border-radius:999px; color:var(--ink); background:var(--paper); box-shadow:var(--shadow); font-size:13px; font-weight:900; }

@media (min-width:761px) {
  .context-band { align-items:center; padding:18px 20px; }
  .context-glyph { width:64px; height:64px; font-size:34px; }
  .route-card { padding:18px; }
  .sequence-note { grid-template-columns:auto minmax(0,1fr) auto auto; padding:18px; }
  .sequence,.sequence-note button { grid-column:auto; }
}
@media (min-width:981px) { .route-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
.context-band button,.route-actions button { display:flex; align-items:center; justify-content:center; gap:5px; }
.sequence { display:flex; flex-wrap:wrap; align-items:center; gap:4px 7px; }
.sequence .ui-icon { width:13px; height:13px; opacity:.72; }
