<view class="study-shell theme-{{theme}} {{narrationOpen ? 'is-listening' : ''}}">
  <view class="study-topbar" style="height: {{navHeight}}px; padding-top: {{navTop}}px; padding-right: {{capsuleInset}}px;">
    <button class="nav-back" bindtap="goBack" aria-label="返回"><ki-icon name="arrow-left" size="22" /></button>
    <view class="breadcrumb"><text>{{character.lessonTitle}}</text><i></i><text>{{character.word}}</text></view>
    <button class="favorite {{favorite ? 'active' : ''}}" bindtap="toggleFavorite" aria-label="{{favorite ? '取消收藏' : '收藏'}}"><ki-icon name="{{favorite ? 'star-filled' : 'star'}}" size="21" /></button>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap"><view class="skeleton"></view></view>
  <view wx:elif="{{error}}" class="error-wrap"><view>{{error}}</view><button bindtap="retry">重新加载</button></view>
  <view wx:elif="{{character}}" class="study-body">
    <view class="study-scene" style="width: {{sceneSize}}px; height: {{sceneSize}}px;">
      <image wx:if="{{character.media.visual}}" src="{{character.media.visual.src}}" mode="aspectFit" />
      <view wx:else class="scene-fallback">{{character.hanzi}}</view>
      <view class="scene-fade"></view>
      <view class="scene-caption"><ki-icon name="star" size="18" /><text>画面本身就是字形</text></view>
    </view>

    <view class="study-furniture">
      <view class="study-identity">
        <view class="study-glyph">{{character.hanzi}}</view>
        <view class="identity-copy">
          <view class="reading"><strong>{{character.pinyin}}</strong><button bindtap="playCharacterPronunciation" aria-label="朗读{{character.hanzi}}"><ki-icon name="{{pronouncing ? 'stop-circle' : 'sound'}}" size="19" /></button></view>
          <view class="tags"><text class="role">{{character.curriculumRole === 'write' ? '课内会写' : character.curriculumRole === 'recognize' ? '课内会认' : '拓展学习'}}</text><text>{{character.charType}}</text><text>{{character.decomposition}}</text></view>
        </view>
      </view>
      <view class="study-meaning">本课词语「{{character.word}}」：{{character.originalMeaning}}</view>

      <view class="study-launch">
        <view wx:if="{{!narrationOpen}}" class="listen-button press-card" bindtap="playNarration" role="button" hover-class="is-pressed"><view class="equalizer {{playing ? 'playing' : ''}}"><i></i><i></i><i></i><i></i><i></i></view><view><strong>{{narrationLaunchLabel}}</strong><text>{{character.media.narration.transcript.length}} 字 · 留在画面边看边听</text></view><ki-icon class="listen-arrow" name="arrow-right" size="19" /></view>
        <view wx:else class="narration-player {{playing ? 'is-playing' : ''}} {{narrationFinished ? 'is-finished' : ''}}">
          <view class="narration-head"><view><strong>{{character.hanzi}} · {{character.pinyin}}</strong><text>{{narrationStatus}}</text></view><button bindtap="collapseNarration" aria-label="收起字义讲解"><ki-icon name="chevron-down" size="18" /></button></view>
          <view class="narration-phrase">{{narrationPhrase || character.media.narration.transcript}}</view>
          <view class="narration-progress"><i style="width: {{narrationProgress}}%"></i></view>
          <view class="narration-time"><text>{{narrationElapsed}}</text><text>{{narrationDuration}}</text></view>
          <view class="narration-actions">
            <button bindtap="previousNarrationPhrase"><ki-icon name="replay" size="18" /><text>上一句</text></button>
            <button class="is-primary" bindtap="playNarration"><ki-icon name="{{playing ? 'stop-circle' : 'sound'}}" size="18" /><text>{{playing ? '暂停' : narrationFinished ? '重听' : '继续'}}</text></button>
            <button bindtap="openTranscript"><ki-icon name="book-open" size="18" /><text>逐字稿</text></button>
            <button class="is-record" bindtap="openReader"><ki-icon name="microphone" size="18" /><text>我来读</text></button>
          </view>
          <button wx:if="{{narrationFinished}}" class="narration-next" bindtap="openMemory"><text>跟着画面找部件</text><ki-icon name="arrow-right" size="16" /></button>
        </view>
        <view class="action-wide press-card" bindtap="openMemory" role="button" hover-class="is-pressed"><ki-icon name="star" size="18" /><view><strong>物象四步</strong><text>看意象 · 找部首 · 找部件 · 合成字</text></view><ki-icon name="chevron-right" size="16" /></view>
        <view class="action-grid">
          <view class="action primary press-card" bindtap="startPractice" role="button" hover-class="is-pressed"><ki-icon name="assignment-check" size="18" /><view><strong>{{masteryActionLabel}}</strong><text>{{masteryCompleted}} / {{masteryCount}} 题</text></view></view>
          <view class="action press-card" bindtap="openReader" role="button" hover-class="is-pressed"><ki-icon name="microphone" size="18" /><view><strong>朗读录音</strong><text>读一遍本课词语</text></view></view>
        </view>
        <button class="detail-handle" bindtap="openDrawer"><text>部件来历、字形演变与语境</text><ki-icon name="chevron-right" size="16" /></button>
      </view>
    </view>
  </view>

  <block wx:if="{{character}}">
    <view wx:if="{{transcriptOpen}}" class="transcript-backdrop" bindtap="closeTranscript"></view>
    <view wx:if="{{transcriptOpen}}" class="transcript-sheet" role="dialog">
      <view class="transcript-head"><view><text>可选辅助 · 不影响字画页</text><strong>{{character.hanzi}}的逐字稿</strong></view><button bindtap="closeTranscript"><ki-icon name="chevron-down" size="18" /></button></view>
      <scroll-view scroll-y class="transcript-text">
        <block wx:if="{{narrationTokens.length}}"><view class="transcript-token-flow"><view wx:for="{{narrationTokens}}" wx:key="key" class="narration-unit {{item.phraseClass}}"><text class="narration-token {{item.state}} {{item.phraseClass}}">{{item.text}}</text><text wx:if="{{item.punctuation}}" class="narration-token is-punctuation {{item.punctuationState}} {{item.phraseClass}}">{{item.punctuation}}</text></view></view></block>
        <block wx:else>{{character.media.narration.transcript}}</block>
      </scroll-view>
      <button class="transcript-close" bindtap="closeTranscript">收起逐字稿</button>
    </view>

    <view wx:if="{{memoryOpen}}" class="memory-stage stage-{{memoryStage}} {{memoryLayout}} {{memoryFocusOrder}}" bindtouchstart="startMemorySwipe" bindtouchend="endMemorySwipe">
      <view class="memory-stage-progress"><i wx:for="{{memoryLabels}}" wx:key="*this" class="{{index < memoryStage ? 'is-past' : index === memoryStage ? 'is-current' : ''}}"></i></view>
      <view class="memory-stage-bar"><button bindtap="previousMemoryStage"><ki-icon name="arrow-left" size="20" /></button><text>物象四步 · {{character.hanzi}}</text><button bindtap="closeMemory"><ki-icon name="close" size="20" /></button></view>
      <view class="memory-stage-content {{memoryMotion}}">
        <block wx:if="{{memoryStage < 3}}">
          <view class="memory-stage-scene" style="width: {{memorySceneSize}}px; height: {{memorySceneSize}}px;"><image src="{{character.media.visual.src}}" mode="aspectFit" /><view wx:if="{{memoryStage > 0}}" class="memory-focus"></view><view wx:if="{{memoryStage > 0}}" class="memory-focus-ring"></view></view>
          <view class="memory-stage-copy"><view class="memory-stage-eyebrow"><b>{{memoryStage + 1}}</b><text>{{memoryEyebrow}}</text></view><strong>{{memoryTitle}}</strong><text>{{memoryBody}}</text></view>
        </block>
        <block wx:else>
          <view class="memory-stage-recall"><image src="{{character.media.visual.src}}" mode="aspectFit" /><view><strong>图片先收起来了</strong><text>能离开画面想起字形，才算记住</text></view><button bindtap="replayMemoryImage">再看图</button></view>
          <view class="memory-stage-equation"><view class="memory-stage-parts {{memoryPartsBeside ? 'is-beside' : ''}}"><text wx:for="{{character.parts}}" wx:key="index" class="{{item.radical ? 'is-radical' : 'is-component'}}">{{item.char}}</text></view><view class="memory-arrow"><ki-icon name="arrow-right" size="24" /></view><strong class="memory-stage-result">{{character.hanzi}}</strong></view>
          <view class="memory-stage-legend"><text><i class="radical-dot"></i>表意部首</text><text><i class="part-dot"></i>形音部件</text><text>{{character.decomposition}}</text></view>
          <view class="memory-stage-copy final-copy"><text>{{memoryBody}}</text></view>
        </block>
      </view>
      <view class="memory-stage-spacer"></view>
      <view class="memory-stage-foot">
        <view wx:if="{{memoryStage < 3}}" class="memory-stage-chips"><button wx:for="{{memoryParts}}" wx:key="index" class="{{item.radical ? 'is-radical' : 'is-component'}} {{item.activeClass}}" data-glyph="{{item.char}}" bindtap="openComponent"><text>{{item.char}}</text><view><strong>{{item.radical ? '表意部首' : '形音部件'}}</strong><small>{{item.status}}</small></view></button></view>
        <button wx:if="{{memoryStage < 3}}" class="memory-stage-next" bindtap="nextMemoryStage"><text>看下一步</text><ki-icon name="arrow-right" size="17" /></button>
        <text wx:if="{{memoryStage < 3}}" class="memory-stage-hint">左右滑动也可以切换四步</text>
        <button wx:else class="memory-stage-next is-finish" bindtap="finishMemory"><text>记住线索，去练一练</text><ki-icon name="arrow-right" size="17" /></button>
        <button wx:if="{{memoryStage === 3}}" class="memory-stage-secondary" bindtap="closeMemory">回到这个字</button>
      </view>
    </view>

    <view wx:if="{{drawerOpen}}" class="drawer-backdrop" bindtap="closeDrawer" catchtouchmove></view>
    <view class="details {{drawerOpen ? 'open' : ''}}">
      <view class="drawer-grip" bindtap="closeDrawer"></view>
      <view class="drawer-title">部件来历</view>
      <view class="part-list">
        <view wx:for="{{character.parts}}" wx:key="char" class="part {{item.radical ? 'radical' : 'component'}}" data-glyph="{{item.char}}" bindtap="openComponent">
          <view class="part-glyph {{item.radical ? 'radical' : ''}}">{{item.char}}</view>
          <view><strong>{{item.char}} · {{item.radical ? '表意部首' : '形音部件'}}</strong><text>{{item.functionText || '点开去部件馆查看更多例字'}}</text></view>
        </view>
      </view>
      <view class="drawer-title">字形演变</view>
      <view class="drawer-note"><ki-icon name="history" size="19" /><view><strong>本字暂无可靠的古文字图版</strong><text>保留现代楷书，不虚构演变形态。</text></view></view>
      <view class="drawer-title">本课主题语境</view>
      <view class="drawer-theme">{{character.originalText || character.originalMeaning}}</view>
    </view>
  </block>
</view>
