/* Character study mirrors the Web immersive card at phone width. */
.study-shell { position:relative; display:flex; width:100%; min-height:100vh; flex-direction:column; overflow-x:hidden; overflow-y:visible; color:var(--ink); background:var(--sky); }
.study-topbar { display:flex; width:100%; align-items:center; justify-content:space-between; gap:8px; padding-left:12px; box-sizing:border-box; }
.study-topbar button { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0; padding:0; border-radius:50%; color:var(--ink); background:transparent; font-size:30px; line-height:1; }
.study-topbar .favorite { font-size:27px; }.study-topbar .favorite.active { color:var(--wrong); }
.breadcrumb { display:flex; min-width:0; flex:1; align-items:center; justify-content:center; gap:7px; color:var(--ink-soft); font-size:13px; }.breadcrumb text { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.breadcrumb i { width:3px; height:3px; flex:none; border-radius:50%; background:var(--ink-faint); }
.loading-wrap,.error-wrap { padding:20px; }.error-wrap { color:var(--ink-soft); text-align:center; }.error-wrap button { margin-top:16px; color:var(--action-text); }
.study-body { display:flex; width:100%; min-height:0; flex:1 1 auto; flex-direction:column; }
.study-scene { position:relative; max-width:min(100vw,520px); min-height:128px; flex:1 1 auto; aspect-ratio:1; align-self:center; overflow:hidden; background:#f7f1e4; }.study-scene image { width:100%; height:100%; }.scene-fallback { display:flex; width:100%; height:100%; align-items:center; justify-content:center; color:var(--navy); font-family:"Knowing Kai","Kaiti SC",serif; font-size:128px; }.scene-fade { position:absolute; z-index:2; inset:0; background:linear-gradient(180deg,var(--sky),transparent 18px),linear-gradient(0deg,var(--sky),transparent 26px),linear-gradient(90deg,var(--sky),transparent 18px),linear-gradient(270deg,var(--sky),transparent 18px); }.scene-caption { position:absolute; z-index:3; right:16px; bottom:14px; display:flex; align-items:center; gap:7px; padding:6px 11px; border-radius:999px; color:#f4f0e6; background:rgba(15,22,20,.66); font-size:12px; font-weight:700; }
.study-furniture { width:100%; flex:none; }.study-identity { display:flex; min-height:180px; align-items:center; gap:16px; padding:10px 20px 0; }.study-glyph { color:var(--navy); font-family:"Knowing Kai","Kaiti SC",STKaiti,serif; font-size:76px; font-weight:500; line-height:.9; }.identity-copy { display:flex; flex-direction:column; gap:7px; padding-bottom:5px; }.reading { display:flex; align-items:center; gap:9px; }.reading strong { color:var(--action-text); font-size:22px; font-weight:600; }.reading button { display:flex; width:44px; height:44px; min-height:0; align-items:center; justify-content:center; margin:0; padding:0; border-radius:50%; color:var(--action-text); background:var(--action-soft); }.tags { display:flex; flex-wrap:wrap; gap:6px; }.tags text { padding:4px 9px; border-radius:8px; color:var(--ink-soft); background:var(--paper-soft); font-size:12px; font-weight:600; }.tags text.role { color:var(--action-text); background:var(--action-soft); }
.study-meaning { margin:14px 20px 0; color:var(--ink-soft); font-size:15px; line-height:1.72; }
.study-launch { width:100%; padding:0 20px 22px; }.listen-button { display:flex; width:100% !important; max-width:none; min-height:60px; align-items:center; gap:14px; margin:0 !important; padding:0 18px; border-radius:20px; color:#0f1614; text-align:left; background:var(--action); box-shadow:0 4px 0 var(--action-deep); }.listen-button>view:nth-child(2) { display:flex; min-width:0; flex:1; flex-direction:column; gap:2px; }.listen-button strong { font-size:17px; }.listen-button text { color:rgba(15,22,20,.66); font-size:12px; }.listen-button>text:last-child { color:#0f1614; font-size:20px; }.equalizer { display:flex; height:20px; align-items:flex-end; gap:3px; }.equalizer i { width:3px; border-radius:2px; background:rgba(15,22,20,.78); transform-origin:center bottom; }.equalizer i:nth-child(1){height:9px}.equalizer i:nth-child(2){height:17px}.equalizer i:nth-child(3){height:12px}.equalizer i:nth-child(4){height:20px}.equalizer i:nth-child(5){height:7px}
.equalizer.playing i { animation:narration-equalizer 520ms ease-in-out infinite alternate; }.equalizer.playing i:nth-child(2) { animation-delay:-180ms; }.equalizer.playing i:nth-child(3) { animation-delay:-320ms; }.equalizer.playing i:nth-child(4) { animation-delay:-90ms; }.equalizer.playing i:nth-child(5) { animation-delay:-250ms; }
.narration-player { padding:16px; border:2px solid var(--action-edge); border-radius:22px; background:var(--action-soft); box-shadow:0 var(--press) 0 var(--action-edge); animation:narration-player-in 260ms var(--ease-out) both; }
.narration-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }.narration-head>view { display:flex; min-width:0; flex-direction:column; gap:3px; }.narration-head strong { font-size:14px; }.narration-head text { color:var(--ink-soft); font-size:12px; }.narration-head button { display:flex; width:34px; height:34px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0; padding:0; border-radius:50%; color:var(--ink-soft); background:var(--paper-soft); }
.narration-phrase { min-height:3.2em; max-height:8em; margin:14px 0 13px; overflow-y:auto; color:var(--ink); font-family:var(--font-kai); font-size:19px; font-weight:500; line-height:1.6; }
.narration-progress { height:4px; overflow:hidden; border-radius:999px; background:var(--sky-deep); }.narration-progress i { display:block; height:100%; border-radius:inherit; background:var(--action); transition:width 120ms linear; }.narration-time { display:flex; justify-content:space-between; margin-top:6px; color:var(--ink-faint); font-size:11px; font-variant-numeric:tabular-nums; }
.narration-actions { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:7px; margin-top:12px; }.narration-actions button { display:flex; min-width:0; min-height:52px; flex-direction:column; align-items:center; justify-content:center; gap:4px; margin:0; padding:6px 3px; border-radius:15px; color:var(--ink-soft); background:var(--paper-soft); }.narration-actions button text { font-size:11px; }.narration-actions .is-primary { color:#0f1614; background:var(--action); box-shadow:0 3px 0 var(--action-deep); }.narration-actions .is-record { color:var(--wrong-text); background:rgba(233,176,74,.1); }.narration-next { display:flex; width:100%; min-height:46px; align-items:center; justify-content:center; margin:12px 0 0; border-radius:15px; color:var(--sky); background:var(--navy); font-size:14px; font-weight:700; }
.transcript-backdrop { position:fixed; z-index:120; inset:0; background:rgba(5,10,9,.72); -webkit-backdrop-filter:blur(5px); backdrop-filter:blur(5px); animation:drawer-fade 220ms ease both; }.transcript-sheet { position:fixed; z-index:121; right:0; bottom:0; left:0; display:flex; height:min(82vh,720px); flex-direction:column; padding:18px 20px calc(20px + env(safe-area-inset-bottom)); overflow:hidden; border-radius:26px 26px 0 0; color:var(--ink); background:var(--paper); box-shadow:var(--shadow-sheet); animation:transcript-in 220ms var(--ease-out) both; }.transcript-head { display:flex; align-items:center; justify-content:space-between; gap:16px; padding-bottom:14px; border-bottom:1px solid var(--line); }.transcript-head>view { display:flex; flex-direction:column; gap:4px; }.transcript-head text { color:var(--ink-soft); font-size:11px; }.transcript-head strong { font-size:17px; }.transcript-head button { display:flex; width:40px; height:40px; min-height:0; align-items:center; justify-content:center; margin:0; padding:0; border-radius:50%; color:var(--ink-soft); background:var(--paper-soft); }.transcript-text { min-height:0; flex:1; padding:20px 0; color:var(--ink); font-family:var(--font-kai); font-size:20px; line-height:1.9; }.transcript-close { width:100%; min-height:50px; margin:0; border-radius:17px; color:#0f1614; background:var(--action); font-weight:800; }
.transcript-token-flow { line-height:1.9; }.narration-unit { display:inline-block; white-space:nowrap; }.narration-token { position:relative; display:inline-block; border-radius:5px; vertical-align:baseline; transform-origin:center 78%; transition:color 120ms ease,background-color 140ms ease,box-shadow 160ms ease,opacity 140ms ease,transform 160ms ease; }.narration-token.is-upcoming { color:var(--ink-faint); opacity:.58; }.narration-token.is-current-phrase:not(.is-active) { color:var(--ink); background:rgba(255,176,32,.11); }.narration-token.is-complete { color:var(--navy); box-shadow:inset 0 -.2em 0 rgba(255,176,32,.3); }.narration-token.is-active { z-index:1; color:var(--radical-ink); background:var(--radical); box-shadow:0 0 0 3px rgba(255,91,52,.18),0 5px 14px rgba(255,91,52,.25); transform:translateY(-.04em) scale(1.04); animation:narration-character-cue 180ms cubic-bezier(.2,.85,.25,1.15) both; }.narration-token.is-punctuation { margin-right:.1em; color:var(--ink-soft); transform:none; }.narration-token.is-punctuation.is-complete { color:var(--navy); box-shadow:none; }.narration-token.is-punctuation.is-current-phrase { background:transparent; }
.action-wide,.action { display:flex; align-items:center; gap:13px; border:2px solid var(--line); border-radius:18px; color:var(--ink); text-align:left; background:var(--paper); box-shadow:0 4px 0 var(--line); }.action-wide { width:100% !important; max-width:none; min-height:62px; margin:10px 0 0 !important; padding:13px 15px; }.action-wide>view { display:flex; min-width:0; flex:1; flex-direction:column; gap:1px; }.action-wide>text:first-child { color:var(--radical-text); }.action-wide>text:last-child { color:var(--ink-faint); }.action-wide strong,.action strong { font-size:15px; font-weight:800; }.action-wide view text,.action view text { color:var(--ink-soft); font-size:12px; }
.action-grid { display:grid; width:100%; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:var(--card-inline-gap); row-gap:var(--card-stack-gap); margin-top:12px; }.action { width:100%; min-width:0; min-height:64px; margin:0; padding:13px 15px; flex-direction:column; align-items:flex-start; gap:7px; }.action.primary { border-color:var(--action); color:var(--action-text); background:var(--action-soft); box-shadow:0 4px 0 var(--action-edge); }.action>view { display:flex; flex-direction:column; gap:1px; }.detail-handle { width:auto; min-height:40px; align-self:stretch; margin:2px 0 0; padding:0; color:var(--ink-faint); background:transparent; font-size:13px; }
.drawer-backdrop { position:fixed; z-index:70; inset:0; background:rgba(9,14,12,.68); animation:drawer-fade 220ms ease both; }.details { position:fixed; z-index:71; right:0; bottom:0; left:0; display:block; max-height:88vh; padding:10px 20px calc(28px + env(safe-area-inset-bottom)); overflow-y:auto; border-radius:28px 28px 0 0; background:var(--paper); box-shadow:var(--shadow-sheet); transform:translateY(101%); transition:transform 280ms var(--ease-out); }.details.open { transform:translateY(0); }.drawer-grip { width:38px; height:4px; margin:0 auto 6px; border-radius:2px; background:var(--sky-deep); }.drawer-title { margin:22px 0 12px; color:var(--ink-faint); font-size:12px; font-weight:700; letter-spacing:1px; }.drawer-title:first-of-type { margin-top:12px; }.drawer-note { display:flex; align-items:flex-start; gap:12px; padding:15px; border:1px solid var(--line); border-radius:18px; background:var(--paper-soft); }.drawer-note>view:last-child { display:flex; flex-direction:column; gap:4px; }.drawer-note strong { color:var(--ink); font-size:13px; }.drawer-note view text { color:var(--ink-soft); font-size:12px; line-height:1.6; }.drawer-theme { padding:16px 16px 16px 18px; border-left:3px solid var(--action); border-radius:4px 18px 18px 4px; color:var(--ink); background:var(--action-soft); font-family:var(--font-kai); font-size:17px; line-height:1.72; }
.drawer-note>ki-icon { color:var(--wrong-text); }
.cue-list { display:flex; flex-direction:column; gap:10px; margin-top:14px; }.cue-list>view { display:flex; gap:10px; line-height:1.6; }.cue-list text { color:var(--radical-text); font-weight:900; }
.part-list { display:flex; flex-direction:column; gap:8px; }.part { display:flex; align-items:center; gap:13px; padding:13px 14px; border:1px solid var(--part-edge); border-radius:18px; background:rgba(47,168,224,.12); }.part.radical { border-color:var(--radical-edge); background:rgba(255,91,52,.1); }.part-glyph { display:flex; width:46px; height:46px; flex:none; align-items:center; justify-content:center; border-radius:14px; color:var(--part-text); background:rgba(47,168,224,.26); font-family:"Knowing Kai","Kaiti SC",serif; font-size:26px; }.part-glyph.radical { color:var(--radical-text); background:rgba(255,91,52,.22); }.part strong,.part text { display:block; }.part strong { color:var(--navy); font-size:14px; }.part text { margin-top:3px; color:var(--ink-soft); font-size:12px; line-height:1.5; }
.writing-wrap { position:relative; width:100%; height:280px; margin-top:14px; overflow:hidden; border:2px solid var(--action-edge); border-radius:22px; background-image:linear-gradient(rgba(11,118,84,.11) 1px,transparent 1px),linear-gradient(90deg,rgba(11,118,84,.11) 1px,transparent 1px); background-size:50% 50%; background-position:center; background-color:var(--action-soft); }.writing-guide { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:rgba(11,118,84,.08); font-family:"Knowing Kai","Kaiti SC",serif; font-size:195px; }.writing-canvas { position:absolute; inset:0; width:100%; height:100%; }.clear,.sibling-row button,.practice-button { min-height:48px; border-radius:16px; font-weight:900; }.clear { width:100%; margin-top:12px; color:var(--navy); border:2px solid var(--line); background:var(--paper); box-shadow:0 4px 0 var(--line); }.sibling-row { display:flex; gap:10px; }.sibling-row button { flex:1; margin:0; color:var(--navy); border:2px solid var(--line); background:var(--paper); box-shadow:0 4px 0 var(--line); }.practice-button { width:100%; margin:0; color:#0f1614; background:var(--action); box-shadow:0 4px 0 var(--action-deep); }

.memory-stage { position:fixed; z-index:110; inset:0; display:flex; min-height:100vh; flex-direction:column; overflow-y:auto; color:var(--ink); background:var(--sky); }.memory-stage::before { position:absolute; z-index:0; top:40px; left:50%; width:460px; height:460px; border-radius:50%; background:radial-gradient(circle,rgba(53,194,149,.12),transparent 66%); content:""; transform:translateX(-50%); pointer-events:none; transition:background 320ms var(--ease-out); }.memory-stage.stage-1::before { background:radial-gradient(circle,rgba(217,84,47,.12),transparent 66%); }.memory-stage.stage-2::before { background:radial-gradient(circle,rgba(46,108,138,.12),transparent 66%); }.memory-stage > view { position:relative; z-index:1; }
.memory-stage-progress { display:flex; gap:5px; padding:max(14px,env(safe-area-inset-top)) 20px 0; }.memory-stage-progress i { height:3px; flex:1; border-radius:2px; background:var(--sky-deep); transition:background 240ms ease; }.memory-stage-progress i.is-past { background:var(--ink-soft); }.memory-stage-progress i.is-current { background:var(--action); }.memory-stage.stage-1 .memory-stage-progress i.is-current { background:var(--radical); }.memory-stage.stage-2 .memory-stage-progress i.is-current { background:var(--part); }
.memory-stage-bar { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:6px 12px 0; }.memory-stage-bar text { color:var(--ink-soft); font-size:13px; font-weight:600; }.memory-stage-bar button { display:flex; width:44px; height:44px; min-height:0; align-items:center; justify-content:center; margin:0; padding:0; border-radius:50%; color:var(--ink); background:transparent; }
.memory-stage-content { display:flex; min-height:0; flex-direction:column; }.memory-motion-a { animation:memory-content-a 320ms var(--ease-out) both; }.memory-motion-b { animation:memory-content-b 320ms var(--ease-out) both; }.memory-stage-scene { position:relative; min-width:150px; min-height:150px; max-width:100%; flex:none; align-self:center; overflow:hidden; border-radius:22px; background:#f7f1e4; }.memory-stage-scene image { width:100%; height:100%; }.memory-focus { position:absolute; inset:0; transition:background 320ms ease; }.layout-left-right.stage-1 .memory-focus { background:linear-gradient(90deg,rgba(217,84,47,.26) 0 50%,rgba(8,18,33,.5) 50% 100%); }.layout-left-right.stage-2 .memory-focus { background:linear-gradient(90deg,rgba(8,18,33,.5) 0 50%,rgba(46,108,138,.26) 50% 100%); }.layout-top-bottom.stage-1 .memory-focus { background:linear-gradient(180deg,rgba(217,84,47,.26) 0 48%,rgba(8,18,33,.5) 48% 100%); }.layout-top-bottom.stage-2 .memory-focus { background:linear-gradient(180deg,rgba(8,18,33,.5) 0 48%,rgba(46,108,138,.26) 48% 100%); }.layout-surround.stage-1 .memory-focus { background:radial-gradient(ellipse at 53% 54%,rgba(8,18,33,.5) 0 29%,transparent 30%),rgba(217,84,47,.26); }.layout-surround.stage-2 .memory-focus { background:radial-gradient(ellipse at 53% 54%,rgba(46,108,138,.26) 0 31%,rgba(8,18,33,.49) 32%); }.layout-single .memory-focus { inset:6%; border:2px solid rgba(255,255,255,.72); border-radius:26px; background:radial-gradient(circle at 50% 52%,transparent 0 42%,rgba(53,194,149,.28) 100%); box-shadow:0 0 0 999px rgba(8,18,33,.18); }.memory-focus-ring { position:absolute; border:2px solid var(--action); border-radius:50%; box-shadow:0 0 26px rgba(53,194,149,.4); animation:memory-ring-in 420ms var(--ease-out) both; }.layout-left-right.stage-1 .memory-focus-ring { top:15%; bottom:15%; left:4%; width:46%; border-color:var(--radical); }.layout-left-right.stage-2 .memory-focus-ring { top:15%; right:4%; bottom:15%; width:46%; border-color:var(--part); }.layout-top-bottom.stage-1 .memory-focus-ring { top:4%; right:14%; left:14%; height:45%; border-color:var(--radical); }.layout-top-bottom.stage-2 .memory-focus-ring { right:14%; bottom:4%; left:14%; height:45%; border-color:var(--part); }.layout-surround .memory-focus-ring,.layout-single .memory-focus-ring { inset:13%; border-color:var(--action); }
.memory-focus-ring { transition:all 320ms var(--ease-out); }
.layout-left-right.focus-end.stage-1 .memory-focus { background:linear-gradient(90deg,rgba(8,18,33,.5) 0 50%,rgba(217,84,47,.26) 50% 100%); }.layout-left-right.focus-end.stage-2 .memory-focus { background:linear-gradient(90deg,rgba(46,108,138,.26) 0 50%,rgba(8,18,33,.5) 50% 100%); }.layout-top-bottom.focus-end.stage-1 .memory-focus { background:linear-gradient(180deg,rgba(8,18,33,.5) 0 48%,rgba(217,84,47,.26) 48% 100%); }.layout-top-bottom.focus-end.stage-2 .memory-focus { background:linear-gradient(180deg,rgba(46,108,138,.26) 0 48%,rgba(8,18,33,.5) 48% 100%); }
.layout-left-right.focus-end.stage-1 .memory-focus-ring { right:4%; left:auto; border-color:var(--radical); }.layout-left-right.focus-end.stage-2 .memory-focus-ring { right:auto; left:4%; border-color:var(--part); }.layout-top-bottom.focus-end.stage-1 .memory-focus-ring { top:auto; bottom:4%; border-color:var(--radical); }.layout-top-bottom.focus-end.stage-2 .memory-focus-ring { top:4%; bottom:auto; border-color:var(--part); }
.memory-stage-copy { padding:22px 20px 0; }.memory-stage-eyebrow { display:flex; align-items:center; gap:8px; color:var(--action-text); font-size:13px; font-weight:700; letter-spacing:.05em; }.stage-1 .memory-stage-eyebrow { color:var(--radical-text); }.stage-2 .memory-stage-eyebrow { color:var(--part-text); }.memory-stage-eyebrow b { display:flex; width:20px; height:20px; align-items:center; justify-content:center; border-radius:6px; color:#0f1614; background:var(--action); font-size:11px; }.stage-1 .memory-stage-eyebrow b { background:var(--radical); }.stage-2 .memory-stage-eyebrow b { background:var(--part); }.memory-stage-copy>strong { display:block; margin-top:12px; color:var(--ink); font-family:var(--font-kai); font-size:27px; font-weight:500; line-height:1.34; }.memory-stage-copy>text { display:block; margin-top:10px; color:var(--ink-soft); font-size:15px; line-height:1.72; }
.memory-stage-spacer { min-height:10px; flex:1; }.memory-stage-foot { padding:0 20px calc(22px + env(safe-area-inset-bottom)); }.memory-stage-chips { display:flex; gap:10px; margin-bottom:16px; }.memory-stage-chips button { display:flex; min-width:0; flex:1; align-items:center; gap:10px; margin:0; padding:11px 13px; border:1px solid var(--line); border-radius:16px; color:inherit; text-align:left; background:var(--paper-soft); }.memory-stage-chips button>text { color:var(--ink-faint); font-family:var(--font-kai); font-size:26px; }.memory-stage-chips button>view { display:flex; min-width:0; flex-direction:column; gap:2px; }.memory-stage-chips strong { color:var(--ink-faint); font-size:12px; }.memory-stage-chips small { color:var(--ink-faint); font-size:11px; }.memory-stage-chips .is-active.is-radical { border-color:var(--radical); background:rgba(217,84,47,.13); }.memory-stage-chips .is-active.is-radical>text,.memory-stage-chips .is-active.is-radical strong { color:var(--radical-text); }.memory-stage-chips .is-active.is-component { border-color:var(--part); background:rgba(46,108,138,.15); }.memory-stage-chips .is-active.is-component>text,.memory-stage-chips .is-active.is-component strong { color:var(--part-text); }
.memory-stage-next { display:flex; width:100%; min-height:56px; align-items:center; justify-content:center; margin:0; border-radius:20px; color:var(--sky); background:var(--navy); font-size:16px; font-weight:700; }.memory-stage-next.is-finish { min-height:60px; color:#0f1614; background:var(--action); box-shadow:0 var(--press) 0 var(--action-deep); }.memory-stage-secondary { display:block; width:100%; min-height:48px; margin:6px 0 0; color:var(--ink-faint); background:transparent; font-size:14px; }.memory-stage-hint { display:block; margin-top:12px; color:var(--ink-faint); font-size:12px; text-align:center; }
.memory-stage-recall { display:flex; align-items:center; gap:11px; margin:14px 20px 0; padding:9px 12px 9px 9px; border:1px dashed var(--line); border-radius:18px; }.memory-stage-recall image { width:44px; height:44px; border-radius:12px; opacity:.42; background:#f7f1e4; }.memory-stage-recall>view { display:flex; min-width:0; flex:1; flex-direction:column; gap:2px; }.memory-stage-recall strong { color:var(--ink-soft); font-size:13px; }.memory-stage-recall text { color:var(--ink-faint); font-size:11px; }.memory-stage-recall button { margin:0; padding:7px 12px; border-radius:999px; color:var(--ink-soft); background:var(--paper-soft); font-size:12px; }.memory-stage-equation { display:flex; align-items:center; justify-content:center; gap:18px; margin-top:40px; }.memory-stage-parts { display:flex; width:124px; flex-direction:column; overflow:hidden; border:1px solid var(--line); border-radius:20px; }.memory-stage-parts.is-beside { width:168px; flex-direction:row; }.memory-stage-parts>text { display:flex; height:80px; flex:1; align-items:center; justify-content:center; font-family:var(--font-kai); font-size:42px; }.memory-stage-parts>text+text { border-top:1px dashed var(--line); }.memory-stage-parts.is-beside>text+text { border-top:0; border-left:1px dashed var(--line); }.memory-stage-parts .is-radical { color:var(--radical-text); background:rgba(217,84,47,.2); }.memory-stage-parts .is-component { color:var(--part-text); background:rgba(46,108,138,.2); }.memory-arrow { color:var(--ink-faint); font-size:30px; }.memory-stage-result { color:var(--ink); font-family:var(--font-kai); font-size:116px; font-weight:500; line-height:1; }.memory-stage-legend { display:flex; justify-content:center; gap:18px; margin-top:22px; color:var(--ink-faint); font-size:12px; }.memory-stage-legend text { display:flex; align-items:center; gap:6px; }.memory-stage-legend i { width:8px; height:8px; border-radius:3px; }.radical-dot { background:var(--radical); }.part-dot { background:var(--part); }.final-copy { padding-top:26px; }

.memory-stage-foot { width:100%; align-self:stretch; box-sizing:border-box; }.memory-stage-foot .memory-stage-next,.memory-stage-foot .memory-stage-secondary { width:100% !important; max-width:none; }
.study-shell.is-listening .study-identity { min-height:auto; align-items:center; gap:12px; padding-top:10px; }.study-shell.is-listening .study-glyph { font-size:56px; }.study-shell.is-listening .identity-copy { min-width:0; flex:1; flex-direction:row; align-items:center; gap:10px; padding-bottom:0; }.study-shell.is-listening .tags { min-width:0; flex:1; flex-wrap:nowrap; overflow:hidden; }.study-shell.is-listening .tags text:not(.role) { display:none; }.study-shell.is-listening .tags .role { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.study-shell.is-listening .study-meaning { overflow:hidden; margin-top:4px; white-space:nowrap; text-overflow:ellipsis; font-size:14px; line-height:1.45; }.study-shell.is-listening .study-launch { padding-top:8px; padding-bottom:calc(10px + env(safe-area-inset-bottom)); }.study-shell.is-listening .action-wide,.study-shell.is-listening .detail-handle { display:none; }

@keyframes drawer-fade { from { opacity:0; } to { opacity:1; } }
@keyframes narration-player-in { from { opacity:0; transform:translateY(12px) scale(.98); } to { opacity:1; transform:none; } }
@keyframes narration-equalizer { from { transform:scaleY(.45); } to { transform:scaleY(1.18); } }
@keyframes narration-character-cue { 0% { opacity:.62; transform:translateY(.08em) scale(.86); } 56% { opacity:1; transform:translateY(-.13em) scale(1.16); } 100% { transform:translateY(-.08em) scale(1.08); } }
@keyframes transcript-in { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:none; } }
@keyframes memory-content-a { from { opacity:0; transform:translateX(18px); } to { opacity:1; transform:none; } }
@keyframes memory-content-b { from { opacity:0; transform:translateX(-18px); } to { opacity:1; transform:none; } }
@keyframes memory-ring-in { from { opacity:0; transform:scale(.72); } to { opacity:1; transform:none; } }
@media (prefers-reduced-motion:reduce) { .equalizer.playing i,.narration-player,.transcript-backdrop,.transcript-sheet,.drawer-backdrop,.memory-stage-content,.memory-focus,.memory-focus-ring,.narration-token,.narration-token.is-active { animation:none; transition:none; }.details,.memory-stage::before,.memory-stage-progress i,.narration-progress i { transition:none; } }
@media (max-width:899px) and (max-height:760px) {
  .study-identity { min-height:auto; gap:12px; padding-top:4px; }
  .study-glyph { font-size:58px; }
  .study-meaning { margin-top:10px; font-size:14.72px; line-height:1.7; }
  .listen-button { min-height:54px; }
  .action-wide { min-height:56px; margin-top:8px !important; padding:10px 14px; }
  .action-grid { margin-top:8px; }
  .action { min-height:58px; padding:10px 14px; }
  .narration-player { padding:12px 14px; border-radius:20px; }
  .narration-phrase { min-height:2.8em; max-height:5.6em; margin:8px 0; font-size:17px; line-height:1.4; }
  .narration-actions { margin-top:8px; }
  .narration-actions button { min-height:46px; border-radius:13px; }
  .narration-next { min-height:42px; margin-top:8px; }
  .transcript-sheet { height:90vh; padding:14px 18px calc(16px + env(safe-area-inset-bottom)); }
  .transcript-text { padding:14px 2px; }
}
@media (min-width:900px) {
  .study-shell { justify-content:center; }
  .study-topbar { width:min(1080px,calc(100% - 64px)); height:auto !important; margin:0 auto; padding:20px 0 18px !important; }
  .study-body { display:grid; width:min(1080px,calc(100% - 64px)); margin:0 auto; grid-template-columns:minmax(0,1fr) minmax(0,1fr); align-items:start; gap:40px; }
  .study-scene { width:100% !important; height:auto !important; max-width:none; align-self:start; }
  .study-furniture { min-width:0; }
  .study-identity { min-height:auto; padding:0; }
  .study-meaning { margin:14px 0 0; }
  .study-launch { padding:26px 0 40px; }
  .details { right:50%; left:auto; width:min(720px,calc(100% - 64px)); transform:translate(50%,101%); }
  .details.open { transform:translate(50%,0); }
  .transcript-sheet { top:0; left:auto; width:min(520px,48vw); height:auto; padding:28px 30px; border-radius:26px 0 0 26px; }
}

/* Semantic colour and type tokens shared with the Web study view. */
.scene-fallback,.study-glyph,.part-glyph,.writing-guide { font-family:var(--font-kai); }
.listen-button,.listen-button>text:last-child,.narration-actions .is-primary,.transcript-close,.practice-button,.memory-stage-eyebrow b,.memory-stage-next.is-finish { color:var(--action-ink); }
.part { background:rgba(46,108,138,.12); }
.part.radical { background:rgba(217,84,47,.1); }
.part-glyph { background:rgba(46,108,138,.26); }
.part-glyph.radical { background:rgba(217,84,47,.22); }
.part strong { color:var(--ink); }
.listen-button>.listen-arrow { color:var(--action-ink); }
.narration-next,.detail-handle,.memory-stage-next { display:flex; align-items:center; justify-content:center; gap:6px; }
.action-wide>ki-icon:first-child { color:var(--wrong-text); }
.action-wide>ki-icon:last-child { color:var(--ink-faint); }
.memory-arrow { display:flex; width:30px; height:30px; align-items:center; justify-content:center; }
.listen-button { transition:transform 160ms var(--ease-out); }
.details { visibility:hidden; pointer-events:none; transition:transform 280ms var(--ease-out),visibility 0s linear 280ms; }
.details.open { visibility:visible; pointer-events:auto; transition-delay:0s; }
.memory-stage-chips button { transition:border-color 200ms ease,background-color 200ms ease; }
@media (prefers-reduced-motion:reduce) {
  .listen-button,.details,.memory-stage-chips button { transition:none; }
}
