.retry { margin-top: 22rpx; }.character-hero { padding: 28rpx; }.hero-top { display: flex; justify-content: space-between; align-items: center; }.favorite { margin: 0; padding: 0; color: #9a8e77; background: transparent; font-size: 48rpx; line-height: 1; }.favorite.active { color: #c79b4b; }
.hero-body { display: flex; align-items: center; gap: 30rpx; margin-top: 22rpx; }.hanzi-box { position: relative; flex: none; display: flex; align-items: center; justify-content: center; width: 270rpx; height: 270rpx; overflow: hidden; border: 2rpx solid rgba(166,71,43,.32); background: #fffaf0; }.hanzi-box::before,.hanzi-box::after { content: ""; position: absolute; width: 140%; border-top: 1rpx dashed rgba(166,71,43,.18); transform: rotate(45deg); }.hanzi-box::after { transform: rotate(-45deg); }.grid-line { position: absolute; background: rgba(166,71,43,.16); }.grid-line.horizontal { left: 0; right: 0; height: 1rpx; }.grid-line.vertical { top: 0; bottom: 0; width: 1rpx; }.hanzi-box text { position: relative; z-index: 1; font-family: "KaiTi SC",STKaiti,serif; font-size: 190rpx; line-height: 1; }
.hero-detail { flex: 1; }.pinyin { color: #a6472b; font-size: 34rpx; }.word { margin-top: 8rpx; font-family: "Songti SC",serif; font-size: 40rpx; font-weight: 700; }.type { margin-top: 12rpx; color: #706b5f; font-size: 23rpx; line-height: 1.5; }.audio-button { margin: 24rpx 0 0; min-height: 66rpx; padding: 0 28rpx; border-radius: 99rpx; color: white; background: #55735c; font-size: 24rpx; }
.visual { display: block; width: 100%; margin-top: 24rpx; overflow: hidden; }.meaning { margin-top: 14rpx; font-family: "Songti SC",serif; font-size: 32rpx; font-weight: 700; line-height: 1.55; }.context-quote { margin-top: 20rpx; padding: 20rpx 22rpx; border-left: 5rpx solid #c79b4b; color: #5e574a; background: #f7f0df; line-height: 1.7; }
.cue-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 22rpx; }.cue-list>view { display: flex; gap: 16rpx; line-height: 1.6; }.cue-list text { flex: none; color: #a6472b; font-family: Georgia,serif; }
.part-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 20rpx; }.part { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; border-radius: 20rpx; background: #f7f1e4; }.part-glyph { flex: none; display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 18rpx; color: #466779; background: #dce8e9; font-family: "KaiTi SC",serif; font-size: 42rpx; }.part-glyph.radical { color: #8d3927; background: #f1d9d0; }.part strong,.part text { display: block; }.part strong { font-size: 25rpx; }.part text { margin-top: 5rpx; color: #706b5f; font-size: 21rpx; line-height: 1.45; }
.writing-wrap { position: relative; width: 100%; height: 560rpx; margin-top: 20rpx; border: 2rpx solid rgba(166,71,43,.25); background-image: linear-gradient(rgba(166,71,43,.11) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(166,71,43,.11) 1rpx,transparent 1rpx); background-size: 50% 50%; background-position: center; background-color: #fffaf2; }.writing-guide { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(166,71,43,.08); font-family: "KaiTi SC",serif; font-size: 390rpx; }.writing-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }.clear { margin-top: 16rpx; }.sibling-row { margin-top: 30rpx; }.practice { margin-top: 18rpx; }
