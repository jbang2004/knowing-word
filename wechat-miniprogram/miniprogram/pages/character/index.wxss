.retry { margin-top: 22rpx; }
.character-hero { padding: 28rpx; }.hero-top { display: flex; justify-content: space-between; align-items: center; }.favorite { margin: 0; padding: 0; color: var(--ink-faint); background: transparent; font-size: 48rpx; line-height: 1; }.favorite.active { color: var(--wrong); }
.hero-body { display: flex; align-items: center; gap: 28rpx; margin-top: 22rpx; }.hanzi-box { position: relative; flex: none; display: flex; align-items: center; justify-content: center; width: 270rpx; height: 270rpx; overflow: hidden; border: 4rpx solid var(--radical-edge); border-radius: 44rpx 44rpx 44rpx 14rpx; background: var(--radical-soft); box-shadow: 0 9rpx 0 var(--radical-edge); }.hanzi-box::before,.hanzi-box::after { content: ""; position: absolute; width: 140%; border-top: 2rpx dashed rgba(189,50,20,.18); transform: rotate(45deg); }.hanzi-box::after { transform: rotate(-45deg); }.grid-line { position: absolute; background: rgba(189,50,20,.16); }.grid-line.horizontal { left: 0; right: 0; height: 2rpx; }.grid-line.vertical { top: 0; bottom: 0; width: 2rpx; }.hanzi-box text { position: relative; z-index: 1; color: var(--navy); font-family: "Kaiti SC",STKaiti,serif; font-size: 190rpx; line-height: 1; }
.hero-detail { flex: 1; }.pinyin { color: var(--radical-text); font-size: 34rpx; font-weight: 900; }.word { margin-top: 8rpx; color: var(--navy); font-size: 39rpx; font-weight: 900; }.type { margin-top: 12rpx; color: var(--ink-soft); font-size: 23rpx; line-height: 1.5; }.audio-button { margin: 24rpx 0 0; min-height: 66rpx; padding: 0 28rpx; border-radius: 22rpx; color: #0f1614; background: var(--action); box-shadow: 0 6rpx 0 var(--action-deep); font-size: 24rpx; font-weight: 900; }
.visual { display: block; width: 100%; margin-top: 24rpx; overflow: hidden; border-radius: 28rpx; }.meaning { margin-top: 14rpx; color: var(--navy); font-size: 31rpx; font-weight: 900; line-height: 1.55; }.context-quote { margin-top: 20rpx; padding: 20rpx 22rpx; border-left: 8rpx solid var(--wrong); border-radius: 0 22rpx 22rpx 0; color: var(--wrong-text); background: var(--wrong-soft); line-height: 1.7; }
.cue-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 22rpx; }.cue-list>view { display: flex; gap: 16rpx; line-height: 1.6; }.cue-list text { flex: none; color: var(--radical-text); font-weight: 900; }
.part-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 20rpx; }.part { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; border: 2rpx solid var(--part-edge); border-radius: 24rpx; background: var(--part-soft); }.part-glyph { flex: none; display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; border-radius: 23rpx 23rpx 23rpx 8rpx; color: #0f1614; background: var(--part); box-shadow: 0 5rpx 0 var(--part-deep); font-family: "Kaiti SC",serif; font-size: 42rpx; }.part-glyph.radical { background: var(--radical); box-shadow: 0 5rpx 0 var(--radical-deep); }.part strong,.part text { display: block; }.part strong { color: var(--navy); font-size: 25rpx; }.part text { margin-top: 5rpx; color: var(--ink-soft); font-size: 21rpx; line-height: 1.45; }
.writing-wrap { position: relative; width: 100%; height: 560rpx; margin-top: 20rpx; overflow: hidden; border: 4rpx solid var(--action-edge); border-radius: 34rpx; background-image: linear-gradient(rgba(11,118,84,.11) 2rpx,transparent 2rpx),linear-gradient(90deg,rgba(11,118,84,.11) 2rpx,transparent 2rpx); background-size: 50% 50%; background-position: center; background-color: var(--action-soft); }.writing-guide { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(11,118,84,.08); font-family: "Kaiti SC",serif; font-size: 390rpx; }.writing-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }.clear { margin-top: 16rpx; }.sibling-row { margin-top: 30rpx; }.practice { margin-top: 18rpx; }
