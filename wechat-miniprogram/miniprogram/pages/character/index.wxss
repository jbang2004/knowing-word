/* Character study mirrors the Web immersive card at phone width. */
.study-shell { position:relative; display:flex; width:100%; min-height:100vh; flex-direction:column; overflow:hidden; color:var(--ink); background:var(--sky); }
.study-topbar { display:flex; width:100%; align-items:center; justify-content:space-between; gap:8px; padding-left:12px; box-sizing:border-box; }
.study-topbar button { display:flex; width:44px; height:44px; min-height:0; flex:none; align-items:center; justify-content:center; margin:0; padding:0; border-radius:50%; color:var(--ink); background:transparent; font-size:30px; line-height:1; }
.study-topbar .favorite { font-size:27px; }.study-topbar .favorite.active { color:var(--wrong); }
.breadcrumb { display:flex; min-width:0; flex:1; align-items:center; justify-content:center; gap:7px; color:var(--ink-soft); font-size:13px; }.breadcrumb text { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.breadcrumb i { width:3px; height:3px; flex:none; border-radius:50%; background:var(--ink-faint); }
.loading-wrap,.error-wrap { padding:20px; }.error-wrap { color:var(--ink-soft); text-align:center; }.error-wrap button { margin-top:16px; color:var(--action-text); }
.study-body { display:flex; width:100%; min-height:0; flex:1 1 auto; flex-direction:column; }
.study-scene { position:relative; max-width:100%; min-height:128px; flex:none; align-self:center; overflow:hidden; background:#f7f1e4; }.study-scene image { width:100%; height:100%; }.scene-fallback { display:flex; width:100%; height:100%; align-items:center; justify-content:center; color:var(--navy); font-family:"Kaiti SC",serif; font-size:128px; }.scene-fade { position:absolute; z-index:2; inset:0; background:linear-gradient(180deg,var(--sky),transparent 18px),linear-gradient(0deg,var(--sky),transparent 26px),linear-gradient(90deg,var(--sky),transparent 18px),linear-gradient(270deg,var(--sky),transparent 18px); }.scene-caption { position:absolute; z-index:3; right:16px; bottom:14px; padding:6px 11px; border-radius:999px; color:#f4f0e6; background:rgba(15,22,20,.66); font-size:12px; font-weight:700; }
.study-furniture { flex:none; }.study-identity { display:flex; min-height:180px; align-items:center; gap:16px; padding:10px 20px 0; }.study-glyph { color:var(--navy); font-family:"Kaiti SC",serif; font-size:76px; font-weight:500; line-height:.9; }.identity-copy { display:flex; flex-direction:column; gap:7px; padding-bottom:5px; }.reading { display:flex; align-items:center; gap:9px; }.reading strong { color:var(--action-text); font-size:22px; font-weight:600; }.reading button { display:flex; width:44px; height:44px; min-height:0; align-items:center; justify-content:center; margin:0; padding:0; border-radius:50%; color:var(--action-text); background:var(--action-soft); }.tags { display:flex; flex-wrap:wrap; gap:6px; }.tags text { padding:4px 9px; border-radius:8px; color:var(--ink-soft); background:var(--paper-soft); font-size:12px; font-weight:600; }.tags text.role { color:var(--action-text); background:var(--action-soft); }
.study-meaning { margin:14px 20px 0; color:var(--ink-soft); font-size:15px; line-height:1.72; }
.study-launch { padding:10px 20px 22px; }.listen-button { display:flex; width:100%; min-height:60px; align-items:center; gap:14px; margin:0; padding:0 18px; border-radius:20px; color:#0f1614; text-align:left; background:var(--action); box-shadow:0 4px 0 var(--action-deep); }.listen-button>view:nth-child(2) { display:flex; min-width:0; flex:1; flex-direction:column; gap:2px; }.listen-button strong { font-size:17px; }.listen-button text { color:rgba(15,22,20,.66); font-size:12px; }.listen-button>text:last-child { color:#0f1614; font-size:20px; }.equalizer { display:flex; height:20px; align-items:flex-end; gap:3px; }.equalizer i { width:3px; border-radius:2px; background:rgba(15,22,20,.78); }.equalizer i:nth-child(1){height:9px}.equalizer i:nth-child(2){height:17px}.equalizer i:nth-child(3){height:12px}.equalizer i:nth-child(4){height:20px}.equalizer i:nth-child(5){height:7px}
.action-wide,.action { display:flex; align-items:center; gap:13px; border:2px solid var(--line); border-radius:18px; color:var(--ink); text-align:left; background:white; box-shadow:0 4px 0 var(--line); }.action-wide { width:100%; min-height:62px; margin:10px 0 0; padding:13px 15px; }.action-wide>view { display:flex; min-width:0; flex:1; flex-direction:column; gap:1px; }.action-wide>text:first-child { color:var(--radical-text); }.action-wide>text:last-child { color:var(--ink-faint); }.action-wide strong,.action strong { font-size:15px; font-weight:800; }.action-wide view text,.action view text { color:var(--ink-soft); font-size:12px; }
.action-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin-top:10px; }.action { min-height:76px; margin:0; padding:13px 15px; flex-direction:column; align-items:flex-start; gap:7px; }.action.primary { border-color:var(--action); color:var(--action-text); background:var(--action-soft); box-shadow:0 4px 0 var(--action-edge); }.action>view { display:flex; flex-direction:column; gap:1px; }.detail-handle { width:100%; min-height:42px; margin:10px 0 0; padding:0; color:var(--ink-faint); background:transparent; font-size:13px; }
.drawer-backdrop { position:fixed; z-index:70; inset:0; background:rgba(9,14,12,.68); }.details { position:fixed; z-index:71; right:0; bottom:0; left:0; display:block; max-height:88vh; padding:10px 20px calc(28px + env(safe-area-inset-bottom)); overflow-y:auto; border-radius:28px 28px 0 0; background:var(--paper); box-shadow:0 -18px 52px rgba(18,60,51,.22); transform:translateY(101%); transition:transform 280ms ease-out; }.details.open { transform:translateY(0); }.drawer-grip { width:38px; height:4px; margin:0 auto 6px; border-radius:2px; background:var(--sky-deep); }.drawer-title { margin:22px 0 12px; color:var(--ink-faint); font-size:12px; font-weight:700; letter-spacing:1px; }.drawer-title:first-of-type { margin-top:12px; }.drawer-note { display:flex; align-items:flex-start; gap:12px; padding:15px; border:1px solid var(--line); border-radius:18px; background:var(--paper-soft); }.drawer-note>text { color:var(--wrong-text); }.drawer-note>view { display:flex; flex-direction:column; gap:4px; }.drawer-note strong { color:var(--ink); font-size:13px; }.drawer-note view text { color:var(--ink-soft); font-size:12px; line-height:1.6; }.drawer-theme { padding:16px 16px 16px 18px; border-left:3px solid var(--action); border-radius:4px 18px 18px 4px; color:var(--ink); background:var(--action-soft); font-family:"Kaiti SC",serif; font-size:17px; line-height:1.72; }
.cue-list { display:flex; flex-direction:column; gap:10px; margin-top:14px; }.cue-list>view { display:flex; gap:10px; line-height:1.6; }.cue-list text { color:var(--radical-text); font-weight:900; }
.part-list { display:flex; flex-direction:column; gap:8px; }.part { display:flex; align-items:center; gap:13px; padding:13px 14px; border:1px solid var(--part-edge); border-radius:18px; background:rgba(47,168,224,.12); }.part.radical { border-color:var(--radical-edge); background:rgba(255,91,52,.1); }.part-glyph { display:flex; width:46px; height:46px; flex:none; align-items:center; justify-content:center; border-radius:14px; color:var(--part-text); background:rgba(47,168,224,.26); font-family:"Kaiti SC",serif; font-size:26px; }.part-glyph.radical { color:var(--radical-text); background:rgba(255,91,52,.22); }.part strong,.part text { display:block; }.part strong { color:var(--navy); font-size:14px; }.part text { margin-top:3px; color:var(--ink-soft); font-size:12px; line-height:1.5; }
.writing-wrap { position:relative; width:100%; height:280px; margin-top:14px; overflow:hidden; border:2px solid var(--action-edge); border-radius:22px; background-image:linear-gradient(rgba(11,118,84,.11) 1px,transparent 1px),linear-gradient(90deg,rgba(11,118,84,.11) 1px,transparent 1px); background-size:50% 50%; background-position:center; background-color:var(--action-soft); }.writing-guide { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:rgba(11,118,84,.08); font-family:"Kaiti SC",serif; font-size:195px; }.writing-canvas { position:absolute; inset:0; width:100%; height:100%; }.clear,.sibling-row button,.practice-button { min-height:48px; border-radius:16px; font-weight:900; }.clear { width:100%; margin-top:12px; color:var(--navy); border:2px solid var(--line); background:white; box-shadow:0 4px 0 var(--line); }.sibling-row { display:flex; gap:10px; }.sibling-row button { flex:1; margin:0; color:var(--navy); border:2px solid var(--line); background:white; box-shadow:0 4px 0 var(--line); }.practice-button { width:100%; margin:0; color:#0f1614; background:var(--action); box-shadow:0 4px 0 var(--action-deep); }
