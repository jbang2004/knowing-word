@import "./generated-font.wxss";
@import "./design-tokens.generated.wxss";

page {
  min-height: 100%;
  background: var(--sky);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 28rpx;
}

.theme-night {
  background:var(--sky);
  color:var(--ink);
}

.kai { font-family: var(--font-kai); }

view, text, image, button, input, canvas, scroll-view { box-sizing: border-box; }
button { min-width: 0; max-width:100%; font: inherit; transition:transform 90ms ease,box-shadow 90ms ease; }
button::after { border: 0; }
button:active { transform:translateY(var(--press)); box-shadow:none; }
button[disabled]:active { transform:none; }
.press-card { transition:transform 90ms ease,box-shadow 90ms ease,border-color 140ms ease,background-color 140ms ease; }
.press-card.is-pressed { transform: translateY(var(--press)); box-shadow: none; }
.page { width:100%; max-width:1180px; min-height:100vh; margin-right:auto; margin-left:auto; padding:26rpx 32rpx calc(54rpx + env(safe-area-inset-bottom)); }
.home-page,.course-page,.practice-hub-page,.track-page,.account-page,.components-page,.read-page,.records-page { animation:page-arrive 620ms var(--ease-out) both; }
.page-arrive-a { animation:page-arrive-a 620ms var(--ease-out) both; }
.page-arrive-b { animation:page-arrive-b 620ms var(--ease-out) both; }
.paper-texture { background: var(--sky); }
.eyebrow { display: block; margin-bottom: 10rpx; color: var(--radical-text); font-size: 22rpx; font-weight: 800; letter-spacing: 3rpx; }
.title { color: var(--navy); font-size: 50rpx; font-weight: 900; line-height: 1.16; }
.subtitle { margin-top: 12rpx; color: var(--ink-soft); font-size: 25rpx; line-height: 1.65; }
.card { border: 2rpx solid var(--line); border-radius: 34rpx; background: var(--paper); box-shadow: 0 7rpx 0 var(--line-deep); }
.section { margin-top: 28rpx; padding: 28rpx; }
.section-title { color: var(--navy); font-size: 34rpx; font-weight: 900; }
.section-copy { margin-top: 10rpx; color: var(--ink-soft); line-height: 1.65; }
.primary-button, .secondary-button, .ghost-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: 28rpx; font-weight: 900; }
.primary-button { color: var(--action-ink); background: var(--action); box-shadow: 0 8rpx 0 var(--action-deep); }
.secondary-button { color: var(--wrong-text); background: var(--wrong-soft); box-shadow: 0 7rpx 0 var(--wrong-edge); }
.ghost-button { color: var(--navy); border: 2rpx solid var(--line); background: var(--paper); box-shadow: 0 7rpx 0 var(--line-deep); }
.primary-button,.secondary-button,.ghost-button,.game-button { transition:transform 220ms var(--ease-out),box-shadow 220ms ease,background-color 220ms ease,border-color 220ms ease; }
.primary-button:active, .secondary-button:active, .ghost-button:active,.game-button:active { transform:translateY(var(--press)); box-shadow:none; }
.button-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.button-row button { flex: 1; }
.pill { display: inline-flex; align-items: center; min-height: 46rpx; padding: 0 18rpx; border-radius: 999rpx; color: var(--radical-text); background: var(--radical-soft); font-size: 21rpx; font-weight: 800; }
.progress-track { height: 14rpx; overflow: hidden; border-radius: 99rpx; background: rgba(0,0,0,.16); }
.progress-value { height: 100%; border-radius: inherit; background: #b6f2dc; transition:width 320ms var(--ease-out); }
.empty { padding: 70rpx 32rpx; text-align: center; color: var(--ink-soft); line-height: 1.8; }
.skeleton { min-height: 180rpx; border-radius: 28rpx; background: linear-gradient(90deg, var(--sky-deep) 25%, var(--paper) 50%, var(--sky-deep) 75%); background-size: 200% 100%; animation: shimmer 1.2s infinite; }
.nav-back { display:flex; width:var(--tap-size); height:var(--tap-size); min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -10px; padding:0; border-radius:999px; color:var(--ink-soft); background:transparent; }
@media (min-width:900px) {
  page .home-page,
  page .course-page,
  page .practice-hub-page,
  page .lesson-page,
  page .track-page,
  page .read-page,
  page .records-page,
  page .components-page,
  page .account-page {
    width:calc(100% - 236px);
    max-width:1244px;
    margin-right:auto;
    margin-left:236px;
    padding-right:32px;
    padding-left:32px;
  }
  page .heading-title,
  page .account-title,
  page .records-heading>view,
  page .utility-heading>strong,
  page .track-heading strong {
    font-size:32px;
    line-height:1.2;
  }
}
@media (min-width:1481px) {
  page .home-page,
  page .course-page,
  page .practice-hub-page,
  page .lesson-page,
  page .track-page,
  page .read-page,
  page .records-page,
  page .components-page,
  page .account-page {
    margin-left:calc((100% - 1008px) / 2);
  }
}
@keyframes shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
@keyframes page-arrive { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
@keyframes page-arrive-a { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
@keyframes page-arrive-b { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
@media (prefers-reduced-motion:reduce) {
  .home-page,.course-page,.practice-hub-page,.track-page,.account-page,.components-page,.read-page,.records-page,.page-arrive-a,.page-arrive-b,.skeleton { animation:none; }
  button,.press-card,.primary-button,.secondary-button,.ghost-button,.game-button,.progress-value { transition:none; }
  button:active,.press-card.is-pressed,.primary-button:active,.secondary-button:active,.ghost-button:active,.game-button:active { transform:none; }
}
