@font-face {
  font-family: "Knowing Kai";
  src: url("https://knowing-word.jbang2004.chatgpt.site/api/mini-font/v1/lxgw-wenkai.woff2?v=76") format("woff2");
  font-weight: 400 500;
  font-style: normal;
  font-display: swap;
}

page {
  --sky: #fffcf6;
  --sky-deep: #f2ece0;
  --paper: #ffffff;
  --paper-soft: #faf6ee;
  --ink: #22302c;
  --ink-soft: #5e6e68;
  --ink-faint: #5e6e68;
  --disabled-ink: #70695d;
  --line: #e5dfd2;
  --line-deep: #d5cdba;
  --navy: #123c33;
  --action: #17b686;
  --action-deep: #0f8c64;
  --action-soft: #e2f7ef;
  --action-edge: #bfe8d9;
  --action-ink: #0f1614;
  --action-text: #0b7654;
  --radical: #ff5b34;
  --radical-deep: #d93c18;
  --radical-soft: #ffeae3;
  --radical-edge: #ffc9b8;
  --radical-ink: #30150e;
  --radical-text: #bd3214;
  --part: #2fa8e0;
  --part-deep: #1e82b4;
  --part-soft: #e3f4fd;
  --part-edge: #b9e2f7;
  --part-ink: #0f1614;
  --part-text: #176d99;
  --wrong: #ffb020;
  --wrong-deep: #d98c00;
  --wrong-soft: #fff3d9;
  --wrong-edge: #f2dfb0;
  --wrong-ink: #4a3000;
  --wrong-text: #4a3000;
  --action-on-white: #0b7654;
  --radical-on-white: #bd3214;
  --part-on-white: #176d99;
  --wrong-on-white: #4a3000;
  --ink-on-white: #22302c;
  --ink-soft-on-white: #5e6e68;
  --navy-on-white: #123c33;
  --shadow-xs: 0 2px 0 var(--line);
  --shadow: 0 3px 0 var(--line);
  --shadow-lift: 0 5px 0 var(--line-deep);
  --shadow-sheet: 0 -16px 44px rgba(34,48,44,.26);
  --press: 4px;
  --ease-out: cubic-bezier(.16,1,.3,1);
  --page-gutter: 16px;
  --tap-size: 44px;
  --tabbar-height: 72px;
  --card-inline-gap: 12px;
  --card-stack-gap: 16px;
  --font-kai: "Knowing Kai", "Kaiti SC", STKaiti, KaiTi, "Songti SC", STSong, serif;
  --font-serif: "Iowan Old Style", "Source Han Serif SC", "Noto Serif CJK SC", "Songti SC", STSong, Georgia, serif;
  --font-sans: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  --font-round: ui-rounded, "SF Pro Rounded", "Hiragino Maru Gothic ProN", "PingFang SC", sans-serif;
  min-height: 100%;
  background: var(--sky);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 28rpx;
}

.theme-night {
  --sky:#111b19;
  --sky-deep:#172521;
  --paper:#192521;
  --paper-soft:#1d2b27;
  --ink:#f4f0e8;
  --ink-soft:#b9c1bc;
  --ink-faint:#a6b3ad;
  --disabled-ink:#8f9a94;
  --line:#34443e;
  --line-deep:#22302c;
  --navy:#eff3ed;
  --action:#35c295;
  --action-deep:#1d8f6b;
  --action-soft:#1f3a33;
  --action-edge:#1d8f6b;
  --action-ink:#0f1614;
  --action-text:#70d9b6;
  --radical:#ff7a52;
  --radical-deep:#c9502c;
  --radical-soft:#3c2924;
  --radical-edge:#c9502c;
  --radical-ink:#0f1614;
  --radical-text:#ff9a7d;
  --part:#5fb4dc;
  --part-deep:#3c7fa3;
  --part-soft:#22343a;
  --part-edge:#3c7fa3;
  --part-ink:#0f1614;
  --part-text:#8bcceb;
  --wrong:#e9b04a;
  --wrong-deep:#b3822a;
  --wrong-soft:#39311f;
  --wrong-edge:#b3822a;
  --wrong-ink:#0f1614;
  --wrong-text:#f5c86d;
  --shadow-sheet:0 -16px 44px rgba(0,0,0,.5);
  background:var(--sky);
  color:var(--ink);
}

.kai { font-family: var(--font-kai); }

view, text, image, button, input, canvas, scroll-view { box-sizing: border-box; }
button { min-width: 0; font: inherit; transition:transform 90ms ease,box-shadow 90ms ease; }
button::after { border: 0; }
button:active { transform:translateY(var(--press)); box-shadow:none; }
button[disabled]:active { transform:none; }
.press-card { transition:transform 90ms ease,box-shadow 90ms ease,border-color 140ms ease,background-color 140ms ease; }
.press-card.is-pressed { transform: translateY(var(--press)); box-shadow: none; }
.page { width:100%; max-width:1180px; min-height:100vh; margin-right:auto; margin-left:auto; padding:26rpx 32rpx calc(54rpx + env(safe-area-inset-bottom)); }
.home-page,.course-page,.practice-hub-page,.track-page,.account-page,.components-page,.read-page,.records-page { animation:page-arrive 620ms var(--ease-out) both; }
.page-arrive-a { animation:page-arrive-a 620ms var(--ease-out) both; }
.page-arrive-b { animation:page-arrive-b 620ms var(--ease-out) both; }
.paper-texture { background: var(--sky); }
.eyebrow { display: block; margin-bottom: 10rpx; color: var(--radical-text); font-size: 22rpx; font-weight: 800; letter-spacing: 3rpx; }
.title { color: var(--navy); font-size: 50rpx; font-weight: 900; line-height: 1.16; }
.subtitle { margin-top: 12rpx; color: var(--ink-soft); font-size: 25rpx; line-height: 1.65; }
.card { border: 2rpx solid var(--line); border-radius: 34rpx; background: var(--paper); box-shadow: 0 7rpx 0 var(--line-deep); }
.section { margin-top: 28rpx; padding: 28rpx; }
.section-title { color: var(--navy); font-size: 34rpx; font-weight: 900; }
.section-copy { margin-top: 10rpx; color: var(--ink-soft); line-height: 1.65; }
.primary-button, .secondary-button, .ghost-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: 28rpx; font-weight: 900; }
.primary-button { color: var(--action-ink); background: var(--action); box-shadow: 0 8rpx 0 var(--action-deep); }
.secondary-button { color: var(--wrong-text); background: var(--wrong-soft); box-shadow: 0 7rpx 0 var(--wrong-edge); }
.ghost-button { color: var(--navy); border: 2rpx solid var(--line); background: var(--paper); box-shadow: 0 7rpx 0 var(--line-deep); }
.primary-button,.secondary-button,.ghost-button,.game-button { transition:transform 220ms var(--ease-out),box-shadow 220ms ease,background-color 220ms ease,border-color 220ms ease; }
.primary-button:active, .secondary-button:active, .ghost-button:active,.game-button:active { transform:translateY(var(--press)); box-shadow:none; }
.button-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.button-row button { flex: 1; }
.pill { display: inline-flex; align-items: center; min-height: 46rpx; padding: 0 18rpx; border-radius: 999rpx; color: var(--radical-text); background: var(--radical-soft); font-size: 21rpx; font-weight: 800; }
.progress-track { height: 14rpx; overflow: hidden; border-radius: 99rpx; background: rgba(0,0,0,.16); }
.progress-value { height: 100%; border-radius: inherit; background: #b6f2dc; transition:width 320ms var(--ease-out); }
.empty { padding: 70rpx 32rpx; text-align: center; color: var(--ink-soft); line-height: 1.8; }
.skeleton { min-height: 180rpx; border-radius: 28rpx; background: linear-gradient(90deg, var(--sky-deep) 25%, var(--paper) 50%, var(--sky-deep) 75%); background-size: 200% 100%; animation: shimmer 1.2s infinite; }
.nav-back { display:flex; width:var(--tap-size); height:var(--tap-size); min-height:0; flex:none; align-items:center; justify-content:center; margin:0 0 0 -10px; padding:0; border-radius:999px; color:var(--ink-soft); background:transparent; }
.nav-back-icon { position:relative; display:block; width:22px; height:18px; color:currentColor; }
.nav-back-icon::before { position:absolute; top:4px; left:1px; width:9px; height:9px; border-bottom:2.4px solid currentColor; border-left:2.4px solid currentColor; content:""; transform:rotate(45deg); }
.nav-back-icon::after { position:absolute; top:8px; left:3px; width:18px; border-top:2.4px solid currentColor; content:""; }
.ui-icon { position:relative; display:inline-block; width:16px; height:16px; flex:none; color:currentColor; }
.ui-icon-arrow-right::before { position:absolute; top:7px; left:2px; width:11px; border-top:2px solid currentColor; content:""; }
.ui-icon-arrow-right::after { position:absolute; top:4px; right:2px; width:6px; height:6px; border-top:2px solid currentColor; border-right:2px solid currentColor; content:""; transform:rotate(45deg); }
.ui-icon-arrow-left { transform:rotate(180deg); }
.ui-icon-chevron-right::before { position:absolute; top:4px; left:4px; width:7px; height:7px; border-top:2px solid currentColor; border-right:2px solid currentColor; content:""; transform:rotate(45deg); }
.ui-icon-check::before { position:absolute; top:4px; left:3px; width:9px; height:5px; border-bottom:2px solid currentColor; border-left:2px solid currentColor; content:""; transform:rotate(-45deg); }
.ui-icon-star { width:19px; height:19px; background:currentColor; clip-path:polygon(50% 2%,61% 35%,96% 35%,68% 55%,79% 90%,50% 69%,21% 90%,32% 55%,4% 35%,39% 35%); }
.ui-icon-star::after { position:absolute; inset:4px; background:var(--sky); clip-path:inherit; content:""; }
@media (min-width:900px) {
  page .home-page,
  page .course-page,
  page .practice-hub-page,
  page .lesson-page,
  page .track-page,
  page .read-page,
  page .records-page,
  page .components-page,
  page .account-page {
    width:calc(100% - 236px);
    max-width:1244px;
    margin-right:auto;
    margin-left:236px;
    padding-right:32px;
    padding-left:32px;
  }
  page .heading-title,
  page .account-title,
  page .records-heading>view,
  page .utility-heading>strong,
  page .track-heading strong {
    font-size:32px;
    line-height:1.2;
  }
}
@media (min-width:1481px) {
  page .home-page,
  page .course-page,
  page .practice-hub-page,
  page .lesson-page,
  page .track-page,
  page .read-page,
  page .records-page,
  page .components-page,
  page .account-page {
    margin-left:calc((100% - 1008px) / 2);
  }
}
@keyframes shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
@keyframes page-arrive { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
@keyframes page-arrive-a { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
@keyframes page-arrive-b { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
@media (prefers-reduced-motion:reduce) {
  .home-page,.course-page,.practice-hub-page,.track-page,.account-page,.components-page,.read-page,.records-page,.page-arrive-a,.page-arrive-b,.skeleton { animation:none; }
  button,.press-card,.primary-button,.secondary-button,.ghost-button,.game-button,.progress-value { transition:none; }
  button:active,.press-card.is-pressed,.primary-button:active,.secondary-button:active,.ghost-button:active,.game-button:active { transform:none; }
}
