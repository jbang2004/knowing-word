{
  "name": "knowing-word",
  "version": "1.0.0",
  "description": "A story-first Chinese character learning experience.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/prune-deployment-assets.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "generate:grade5": "node scripts/generate-grade5-catalog.mjs && node scripts/generate-home-index.mjs && node scripts/generate-lesson-media.mjs",
    "generate:miniprogram": "node scripts/generate-miniprogram-catalog.mjs",
    "typecheck:miniprogram": "tsc -p wechat-miniprogram/tsconfig.json --noEmit",
    "generate:narration-context": "node scripts/generate-narration-authoring-context.mjs",
    "compile:narration-calibration": "node scripts/compile-narration-calibration.mjs",
    "split:narration-packages": "node scripts/split-narration-authoring-packages.mjs",
    "generate:narration-facts": "node scripts/generate-narration-fact-card-drafts.mjs",
    "assemble:narration-v3": "node scripts/assemble-narration-v3-draft.mjs",
    "compile:narration-v3": "node scripts/compile-approved-narration-v3.mjs",
    "audit:narration-v3": "node scripts/audit-narration-v3-corpus.mjs",
    "validate:narration-v3": "node scripts/validate-narration-v3.mjs",
    "validate:narration-review": "node scripts/validate-narration-review.mjs",
    "prepare:narration-root-review": "node scripts/prepare-narration-root-review.mjs",
    "generate:narration-qwen3": "node scripts/run-narration-python.mjs generate",
    "verify:narration-qwen3": "node scripts/run-narration-python.mjs verify",
    "validate:narration-toolchain": "node scripts/run-narration-python.mjs toolchain",
    "migrate:narration-listening-v4": "node scripts/migrate-qwen3-human-listening-v4.mjs",
    "validate:narration-qwen3-release": "node scripts/validate-qwen3-narration-release.mjs",
    "build:kai": "node scripts/build-kai-subset.mjs",
    "audit:glyphs": "node scripts/audit-display-glyphs.mjs",
    "clean:assets": "node scripts/clean-source-assets.mjs",
    "preseed:narration": "node scripts/preseed-narration-media.mjs",
    "prepare:miniprogram-audio": "node scripts/prepare-miniprogram-narration.mjs",
    "stage:miniprogram-audio": "node scripts/stage-miniprogram-narration.mjs",
    "publish:miniprogram-audio": "node scripts/publish-miniprogram-narration.mjs",
    "warm:narration": "node scripts/warm-narration-media.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:vinext": "vinext check",
    "check:bundle": "node scripts/check-production-budgets.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:vinext",
    "verify": "npm run generate:miniprogram && npm run check && npm run typecheck:miniprogram && npm run test && npm run check:bundle && npm run audit:glyphs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "miniprogram-api-typings": "^4.0.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "hanzi": "^2.2.1",
    "pinyin-pro": "^3.28.1",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
